diff --git a/crates/postretro/src/session/lightmap_residency/walk_measurement/spike_decode.rs b/crates/postretro/src/session/lightmap_residency/walk_measurement/spike_decode.rs
new file mode 100644
index 0000000..fca66d4
--- /dev/null
+++ b/crates/postretro/src/session/lightmap_residency/walk_measurement/spike_decode.rs
@@ -0,0 +1,140 @@
+//! SPIKE: per-frame issuer decode, read and frame-thread admission timing.
+//! See: context/lib/experimental_spikes.md
+
+use std::sync::atomic::Ordering;
+
+use super::super::LightmapStreamingSession;
+
+/// Cumulative counters at one instant.
+#[derive(Debug, Default, Clone, Copy)]
+struct Snapshot {
+    read: u64,
+    decode: u64,
+    decodes: u64,
+    stored: u64,
+    decoded: u64,
+    admit: u64,
+    issuer_decode: u64,
+    pool_latency: u64,
+}
+
+impl Snapshot {
+    fn of(session: &LightmapStreamingSession) -> Self {
+        let spike = &session.ledger().spike;
+        Self {
+            read: spike.read_nanos.load(Ordering::Relaxed),
+            decode: spike.decode_nanos.load(Ordering::Relaxed),
+            decodes: spike.decodes.load(Ordering::Relaxed),
+            stored: spike.decode_stored_bytes.load(Ordering::Relaxed),
+            decoded: spike.decoded_bytes.load(Ordering::Relaxed),
+            admit: session.spike_admit_nanos,
+            issuer_decode: spike.issuer_decode_nanos.load(Ordering::Relaxed),
+            pool_latency: spike.pool_latency_nanos.load(Ordering::Relaxed),
+        }
+    }
+}
+
+/// One run's per-frame deltas. Issuer work lands in the frame during which
+/// it finished; in `completed` mode the gate waits on it, so it lands in the
+/// frame that issued it.
+#[derive(Debug, Default)]
+pub(in crate::session) struct SpikeDecode {
+    last: Snapshot,
+    read_ns: Vec<u64>,
+    decode_ns: Vec<u64>,
+    decodes: u64,
+    stored: Vec<u64>,
+    decoded: Vec<u64>,
+    admit_ns: Vec<u64>,
+    max_decode_ns: u64,
+    /// SPIKE (decode pool): decode time on the issuer thread, per frame.
+    issuer_decode_ns: Vec<u64>,
+    pool_latency_ns: u64,
+    pool_latency_max_ns: u64,
+    payload_sum: u64,
+    payload_count: u64,
+}
+
+impl SpikeDecode {
+    pub(in crate::session) fn start(&mut self, session: &LightmapStreamingSession) {
+        self.last = Snapshot::of(session);
+    }
+
+    pub(in crate::session) fn frame(&mut self, session: &LightmapStreamingSession) {
+        let now = Snapshot::of(session);
+        let last = std::mem::replace(&mut self.last, now);
+        self.read_ns.push(now.read - last.read);
+        self.decode_ns.push(now.decode - last.decode);
+        self.decodes += now.decodes - last.decodes;
+        self.stored.push(now.stored - last.stored);
+        self.decoded.push(now.decoded - last.decoded);
+        self.admit_ns.push(now.admit - last.admit);
+        self.issuer_decode_ns.push(now.issuer_decode - last.issuer_decode);
+        self.pool_latency_ns += now.pool_latency - last.pool_latency;
+        self.pool_latency_max_ns = session
+            .ledger()
+            .spike
+            .pool_latency_max_nanos
+            .load(Ordering::Relaxed);
+        self.payload_sum = session.controller.spike_payload_sum;
+        self.payload_count = session.controller.spike_payload_count;
+        self.max_decode_ns = session
+            .ledger()
+            .spike
+            .decode_max_nanos
+            .load(Ordering::Relaxed);
+    }
+
+    pub(in crate::session) fn line(&self) -> String {
+        let ms = |ns: u64| ns as f64 / 1e6;
+        let busy: Vec<u64> = self
+            .read_ns
+            .iter()
+            .zip(&self.issuer_decode_ns)
+            .map(|(r, d)| r + d)
+            .collect();
+        let mib = |b: u64| b as f64 / (1024.0 * 1024.0);
+        format!(
+            "decode/frame(ms, frames with work: n p50 p95 max) {} | decode total {:.1} ms over {} \
+             pairs (max one pair {:.2} ms) | issuer busy (read+decode) total {:.1} ms, /frame {} | \
+             read-only total {:.1} ms | bytes read->decoded {:.1}->{:.1} MiB, max/frame \
+             {:.2}->{:.2} MiB | frame-thread admit/frame(ms) {} total {:.1} ms | \
+             pool latency (queue+decode) total {:.1} ms max {:.2} ms | payload multiset hash \
+             {:016x} over {} admitted",
+            dist(&self.decode_ns),
+            ms(self.decode_ns.iter().sum()),
+            self.decodes,
+            ms(self.max_decode_ns),
+            ms(busy.iter().sum()),
+            dist(&busy),
+            ms(self.read_ns.iter().sum()),
+            mib(self.stored.iter().sum()),
+            mib(self.decoded.iter().sum()),
+            mib(self.stored.iter().copied().max().unwrap_or(0)),
+            mib(self.decoded.iter().copied().max().unwrap_or(0)),
+            dist(&self.admit_ns),
+            ms(self.admit_ns.iter().sum()),
+            ms(self.pool_latency_ns),
+            ms(self.pool_latency_max_ns),
+            self.payload_sum,
+            self.payload_count,
+        )
+    }
+}
+
+/// `n p50 p95 max` in ms over the nonzero entries.
+fn dist(nanos: &[u64]) -> String {
+    let mut work: Vec<u64> = nanos.iter().copied().filter(|&n| n > 0).collect();
+    if work.is_empty() {
+        return "0 - - -".to_string();
+    }
+    work.sort_unstable();
+    let at = |q: f64| work[((work.len() - 1) as f64 * q).round() as usize] as f64 / 1e6;
+    format!(
+        "{} {:.3} {:.3} {:.3}",
+        work.len(),
+        at(0.5),
+        at(0.95),
+        *work.last().unwrap() as f64 / 1e6
+    )
+}

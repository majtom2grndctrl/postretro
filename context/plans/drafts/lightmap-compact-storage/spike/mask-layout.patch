     pub layer: u32,
+    /// SPIKE (rotation): the chart is stored transposed: its canonical
+    /// interior texel `(tx, ty)` lands at bake-layer texel
+    /// `(x + pad + ty, y + pad + tx)`, and its padded footprint is
+    /// `height_texels × width_texels`. Every bake keys and walks the chart in
+    /// its canonical frame; only where a texel is stored moves.
+    pub transposed: bool,
+}
+
+impl ChartPlacement {
+    /// Placed padded extent of `chart`: its own extent, swapped when transposed.
+    pub fn extent(&self, chart: &Chart) -> (u32, u32) {
+        if self.transposed {
+            (chart.height_texels, chart.width_texels)
+        } else {
+            (chart.width_texels, chart.height_texels)
+        }
+    }
+
+    /// Bake-layer texel of canonical chart-interior texel `(tx, ty)`.
+    pub fn atlas_texel(&self, tx: i32, ty: i32) -> (i32, i32) {
+        let pad = CHART_PADDING_TEXELS as i32;
+        let (a, b) = if self.transposed { (ty, tx) } else { (tx, ty) };
+        (self.x as i32 + pad + a, self.y as i32 + pad + b)
+    }
+
+    /// Canonical chart-interior texel of bake-layer texel `(ax, ay)`.
+    pub fn chart_texel(&self, ax: u32, ay: u32) -> (i32, i32) {
+        let pad = CHART_PADDING_TEXELS as i32;
+        let a = ax as i32 - self.x as i32 - pad;
+        let b = ay as i32 - self.y as i32 - pad;
+        if self.transposed { (b, a) } else { (a, b) }
+    }
 }
 

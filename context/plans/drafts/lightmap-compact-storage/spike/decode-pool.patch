+fn spike_an_unknown_or_lz4_chunk_codec_is_refused_at_load() {
+    let (section, _, _, _, _) = fixture();
+    let metadata = section.metadata_bytes().unwrap();
+    let section_len = metadata.len() as u64 + section.header.payload_bytes;
+    let codec_offset = CLUSTER_SH_PAYLOADS_HEADER_SIZE
+        + CLUSTER_SH_PAYLOADS_SOURCE_RECORD_SIZE * section.sources.len()
+        + 44;
+    for tag in [1u32, 3, 0xFFFF_FFFF] {
+        let mut bad = metadata.clone();
+        bad[codec_offset..codec_offset + 4].copy_from_slice(&tag.to_le_bytes());
+        let err = ClusterShPayloadsSection::from_metadata_bytes(&bad, section_len)
+            .unwrap_err()
+            .to_string();
+        assert!(
+            err.contains(&format!("unknown chunk codec {tag}")),
+            "{tag}: {err}"
+        );
+    }
+}

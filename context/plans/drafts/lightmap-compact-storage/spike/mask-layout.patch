+
+/// SPIKE (packing): with `POSTRETRO_SPIKE_CHARTS_OUT=<path>`, write one TSV row
+/// per chart (face, cell, padded extent, block, block-local origin, block
+/// extent, windowed); with `POSTRETRO_SPIKE_EXIT_AFTER_ATLAS=1` too, exit.
+fn spike_dump_charts(prepared: &PreparedAtlas) {
+    use std::io::Write;
+    let Some(path) = std::env::var_os("POSTRETRO_SPIKE_CHARTS_OUT") else {
+        return;
+    };
+    let mut out = std::io::BufWriter::new(std::fs::File::create(&path).expect("spike dump"));
+    writeln!(
+        out,
+        "face\tcell\tw\th\tblock\tlx\tly\tbw\tbh\twindowed\trotated\testimate\tow\toh"
+    )
+    .unwrap();
+    let owned_rects = crate::lightmap_bake::spike_pack::LAST_OWNED_RECTS
+        .lock()
+        .unwrap()
+        .clone();
+    let estimate = SPIKE_LAST_ESTIMATE.lock().unwrap().clone();
+    for (face, chart) in prepared.charts.iter().enumerate() {
+        if prepared.placements.is_empty() {
+            break;
+        }
+        let block_id = prepared.layout.chart_blocks[face];
+        let block = &prepared.layout.blocks[block_id as usize];
+        let (lx, ly) = prepared
+            .layout
+            .local_placement(face, &prepared.placements[face]);
+        let (ow, oh) = owned_rects
+            .get(block_id as usize)
+            .copied()
+            .unwrap_or((0, 0));
+        writeln!(
+            out,
+            "{face}\t{}\t{}\t{}\t{block_id}\t{lx}\t{ly}\t{}\t{}\t{}\t{}\t{}\t{ow}\t{oh}",
+            chart.leaf_index,
+            chart.width_texels,
+            chart.height_texels,
+            block.width,
+            block.height,
+            u8::from(chart.window.is_some()),
+            u8::from(prepared.placements[face].transposed),
+            u8::from(estimate.get(face).copied().unwrap_or(false)),
+        )
+        .unwrap();
+    }
+    out.flush().unwrap();
+    log::info!(
+        "[spike] dumped {} charts in {} blocks to {}",
+        prepared.charts.len(),
+        prepared.layout.blocks.len(),
+        std::path::Path::new(&path).display()
+    );
+    if std::env::var_os("POSTRETRO_SPIKE_EXIT_AFTER_ATLAS").is_some() {
+        std::process::exit(0);
+    }
+}
+
+/// SPIKE (ownership): the last estimate, for the chart dump only.
+static SPIKE_LAST_ESTIMATE: std::sync::Mutex<Vec<bool>> = std::sync::Mutex::new(Vec::new());
+
+/// SPIKE (ownership): a conservative pre-pack superset of the charts whose
+/// face can end up with a mask owner. A face owns a light only where one of
+/// its interior texels stores nonzero quantized visibility from that light's
+/// partition, and a partition holds only the (light, chart) pairs that pass
+/// the range reach (`light_may_reach`) and the chart coverage cull
+/// (`chart_may_cover`); owners are `StaticLightMap` lights. Both tests read the
+/// chart and the light alone, never a placement. A cut face shares one owner
+/// set across its sub-faces, so every sub-face of a parent any sub-face
+/// admits is marked. `POSTRETRO_SPIKE_ESTIMATE=none` marks nothing (owned-first
+/// ordering off); `all` marks every chart.
+fn spike_owned_estimate(
+    static_lights: &StaticBakedLights<'_>,
+    charts: &[lightmap_bake::Chart],
+    cut_parents: &[lightmap_bake::CutParent],
+) -> Vec<bool> {
+    use crate::lightmap_layer::{chart_may_cover, chart_texel_bounds, light_may_reach};
+    use crate::map_data::ShadowType;
+    use rayon::prelude::*;
+    let started = std::time::Instant::now();
+    let mode = std::env::var("POSTRETRO_SPIKE_ESTIMATE").unwrap_or_default();
+    let lights: Vec<&crate::map_data::MapLight> = static_lights
+        .entries()
+        .iter()
+        // Owner eligibility (`shadowmask_bake::eligibility`): a bake-only
+        // light has no AlphaLights record and a dynamic one no static spec
+        // index, so neither owns a channel.
+        .filter(|entry| {
+            entry.light.shadow_type == ShadowType::StaticLightMap
+                && (mode == "lightmap" || (!entry.light.bake_only && !entry.light.is_dynamic))
+        })
+        .map(|entry| entry.light)
+        .collect();
+    let mut owned: Vec<bool> = match mode.as_str() {
+        "none" => vec![false; charts.len()],
+        "all" => vec![true; charts.len()],
+        _ => charts
+            .par_iter()
+            .map(|chart| {
+                let bounds = chart_texel_bounds(chart);
+                bounds.is_some()
+                    && lights.iter().any(|light| {
+                        light_may_reach(light, bounds) && chart_may_cover(light, chart)
+                    })
+            })
+            .collect(),
+    };
+    for cut in cut_parents {
+        if cut.faces.clone().any(|face| owned[face]) {
+            for face in cut.faces.clone() {
+                owned[face] = true;
+            }
+        }
+    }
+    let texels = |pick: bool| -> u64 {
+        charts
+            .iter()
+            .zip(&owned)
+            .filter(|(_, o)| **o == pick)
+            .map(|(c, _)| u64::from(c.width_texels) * u64::from(c.height_texels))
+            .sum()
+    };
+    log::info!(
+        "[spike] owner estimate ({}): {} of {} charts, {:.2}M of {:.2}M padded texels, {} candidate owner lights, {:.2}s",
+        if mode.is_empty() {
+            "reach+cover"
+        } else {
+            mode.as_str()
+        },
+        owned.iter().filter(|&&o| o).count(),
+        charts.len(),
+        texels(true) as f64 / 1e6,
+        (texels(true) + texels(false)) as f64 / 1e6,
+        lights.len(),
+        started.elapsed().as_secs_f64(),
+    );
+    *SPIKE_LAST_ESTIMATE.lock().unwrap() = owned.clone();
+    owned
+}

+// SPIKE: coded id-22/42 blocks against the raw PRL: identity, rejection, load time.
+// See: context/lib/experimental_spikes.md
+//
+// Run from the workspace root (measurements want the profiling profile):
+//
+//   POSTRETRO_SPIKE_RAW_PRL=<raw.prl> POSTRETRO_SPIKE_CODED_PRLS=<a.prl>,<b.prl> \
+//     cargo test -p postretro-level-loader --lib spike_ -- --ignored --nocapture
+//
+// `spike_all_resident_load_time` times ids 22+42 for every PRL named in both
+// variables, on `POSTRETRO_SPIKE_DECODE_THREADS` decode threads (default 1).
+
+use std::path::Path;
+use std::sync::Arc;
+use std::time::Instant;
+
+use postretro_level_format::lightmap::{LightmapBlockIndex, LightmapBlockPayload};
+use postretro_level_format::shadowmask_atlas::{ShadowmaskBlockIndex, ShadowmaskOwnerBounds};
+use postretro_level_format::{SectionId, read_container};
+
+use super::manifest::LightmapStreamManifest;
+use crate::prl_container::PrlContainer;
+use crate::prl_file::PrlFile;
+use crate::prl_lightmap::{read_lightmap, read_shadowmask_atlas};
+use crate::sh_stream::read_vec_at;
+
+/// Generous: only the Cells-table bound check reads it.
+const CELL_COUNT: usize = 1 << 20;
+
+struct Opened {
+    file: Arc<PrlFile>,
+    container: PrlContainer,
+}
+
+fn open(path: &str) -> Opened {
+    let file = Arc::new(PrlFile::open(Path::new(path)).expect("open PRL"));
+    let meta = read_container(&mut file.file()).expect("container");
+    file.read_counters().install_table(&meta);
+    let container = PrlContainer::from_positional(Arc::clone(&file), meta, false);
+    Opened { file, container }
+}
+
+fn owner_bounds(opened: &Opened) -> ShadowmaskOwnerBounds {
+    let entry = opened
+        .container
+        .metadata()
+        .find_section(SectionId::ShadowmaskAtlas as u32)
+        .expect("id 42");
+    let header = read_vec_at(&opened.file, entry.offset, 8, "id-42 header").unwrap();
+    ShadowmaskOwnerBounds::from_section_header(&header).unwrap()
+}
+
+/// Every block through the all-resident path: decoded, shadowmask joined.
+fn all_resident(
+    opened: &Opened,
+) -> (
+    LightmapBlockIndex,
+    ShadowmaskBlockIndex,
+    Vec<LightmapBlockPayload>,
+) {
+    let lightmap = read_lightmap(&opened.container, CELL_COUNT)
+        .unwrap()
+        .expect("id 22");
+    let masks = read_shadowmask_atlas(
+        &opened.container,
+        Some(&lightmap.index),
+        owner_bounds(opened),
+    )
+    .unwrap()
+    .expect("id 42");
+    let payloads = lightmap
+        .blocks
+        .into_iter()
+        .zip(masks.groups)
+        .map(|(mut payload, groups)| {
+            payload.shadowmask = Some(groups);
+            payload
+        })
+        .collect();
+    (lightmap.index, masks.index, payloads)
+}
+
+fn manifest(
+    opened: &Opened,
+    lightmap: &LightmapBlockIndex,
+    masks: &ShadowmaskBlockIndex,
+) -> LightmapStreamManifest {
+    let meta = opened.container.metadata();
+    LightmapStreamManifest::new(
+        Arc::clone(&opened.file),
+        lightmap.clone(),
+        Some(masks.clone()),
+        meta.find_section(SectionId::Lightmap as u32).unwrap(),
+        meta.find_section(SectionId::ShadowmaskAtlas as u32),
+        None,
+        [0; 32],
+    )
+    .unwrap()
+}
+
+fn env_paths(name: &str) -> Vec<String> {
+    std::env::var(name)
+        .unwrap_or_default()
+        .split(',')
+        .filter(|path| !path.is_empty())
+        .map(str::to_string)
+        .collect()
+}
+
+/// Honesty gate: every coded block decodes byte-identical to the raw PRL's,
+/// through the all-resident path and through the streaming manifest's read.
+#[test]
+#[ignore = "spike gate; set POSTRETRO_SPIKE_RAW_PRL and POSTRETRO_SPIKE_CODED_PRLS"]
+fn spike_coded_blocks_match_raw() {
+    let raw_path = std::env::var("POSTRETRO_SPIKE_RAW_PRL").expect("raw PRL");
+    let raw = open(&raw_path);
+    let (raw_index, raw_masks, raw_payloads) = all_resident(&raw);
+    assert!(raw_index.coding.is_none() && raw_masks.coding.is_none());
+    // The raw PRL's streaming read must match its own all-resident load.
+    let raw_manifest = manifest(&raw, &raw_index, &raw_masks);
+    for (block, expected) in raw_payloads.iter().enumerate() {
+        assert_eq!(
+            &raw_manifest.read_block_pair(block as u32).unwrap(),
+            expected
+        );
+    }
+    for coded_path in env_paths("POSTRETRO_SPIKE_CODED_PRLS") {
+        let coded = open(&coded_path);
+        let (index, masks, payloads) = all_resident(&coded);
+        assert!(
+            index.coding.is_some() && masks.coding.is_some(),
+            "{coded_path} is coded"
+        );
+        assert_eq!(payloads.len(), raw_payloads.len());
+        let mut identical = 0;
+        for (block, (got, expected)) in payloads.iter().zip(&raw_payloads).enumerate() {
+            assert_eq!(got, expected, "{coded_path} all-resident block {block}");
+            identical += 1;
+        }
+        let manifest = manifest(&coded, &index, &masks);
+        assert!(manifest.is_coded());
+        let mut streamed = 0;
+        for (block, expected) in raw_payloads.iter().enumerate() {
+            let got = manifest.read_block_pair(block as u32).unwrap();
+            assert_eq!(&got, expected, "{coded_path} streamed block {block}");
+            assert_eq!(
+                manifest.upload_bytes(block as u32),
+                (
+                    (expected.irradiance.len() + expected.direction.len()) as u64,
+                    expected
+                        .shadowmask
+                        .as_ref()
+                        .map_or(0, |[a, b]| (a.len() + b.len()) as u64)
+                ),
+                "upload bytes are the uncompressed lengths"
+            );
+            streamed += 1;
+        }
+        println!(
+            "{coded_path}: {identical} all-resident and {streamed} streamed blocks byte-identical \
+             to {raw_path}"
+        );
+    }
+}
+
+/// Honesty gate: a corrupt frame and a lying length are rejected by name,
+/// at read (the issuer's decode) and at load (the index parse). For lz4,
+/// whose block format has no checksum, report how many single-byte flips go
+/// undetected.
+#[test]
+#[ignore = "spike gate; set POSTRETRO_SPIKE_CODED_PRLS"]
+fn spike_corrupt_and_lying_blocks_are_rejected() {
+    for coded_path in env_paths("POSTRETRO_SPIKE_CODED_PRLS") {
+        let coded = open(&coded_path);
+        let (index, masks, payloads) = all_resident(&coded);
+        let manifest = manifest(&coded, &index, &masks);
+        let codec = index.pair_coding(0).codec;
+        // A median-sized block with a mask plane.
+        let block = (0..index.records.len())
+            .find(|&b| masks.records[b].group_a.len != 0 && index.records[b].irradiance.len > 4096)
+            .expect("a block with a mask plane") as u32;
+        let ranges = manifest.block_file_ranges(block).unwrap();
+        let lightmap = manifest.read_file_span(ranges.lightmap.clone()).unwrap();
+        let shadowmask = manifest
+            .read_file_span(ranges.shadowmask.clone().unwrap())
+            .unwrap();
+        let mut flips = 0;
+        let mut undetected = 0;
+        for at in (0..lightmap.len()).step_by((lightmap.len() / 64).max(1)) {
+            let mut bad = lightmap.clone();
+            bad[at] ^= 0x5A;
+            flips += 1;
+            match manifest.payload_from_pair_bytes(block, bad, Some(shadowmask.clone())) {
+                Err(err) => {
+                    let message = err.to_string();
+                    assert!(
+                        message.contains(&format!("lightmap block {block}")),
+                        "{coded_path}: unnamed rejection: {message}"
+                    );
+                }
+                Ok(payload) => {
+                    if payload != payloads[block as usize] {
+                        undetected += 1;
+                    }
+                }
+            }
+        }
+        println!(
+            "{coded_path}: codec {codec:?}, block {block}: {flips} single-byte flips in the id-22 \
+             frames, {undetected} decoded to wrong bytes without an error"
+        );
+        if codec == postretro_level_format::block_codec::BlockCodec::Zstd {
+            assert_eq!(undetected, 0, "zstd frames carry a checksum");
+        }
+        // A frame cut short is rejected by name at read.
+        let mut short = shadowmask.clone();
+        short.truncate(short.len() - 1);
+        let message = manifest
+            .decode_pair_bytes(block, &lightmap, Some(&short))
+            .expect_err("a short read")
+            .to_string();
+        assert!(
+            message.contains(&format!("block {block} shadowmask read returned")),
+            "{message}"
+        );
+
+        // A lying uncompressed length fails the index at load, by name.
+        let entry = coded
+            .container
+            .metadata()
+            .find_section(SectionId::Lightmap as u32)
+            .unwrap()
+            .clone();
+        let prefix_len = index.header.index_byte_len().unwrap();
+        let mut prefix = read_vec_at(&coded.file, entry.offset, prefix_len, "prefix").unwrap();
+        let at = 20 + block as usize * index.header.record_bytes() + 36;
+        let declared = u32::from_le_bytes(prefix[at..at + 4].try_into().unwrap());
+        prefix[at..at + 4].copy_from_slice(&(declared + 16).to_le_bytes());
+        let message = LightmapBlockIndex::from_prefix(&prefix, entry.size)
+            .expect_err("a lying length")
+            .to_string();
+        assert!(
+            message.contains(&format!("lightmap block {block} irradiance declares")),
+            "{message}"
+        );
+        // A lying stored length breaks adjacency at load, by name.
+        let mut prefix = read_vec_at(&coded.file, entry.offset, prefix_len, "prefix").unwrap();
+        let at = 20 + block as usize * index.header.record_bytes() + 16;
+        let stored = u32::from_le_bytes(prefix[at..at + 4].try_into().unwrap());
+        prefix[at..at + 4].copy_from_slice(&(stored - 1).to_le_bytes());
+        let message = LightmapBlockIndex::from_prefix(&prefix, entry.size)
+            .expect_err("a lying stored length")
+            .to_string();
+        assert!(
+            message.contains(&format!("lightmap block {block}")),
+            "{message}"
+        );
+        println!("{coded_path}: corrupt frame, short read and lying lengths rejected by name");
+    }
+}
+
+/// Measured: ids 22+42 through the all-resident path, section read and decode.
+#[test]
+#[ignore = "spike measurement; set POSTRETRO_SPIKE_RAW_PRL and/or POSTRETRO_SPIKE_CODED_PRLS"]
+fn spike_all_resident_load_time() {
+    let threads = std::env::var("POSTRETRO_SPIKE_DECODE_THREADS").unwrap_or_else(|_| "1".into());
+    let mut paths = env_paths("POSTRETRO_SPIKE_RAW_PRL");
+    paths.extend(env_paths("POSTRETRO_SPIKE_CODED_PRLS"));
+    for path in paths {
+        let opened = open(&path);
+        // Warm the page cache so every config reads from memory alike.
+        for id in [SectionId::Lightmap, SectionId::ShadowmaskAtlas] {
+            drop(opened.container.read_section(id as u32).unwrap());
+        }
+        let started = Instant::now();
+        let read_22 = opened
+            .container
+            .read_section(SectionId::Lightmap as u32)
+            .unwrap()
+            .unwrap();
+        let read_42 = opened
+            .container
+            .read_section(SectionId::ShadowmaskAtlas as u32)
+            .unwrap()
+            .unwrap();
+        let io_ms = started.elapsed().as_secs_f64() * 1000.0;
+        let stored = read_22.len() + read_42.len();
+        drop((read_22, read_42));
+        let started = Instant::now();
+        let (_, _, payloads) = all_resident(&opened);
+        let total_ms = started.elapsed().as_secs_f64() * 1000.0;
+        let decoded: usize = payloads
+            .iter()
+            .map(|p| {
+                p.irradiance.len()
+                    + p.direction.len()
+                    + p.shadowmask.as_ref().map_or(0, |[a, b]| a.len() + b.len())
+            })
+            .sum();
+        println!(
+            "SPIKE_LOAD path={path} threads={threads} stored_bytes={stored} decoded_bytes={decoded} \
+             section_read_ms={io_ms:.1} load_22_42_ms={total_ms:.1}"
+        );
+    }
+}

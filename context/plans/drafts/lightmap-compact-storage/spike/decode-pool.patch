--- /dev/null
+++ b/crates/postretro/src/session/sh_async_workers/spike_pool_measure.rs
@@ -0,0 +1,101 @@
+//! SPIKE: whole-map SH streaming through the real worker set (issuer plus
+//! decode pool) over a real PRL, with no renderer: time from first request to
+//! the last prepared chunk, and the pool's decode latency.
+//! See: context/lib/rendering_pipeline.md §"Cluster SH residency".
+//
+//   POSTRETRO_SPIKE_SH_PRLS=a.prl,b.prl [POSTRETRO_SPIKE_SH_REPS=3] \
+//     <test binary> spike_sh_pool_whole_map --ignored --nocapture
+//
+// Every non-empty cluster is requested as mandatory, ascending, holding at most
+// MAX_STREAM_PERMITS in flight as the controller does. PRLs run interleaved.
+
+use std::collections::BTreeSet;
+use std::sync::Arc;
+use std::time::Instant;
+
+use postretro_level_loader::{ShStreamingMode, load_prl_with_sh_streaming};
+
+use super::{ShAsyncWorkers, ShWorkerResult};
+use crate::sh_streaming::controller::{MAX_STREAM_PERMITS, ShClusterRequest};
+
+#[test]
+#[ignore = "measurement helper; set POSTRETRO_SPIKE_SH_PRLS"]
+fn spike_sh_pool_whole_map() {
+    let paths: Vec<String> = std::env::var("POSTRETRO_SPIKE_SH_PRLS")
+        .expect("POSTRETRO_SPIKE_SH_PRLS")
+        .split(',')
+        .map(str::to_owned)
+        .collect();
+    let reps: usize = std::env::var("POSTRETRO_SPIKE_SH_REPS")
+        .ok()
+        .map_or(3, |r| r.parse().unwrap());
+    let manifests: Vec<_> = paths
+        .iter()
+        .map(|path| {
+            let world = load_prl_with_sh_streaming(path, ShStreamingMode::Async).unwrap();
+            Arc::clone(world.sh_stream_manifest().expect("streamed SH"))
+        })
+        .collect();
+    for rep in 1..=reps {
+        for (path, manifest) in paths.iter().zip(&manifests) {
+            let index = &manifest.payloads().index;
+            let live: Vec<u32> = (0..manifest.cluster_count())
+                .filter(|&c| index[c as usize].payload_len > 0)
+                .collect();
+            let stored: u64 = live.iter().map(|&c| index[c as usize].payload_len).sum();
+            let workers = ShAsyncWorkers::new(Arc::clone(manifest)).unwrap();
+            workers.publish_targets(&live.iter().copied().collect::<BTreeSet<_>>());
+            let started = Instant::now();
+            let mut next = 0;
+            let mut in_flight = 0;
+            let mut done = 0;
+            let mut decoded = 0u64;
+            while done < live.len() {
+                while in_flight < MAX_STREAM_PERMITS && next < live.len() {
+                    let cluster_id = live[next];
+                    workers
+                        .submit(ShClusterRequest {
+                            generation: 1,
+                            content_tag: [1; 32],
+                            cluster_id,
+                            chunk_hash: index[cluster_id as usize].hash,
+                            mandatory: true,
+                        })
+                        .unwrap();
+                    next += 1;
+                    in_flight += 1;
+                }
+                match workers.try_completion().unwrap() {
+                    Some(completion) => {
+                        match completion.result {
+                            ShWorkerResult::Prepared(chunk) => decoded += chunk.bytes.len() as u64,
+                            other => panic!("cluster {} {other:?}", completion.request.cluster_id),
+                        }
+                        in_flight -= 1;
+                        done += 1;
+                    }
+                    None => std::thread::yield_now(),
+                }
+            }
+            let wall = started.elapsed().as_secs_f64();
+            let stats = workers.stats().unwrap();
+            let threads = std::thread::available_parallelism().map_or(1, |n| n.get());
+            println!(
+                "SPIKE_SH_POOL rep {rep} | {path} | cores {threads} pool {} | chunks {} | stored {:.1} MiB decoded {:.1} MiB | wall {:.3} s ({:.2} GiB/s decoded) | decode/chunk ms p50 {:.3} p95 {:.3} max {:.3} | read/chunk ms p50 {:.3} p95 {:.3} max {:.3} | reads {}",
+                super::decode_pool_size(threads),
+                live.len(),
+                stored as f64 / 1048576.0,
+                decoded as f64 / 1048576.0,
+                wall,
+                decoded as f64 / wall / 1073741824.0,
+                stats.decode_latency.quantile_ms(0.5),
+                stats.decode_latency.quantile_ms(0.95),
+                stats.decode_latency.max_ms(),
+                stats.read_latency.quantile_ms(0.5),
+                stats.read_latency.quantile_ms(0.95),
+                stats.read_latency.max_ms(),
+                stats.reads_issued,
+            );
+        }
+    }
+}

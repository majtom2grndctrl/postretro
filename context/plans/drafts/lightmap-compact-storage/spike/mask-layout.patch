+/// SPIKE (ownership): each block's owned sub-rect, anchored at its origin:
+/// the aligned extent holding every nonzero texel of either stored plane.
+/// Owned charts pack first into a block's top-left, so this is their
+/// bounding rect less any owned edge that baked zero; a texel past it reads
+/// zero, exactly what the plane stores there. Blocks with no plane keep
+/// their whole extent (they place no plane).
+pub(crate) fn owned_mask_extents(
+    lightmap: &LightmapSection,
+    section: &ShadowmaskAtlasSection,
+    alignment: u32,
+) -> Vec<(u32, u32)> {
+    use rayon::prelude::*;
+    let up = |v: u32| v.div_ceil(alignment) * alignment;
+    lightmap
+        .blocks
+        .par_iter()
+        .zip(&section.blocks)
+        .map(|(block, planes)| {
+            let (w, h) = (u32::from(block.width), u32::from(block.height));
+            let (mut x_end, mut y_end) = (0, 0);
+            for plane in planes.iter().filter(|plane| !plane.is_empty()) {
+                let rg = crate::bc5::decode_bc5_rg(plane, w, h);
+                for y in 0..h {
+                    for x in 0..w {
+                        let o = ((y * w + x) * 2) as usize;
+                        if rg[o] != 0 || rg[o + 1] != 0 {
+                            x_end = x_end.max(x + 1);
+                            y_end = y_end.max(y + 1);
+                        }
+                    }
+                }
+            }
+            if planes.iter().all(|plane| plane.is_empty()) {
+                (w, h)
+            } else {
+                (
+                    up(x_end).min(w).max(alignment),
+                    up(y_end).min(h).max(alignment),
+                )
+            }
+        })
+        .collect()
 }
 

+// SCRATCH 9l: prism-plane ablation over the five measured maps, partition
+// stage only. Remove before reporting.
+// Run: POSTRETRO_9L_MAPS=occlusion-test,... POSTRETRO_9L_VARIANTS=all,none,...
+//   cargo test --release -p postretro-level-compiler --bin prl-build scratch_9l_ablation -- --ignored --nocapture
+
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::path::PathBuf;
+use std::sync::atomic::Ordering;
+use std::time::Instant;
+
+use glam::DVec3;
+
+use super::{RuntimeCells, partition_with_occluders};
+use crate::map_format::MapFormat;
+use crate::partition::brush_bsp::ablation::{self, ABUT_B, ABUT_S, FAR_B, FAR_S, FREE_B, FREE_S};
+use crate::portals;
+use crate::visibility;
+
+/// (name, kind mask, filter bits, free threshold)
+pub(super) fn variants() -> Vec<(&'static str, u8)> {
+    variants_full()
+        .into_iter()
+        .map(|(name, mask, _, _)| (name, mask))
+        .collect()
+}
+
+/// Sets the ablation statics for `name` and returns its mask.
+pub(super) fn apply(name: &str) -> u8 {
+    let (_, mask, filter, threshold) = variants_full()
+        .into_iter()
+        .find(|v| v.0 == name)
+        .expect("variant");
+    ablation::MASK.store(mask, Ordering::SeqCst);
+    ablation::FILTER.store(filter, Ordering::SeqCst);
+    ablation::FREE_THRESHOLD.store(threshold.to_bits(), Ordering::SeqCst);
+    mask
+}
+
+pub(super) fn reset() {
+    ablation::MASK.store(0x3F, Ordering::SeqCst);
+    ablation::FILTER.store(0, Ordering::SeqCst);
+    ablation::FREE_THRESHOLD.store(0.5f64.to_bits(), Ordering::SeqCst);
+}
+
+fn variants_full() -> Vec<(&'static str, u8, u8, f64)> {
+    let base = [
+        ("none", 0),
+        ("all", 0x3F),
+        ("free+far", FREE_B | FREE_S | FAR_B | FAR_S),
+        ("free", FREE_B | FREE_S),
+        ("brush", FREE_B | ABUT_B | FAR_B),
+        ("section", FREE_S | ABUT_S | FAR_S),
+        ("abut", ABUT_B | ABUT_S),
+        ("brush-free+far", FREE_B | FAR_B),
+        ("brush-free", FREE_B),
+        ("far", FAR_B | FAR_S),
+    ];
+    let mut all: Vec<(&'static str, u8, u8, f64)> =
+        base.into_iter().map(|(n, m)| (n, m, 0, 0.5)).collect();
+    all.extend([
+        ("bf-wallface", FREE_B, 1, 0.5),
+        ("bf-vplanes", FREE_B, 2, 0.5),
+        ("bf-wall-vplanes", FREE_B, 3, 0.5),
+        ("free-wallface", FREE_B | FREE_S, 1, 0.5),
+        ("free-wall-vplanes", FREE_B | FREE_S, 3, 0.5),
+        ("bf-any-open", FREE_B, 0, 0.0),
+        ("bf-all-open", FREE_B, 0, 0.999),
+        ("bf-wall-vplanes-any", FREE_B, 3, 0.0),
+    ]);
+    let wanted = std::env::var("POSTRETRO_9L_VARIANTS").ok();
+    all.into_iter()
+        .filter(|(name, ..)| {
+            wanted
+                .as_deref()
+                .is_none_or(|w| w.split(',').any(|x| x == *name))
+        })
+        .collect()
+}
+
+fn kind_name(bits: u8) -> String {
+    let mut out = Vec::new();
+    for (bit, name) in [
+        (FREE_B, "freeB"),
+        (ABUT_B, "abutB"),
+        (FAR_B, "farB"),
+        (FREE_S, "freeS"),
+        (ABUT_S, "abutS"),
+        (FAR_S, "farS"),
+    ] {
+        if bits & bit != 0 {
+            out.push(name);
+        }
+    }
+    if out.is_empty() {
+        "-".into()
+    } else {
+        out.join("+")
+    }
+}
+
+/// A plane key with its direction canonical (first non-negligible component
+/// positive), rounded, so a portal's plane matches either orientation.
+fn plane_key(normal: DVec3, distance: f64) -> (i64, i64, i64, i64) {
+    let n = normal.normalize();
+    let flip = if n.x.abs() > 1e-6 {
+        n.x < 0.0
+    } else if n.y.abs() > 1e-6 {
+        n.y < 0.0
+    } else {
+        n.z < 0.0
+    };
+    let (n, d) = if flip { (-n, -distance) } else { (n, distance) };
+    (
+        (n.x * 1e4).round() as i64,
+        (n.y * 1e4).round() as i64,
+        (n.z * 1e4).round() as i64,
+        (d * 1e3).round() as i64,
+    )
+}
+
+fn polygon_plane(polygon: &[DVec3]) -> (DVec3, f64) {
+    let mut n = DVec3::ZERO;
+    for i in 0..polygon.len() {
+        let a = polygon[i];
+        let b = polygon[(i + 1) % polygon.len()];
+        n += DVec3::new(
+            (a.y - b.y) * (a.z + b.z),
+            (a.z - b.z) * (a.x + b.x),
+            (a.x - b.x) * (a.y + b.y),
+        );
+    }
+    let n = n.normalize();
+    (n, n.dot(polygon[0]))
+}

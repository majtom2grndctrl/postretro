new file mode 100644
index 0000000..184ecfe
--- /dev/null
+++ b/crates/level-compiler/src/pack/lightmap_pool_bound/spike_cmp.rs
@@ -0,0 +1,438 @@
+//! SPIKE (rotation): placement-invariance gate. Maps every chart texel of two
+//! bakes of one map, under two layouts, onto the chart's canonical padded grid
+//! and compares what each stores before GPU block compression.
+//! `prl-build --spike-compare2 <a.tsv> <a.prl> <a.masks> <b.tsv> <b.prl> <b.masks>`
+
+use std::collections::{BTreeMap, HashMap};
+use std::io::Read;
+
+use anyhow::Context;
+use postretro_level_format::lightmap::IRRADIANCE_FORMAT_RGBA16F;
+
+use super::spike_sim::{ChartRow, Prl, read_charts, read_prl};
+use crate::chart_raster::CHART_PADDING_TEXELS;
+
+/// Raw RGBA8 mask of each block, from `POSTRETRO_SPIKE_MASK_RAW_OUT`.
+fn read_masks(path: &str) -> anyhow::Result<HashMap<u32, (u32, u32, Vec<u8>)>> {
+    let mut bytes = Vec::new();
+    std::fs::File::open(path)
+        .with_context(|| path.to_string())?
+        .read_to_end(&mut bytes)?;
+    let mut out = HashMap::new();
+    let mut at = 0;
+    let word = |at: usize| u32::from_le_bytes(bytes[at..at + 4].try_into().unwrap());
+    while at < bytes.len() {
+        let (id, w, h) = (word(at), word(at + 4), word(at + 8));
+        at += 12;
+        let len = (w * h * 4) as usize;
+        let previous = out.insert(id, (w, h, bytes[at..at + len].to_vec()));
+        anyhow::ensure!(previous.is_none(), "block {id} dumped twice");
+        at += len;
+    }
+    Ok(out)
+}
+
+/// What one category of chart texel compared: per ring 0 (interior), 1, 2.
+#[derive(Default, Clone, Copy)]
+struct Tally {
+    compared: [u64; 3],
+    differing: [u64; 3],
+    max: [u32; 3],
+}
+
+impl Tally {
+    fn add(&mut self, ring: usize, delta: u32) {
+        self.compared[ring] += 1;
+        if delta != 0 {
+            self.differing[ring] += 1;
+            self.max[ring] = self.max[ring].max(delta);
+        }
+    }
+    fn merge(&mut self, o: &Tally) {
+        for r in 0..3 {
+            self.compared[r] += o.compared[r];
+            self.differing[r] += o.differing[r];
+            self.max[r] = self.max[r].max(o.max[r]);
+        }
+    }
+    fn line(&self) -> String {
+        (0..3)
+            .map(|r| {
+                format!(
+                    "ring{r} {}/{} differ (max {})",
+                    self.differing[r], self.compared[r], self.max[r]
+                )
+            })
+            .collect::<Vec<_>>()
+            .join(" | ")
+    }
+}
+
+const VALUES: [&str; 4] = [
+    "irradiance RGBA16F bits",
+    "direction RG8 (reduced)",
+    "mask u8 (pre-BC5)",
+    "mask u8 (BC5 decoded)",
+];
+
+/// Chart classes: same orientation and both at the canonical phase (origin
+/// even on both axes), same orientation with the phase moved, transposed in
+/// one layout only.
+const CLASSES: [&str; 4] = [
+    "same orientation, both canonical phase",
+    "same orientation, phase differs from canonical in a layout",
+    "transposed in exactly one layout, both canonical phase",
+    "transposed in exactly one layout, phase differs from canonical in a layout",
+];
+
+struct Side<'a> {
+    prl: &'a Prl,
+    masks: &'a HashMap<u32, (u32, u32, Vec<u8>)>,
+}
+
+/// The block texel of canonical padded texel `(cx, cy)` of `row`.
+fn block_texel(row: &ChartRow, cx: u32, cy: u32) -> (u32, u32) {
+    let (px, py) = if row.rotated { (cy, cx) } else { (cx, cy) };
+    (row.lx + px, row.ly + py)
+}
+
+pub(crate) fn run_compare2(args: &[String]) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        args.len() == 6,
+        "usage: a.tsv a.prl a.masks b.tsv b.prl b.masks"
+    );
+    let rows_a = read_charts(&args[0])?;
+    let prl_a = read_prl(&args[1], true)?;
+    let masks_a = read_masks(&args[2])?;
+    let rows_b = read_charts(&args[3])?;
+    let prl_b = read_prl(&args[4], true)?;
+    let masks_b = read_masks(&args[5])?;
+    anyhow::ensure!(rows_a.len() == rows_b.len(), "chart counts differ");
+    for (a, b) in rows_a.iter().zip(&rows_b) {
+        anyhow::ensure!(
+            a.face == b.face && a.cell == b.cell && (a.w, a.h) == (b.w, b.h),
+            "chart {} differs between dumps",
+            a.face
+        );
+    }
+    for prl in [&prl_a, &prl_b] {
+        anyhow::ensure!(
+            prl.lightmap.irradiance_format == IRRADIANCE_FORMAT_RGBA16F,
+            "bake with --uncompressed-irradiance"
+        );
+    }
+    let scale = prl_a.lightmap.direction_texel_scale;
+    anyhow::ensure!(scale == prl_b.lightmap.direction_texel_scale);
+    let a = Side {
+        prl: &prl_a,
+        masks: &masks_a,
+    };
+    let b = Side {
+        prl: &prl_b,
+        masks: &masks_b,
+    };
+
+    // Owner tables must agree for mask channels to mean the same lights.
+    let owners_equal = match (&prl_a.shadowmask, &prl_b.shadowmask) {
+        (Some(x), Some(y)) => x.owners == y.owners,
+        (None, None) => true,
+        _ => false,
+    };
+    println!(
+        "faces {}; owner tables equal: {owners_equal}; direction scale {scale}",
+        rows_a.len()
+    );
+
+    let mut tallies = vec![[Tally::default(); VALUES.len()]; CLASSES.len()];
+    let mut class_faces = [0usize; CLASSES.len()];
+    let mut edge_dir = [[0u64; 2]; CLASSES.len()];
+    let mut samples: Vec<String> = Vec::new();
+    let mut decoded_a: BTreeMap<u32, [Option<Vec<u8>>; 2]> = BTreeMap::new();
+    let mut decoded_b: BTreeMap<u32, [Option<Vec<u8>>; 2]> = BTreeMap::new();
+    let pad = CHART_PADDING_TEXELS;
+    for i in 0..rows_a.len() {
+        let (ra, rb) = (&rows_a[i], &rows_b[i]);
+        let canonical = |r: &ChartRow| r.lx % 2 == 0 && r.ly % 2 == 0;
+        let both = canonical(ra) && canonical(rb);
+        let class = match (ra.rotated != rb.rotated, both) {
+            (false, true) => 0,
+            (false, false) => 1,
+            (true, true) => 2,
+            (true, false) => 3,
+        };
+        class_faces[class] += 1;
+        let t = &mut tallies[class];
+        let decode =
+            |side: &Side<'_>, cache: &mut BTreeMap<u32, [Option<Vec<u8>>; 2]>, block: u32| {
+                cache
+                    .entry(block)
+                    .or_insert_with(|| {
+                        let rec = &side.prl.lightmap_index.records[block as usize];
+                        let (w, h) = (u32::from(rec.width), u32::from(rec.height));
+                        std::array::from_fn(|g| {
+                            side.prl.shadowmask.as_ref().and_then(|m| {
+                                let p = &m.blocks[block as usize][g];
+                                (!p.is_empty()).then(|| crate::bc5::decode_bc5_rg(p, w, h))
+                            })
+                        })
+                    })
+                    .clone()
+            };
+        let planes_a = decode(&a, &mut decoded_a, ra.block);
+        let planes_b = decode(&b, &mut decoded_b, rb.block);
+        let block_a = &prl_a.lightmap.blocks[ra.block as usize];
+        let block_b = &prl_b.lightmap.blocks[rb.block as usize];
+        let mask_a = a.masks.get(&ra.block);
+        let mask_b = b.masks.get(&rb.block);
+        for cy in 0..ra.h {
+            for cx in 0..ra.w {
+                let ring_of = |v: u32, n: u32| {
+                    if v < pad {
+                        pad - v
+                    } else if v >= n - pad {
+                        v - (n - pad) + 1
+                    } else {
+                        0
+                    }
+                };
+                let ring = ring_of(cx, ra.w).max(ring_of(cy, ra.h)) as usize;
+                let (xa, ya) = block_texel(ra, cx, cy);
+                let (xb, yb) = block_texel(rb, cx, cy);
+                let wa = u32::from(block_a.width);
+                let wb = u32::from(block_b.width);
+                let ia = (ya * wa + xa) as usize;
+                let ib = (yb * wb + xb) as usize;
+                let irr_a = &block_a.irradiance[ia * 8..ia * 8 + 8];
+                let irr_b = &block_b.irradiance[ib * 8..ib * 8 + 8];
+                let irr_delta = (0..4)
+                    .map(|k| {
+                        let va = u16::from_le_bytes([irr_a[2 * k], irr_a[2 * k + 1]]);
+                        let vb = u16::from_le_bytes([irr_b[2 * k], irr_b[2 * k + 1]]);
+                        u32::from(va.abs_diff(vb))
+                    })
+                    .max()
+                    .unwrap();
+                t[0].add(ring, irr_delta);
+                if irr_delta != 0 && samples.len() < 60 {
+                    samples.push(format!(
+                        "irr face {} class {class} canon ({cx},{cy}) ring {ring}: A {:?} B {:?}",
+                        ra.face, irr_a, irr_b
+                    ));
+                }
+                let ja = (((ya / scale) * (wa / scale) + xa / scale) * 2) as usize;
+                let jb = (((yb / scale) * (wb / scale) + xb / scale) * 2) as usize;
+                let dir_delta = u32::from(block_a.direction[ja].abs_diff(block_b.direction[jb]))
+                    .max(u32::from(
+                        block_a.direction[ja + 1].abs_diff(block_b.direction[jb + 1]),
+                    ));
+                t[1].add(ring, dir_delta);
+                if dir_delta != 0 {
+                    // A direction group at an odd far edge holds one texel
+                    // outside the chart: a neighbour's or an empty one.
+                    let odd_edge =
+                        (cx == ra.w - 1 && ra.w % 2 == 1) || (cy == ra.h - 1 && ra.h % 2 == 1);
+                    edge_dir[class][usize::from(odd_edge)] += 1;
+                }
+                if dir_delta != 0 && (class == 0 || class == 2) && samples.len() < 120 {
+                    samples.push(format!(
+                        "dir face {} class {class} canon ({cx},{cy}) ring {ring}: A {:?} B {:?}",
+                        ra.face,
+                        &block_a.direction[ja..ja + 2],
+                        &block_b.direction[jb..jb + 2]
+                    ));
+                }
+                let raw = |m: Option<&(u32, u32, Vec<u8>)>, x: u32, y: u32| -> [u8; 4] {
+                    m.map_or([0; 4], |(w, _, raw)| {
+                        let o = ((y * w + x) * 4) as usize;
+                        [raw[o], raw[o + 1], raw[o + 2], raw[o + 3]]
+                    })
+                };
+                let (ma, mb) = (raw(mask_a, xa, ya), raw(mask_b, xb, yb));
+                let mask_delta = (0..4)
+                    .map(|c| u32::from(ma[c].abs_diff(mb[c])))
+                    .max()
+                    .unwrap();
+                t[2].add(ring, mask_delta);
+                if mask_delta != 0 && samples.len() < 180 {
+                    samples.push(format!(
+                        "mask face {} class {class} canon ({cx},{cy}) ring {ring}: A {ma:?} B {mb:?}",
+                        ra.face
+                    ));
+                }
+                let bc = |planes: &[Option<Vec<u8>>; 2], w: u32, x: u32, y: u32| -> [u8; 4] {
+                    let o = ((y * w + x) * 2) as usize;
+                    let g = |p: &Option<Vec<u8>>| p.as_ref().map_or([0, 0], |p| [p[o], p[o + 1]]);
+                    let (p, q) = (g(&planes[0]), g(&planes[1]));
+                    [p[0], p[1], q[0], q[1]]
+                };
+                let (da, db) = (bc(&planes_a, wa, xa, ya), bc(&planes_b, wb, xb, yb));
+                let bc_delta = (0..4)
+                    .map(|c| u32::from(da[c].abs_diff(db[c])))
+                    .max()
+                    .unwrap();
+                t[3].add(ring, bc_delta);
+            }
+        }
+    }
+    println!("ring 0 = chart interior, rings 1-2 = padding (1 next to the interior)");
+    for (class, name) in CLASSES.iter().enumerate() {
+        println!("== {name}: {} charts", class_faces[class]);
+        for (value, tally) in VALUES.iter().zip(&tallies[class]) {
+            println!("  {value:<26} {}", tally.line());
+        }
+        println!(
+            "  direction diffs at an odd far edge (group straddles the chart edge): {} of {}",
+            edge_dir[class][1],
+            edge_dir[class][0] + edge_dir[class][1]
+        );
+    }
+    let mut all = [Tally::default(); VALUES.len()];
+    for class in &tallies {
+        for (x, y) in all.iter_mut().zip(class) {
+            x.merge(y);
+        }
+    }
+    println!("== all charts");
+    for (value, tally) in VALUES.iter().zip(&all) {
+        println!("  {value:<26} {}", tally.line());
+    }
+    for s in samples {
+        println!("  {s}");
+    }
+    Ok(())
+}
+
+/// `prl-build --spike-ownercheck <charts.tsv> <level.prl>`: the pre-pack
+/// owner estimate against the real owners, containment of every owned chart
+/// in its block's estimated-owner sub-rect, and the pool bound under each
+/// mask item extent.
+pub(crate) fn run_ownercheck(args: &[String]) -> anyhow::Result<()> {
+    use super::cell_input::BoundCellInput;
+    use super::demand::LayerPrices;
+    use super::{CellBlocks, worst_cell_demand};
+    use crate::cell_residency_bake::camera_cells;
+    use postretro_level_format::lightmap_pool::{
+        MASK_POOL_LAYER_BYTES, first_generation_layers, lightmap_pool_layer_bytes,
+        streamed_pool_bytes,
+    };
+    let rows = read_charts(&args[0])?;
+    let prl = read_prl(&args[1], true)?;
+    let mask = prl.shadowmask.as_ref().context("no id 42")?;
+    let owned = |r: &ChartRow| mask.owners[r.face].iter().any(|&o| o != u16::MAX);
+    let texels = |r: &ChartRow| u64::from(r.w) * u64::from(r.h);
+    let (mut est, mut est_tex, mut own, mut own_tex, mut missed) = (0, 0u64, 0, 0u64, 0);
+    let (mut outside, mut owned_with_rect) = (0, 0);
+    for r in &rows {
+        if r.estimate {
+            est += 1;
+            est_tex += texels(r);
+        }
+        if owned(r) {
+            own += 1;
+            own_tex += texels(r);
+            missed += usize::from(!r.estimate);
+            let (pw, ph) = if r.rotated { (r.h, r.w) } else { (r.w, r.h) };
+            owned_with_rect += 1;
+            if r.lx + pw > r.owned_rect.0 || r.ly + ph > r.owned_rect.1 {
+                outside += 1;
+            }
+        }
+    }
+    println!(
+        "charts {}; estimate {est} ({:.2}M padded texels); owned {own} ({:.2}M); owned charts the estimate misses: {missed}; owned charts outside their block's estimated-owner sub-rect: {outside} of {owned_with_rect}",
+        rows.len(),
+        est_tex as f64 / 1e6,
+        own_tex as f64 / 1e6
+    );
+    // Nonzero mask texels outside the estimated-owner sub-rect.
+    let mut rect_of: BTreeMap<u32, (u32, u32)> = BTreeMap::new();
+    for r in &rows {
+        rect_of.insert(r.block, r.owned_rect);
+    }
+    let mut stray = 0u64;
+    for (block, planes) in mask.blocks.iter().enumerate() {
+        let rec = &prl.lightmap_index.records[block];
+        let (w, h) = (u32::from(rec.width), u32::from(rec.height));
+        let (ow, oh) = rect_of.get(&(block as u32)).copied().unwrap_or((0, 0));
+        for plane in planes.iter().filter(|p| !p.is_empty()) {
+            let rg = crate::bc5::decode_bc5_rg(plane, w, h);
+            for y in 0..h {
+                for x in 0..w {
+                    let o = ((y * w + x) * 2) as usize;
+                    if (rg[o] != 0 || rg[o + 1] != 0) && (x >= ow || y >= oh) {
+                        stray += 1;
+                    }
+                }
+            }
+        }
+    }
+    println!("nonzero decoded mask texels outside the estimated-owner sub-rect: {stray}");
+
+    let header = prl.lightmap.header();
+    let align = header.block_alignment();
+    let lm_layer = lightmap_pool_layer_bytes(&header).context("format")?;
+    let prices = LayerPrices::of(&prl.lightmap)?;
+    let cells_n = prl.cells.cells.len();
+    let input = BoundCellInput::new(&prl.residency, &prl.directory)?;
+    let cameras = camera_cells(&prl.cells);
+    let blocks = CellBlocks::new_from_index(&prl.lightmap_index, cells_n)?;
+    let full = postretro_level_format::lightmap_pool::PoolDemand::new(
+        align,
+        prl.lightmap_index
+            .records
+            .iter()
+            .map(|r| (u32::from(r.width), u32::from(r.height)))
+            .collect(),
+        Some(
+            mask.blocks
+                .iter()
+                .map(|planes| planes.each_ref().map(|p| !p.is_empty()))
+                .collect(),
+        ),
+    );
+    let up = |v: u32| v.div_ceil(align) * align;
+    let estimated: Vec<(u32, u32)> = (0..full.block_count() as u32)
+        .map(|b| {
+            let e = full.extents()[b as usize];
+            rect_of.get(&b).map_or(e, |&(w, h)| {
+                (up(w).max(align).min(e.0), up(h).max(align).min(e.1))
+            })
+        })
+        .collect();
+    let nonzero = super::demand::owned_mask_extents(&prl.lightmap, mask, align);
+    for (label, demand) in [
+        ("whole block (HEAD)", full.clone()),
+        (
+            "estimated-owner sub-rect",
+            full.clone().with_mask_extents(estimated),
+        ),
+        (
+            "nonzero texels' sub-rect (compiler bound)",
+            full.clone().with_mask_extents(nonzero),
+        ),
+    ] {
+        let worst = worst_cell_demand(
+            &cameras,
+            |c, s| input.cells_of(c, s),
+            &blocks,
+            &demand,
+            prices,
+        )?;
+        let all = super::all_resident_layers(&demand)?;
+        let lm = first_generation_layers(worst.layers.lightmap, all.lightmap);
+        let mk = first_generation_layers(worst.layers.mask, all.mask);
+        let lm_b = streamed_pool_bytes(lm, lm_layer);
+        let mk_b = streamed_pool_bytes(mk, MASK_POOL_LAYER_BYTES);
+        println!(
+            "{label:<44} worst {}/{} -> layers {lm}/{mk} (+1 spare each), all-resident {}/{}: lightmap {:.1} + mask {:.1} = {:.1} MiB",
+            worst.layers.lightmap,
+            worst.layers.mask,
+            all.lightmap,
+            all.mask,
+            lm_b as f64 / 1048576.0,
+            mk_b as f64 / 1048576.0,
+            (lm_b + mk_b) as f64 / 1048576.0
+        );
+    }
+    Ok(())
+}
diff --git a/crates/level-compiler/src/pack/lightmap_pool_bound/spike_sim.rs b/crates/level-compiler/src/pack/lightmap_pool_bound/spike_sim.rs
new file mode 100644
index 0000000..8ee686f
--- /dev/null
+++ b/crates/level-compiler/src/pack/lightmap_pool_bound/spike_sim.rs
@@ -0,0 +1,1159 @@
+//! SPIKE (packing): offline sweep of per-cell packers and pool placements
+//! against a compiled PRL's cells, residency set and masks, through the
+//! bound's own cell input and worst-cell loop.
+//! `prl-build --spike-packsim <charts.tsv> <head.prl> <spec>...`
+
+use std::collections::{BTreeMap, HashMap};
+use std::fs::File;
+use std::io::{BufRead, BufReader};
+use std::time::Instant;
+
+use anyhow::Context;
+use postretro_level_format::cell_residency_set::CellResidencySetSection;
+use postretro_level_format::cells::CellsSection;
+use postretro_level_format::cluster_directory::ClusterDirectorySection;
+use postretro_level_format::lightmap::{
+    LIGHTMAP_POOL_LAYER_EDGE, LightmapBlockIndex, LightmapSection,
+};
+use postretro_level_format::lightmap_pool::{
+    MASK_POOL_LAYER_BYTES, PackScratch, PerPool, PoolDemand, first_generation_layers,
+    lightmap_pool_layer_bytes, streamed_pool_bytes,
+};
+use postretro_level_format::shadowmask_atlas::{ShadowmaskAtlasSection, ShadowmaskOwnerBounds};
+use postretro_level_format::{SectionId, read_container, read_section_data};
+use rayon::prelude::*;
+
+use super::cell_input::BoundCellInput;
+use super::demand::{LayerPrices, layers_of};
+use super::{CellBlocks, worst_cell_demand};
+use crate::cell_residency_bake::camera_cells;
+use crate::lightmap_bake::spike_pack::{
+    Heuristic, PackConfig, maxrects_layers, pack_cell_sub_blocks_cfg,
+};
+
+/// One dumped chart: its padded extent and HEAD's block and block-local origin.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct ChartRow {
+    pub face: usize,
+    pub cell: u32,
+    pub w: u32,
+    pub h: u32,
+    pub block: u32,
+    pub lx: u32,
+    pub ly: u32,
+    pub bw: u32,
+    pub bh: u32,
+    pub rotated: bool,
+    /// The pre-pack owner estimate marked the chart.
+    pub estimate: bool,
+    pub windowed: bool,
+    /// The block's estimated-owner sub-rect, from its origin.
+    pub owned_rect: (u32, u32),
+}
+
+pub(crate) fn read_charts(path: &str) -> anyhow::Result<Vec<ChartRow>> {
+    let file = BufReader::new(File::open(path).with_context(|| path.to_string())?);
+    let mut rows = Vec::new();
+    for line in file.lines().skip(1) {
+        let line = line?;
+        let f: Vec<u64> = line.split('\t').map(|v| v.parse().unwrap()).collect();
+        rows.push(ChartRow {
+            face: f[0] as usize,
+            cell: f[1] as u32,
+            w: f[2] as u32,
+            h: f[3] as u32,
+            block: f[4] as u32,
+            lx: f[5] as u32,
+            ly: f[6] as u32,
+            bw: f[7] as u32,
+            bh: f[8] as u32,
+            rotated: f.get(10).is_some_and(|&v| v == 1),
+            estimate: f.get(11).is_some_and(|&v| v == 1),
+            windowed: f.get(9).is_some_and(|&v| v == 1),
+            owned_rect: (
+                f.get(12).copied().unwrap_or(0) as u32,
+                f.get(13).copied().unwrap_or(0) as u32,
+            ),
+        });
+    }
+    Ok(rows)
+}
+
+pub(crate) struct Prl {
+    pub cells: CellsSection,
+    pub directory: ClusterDirectorySection,
+    pub residency: CellResidencySetSection,
+    pub lightmap: LightmapSection,
+    pub lightmap_index: LightmapBlockIndex,
+    pub shadowmask: Option<ShadowmaskAtlasSection>,
+}
+
+pub(crate) fn read_prl(path: &str, payloads: bool) -> anyhow::Result<Prl> {
+    let mut reader = BufReader::new(File::open(path).with_context(|| path.to_string())?);
+    let meta = read_container(&mut reader)?;
+    let mut sec = |id: SectionId| -> anyhow::Result<Vec<u8>> {
+        read_section_data(&mut reader, &meta, id as u32)?.with_context(|| format!("missing {id:?}"))
+    };
+    let cells = CellsSection::from_bytes(&sec(SectionId::Cells)?)?;
+    let directory = ClusterDirectorySection::from_bytes(&sec(SectionId::ClusterDirectory)?)
+        .map_err(|e| anyhow::anyhow!("{e:?}"))?;
+    let residency =
+        CellResidencySetSection::from_bytes(&sec(SectionId::CellResidencySet)?, cells.cells.len())?;
+    let lm_bytes = sec(SectionId::Lightmap)?;
+    let lightmap_index = LightmapBlockIndex::from_prefix(&lm_bytes, lm_bytes.len() as u64)?;
+    let lightmap = if payloads {
+        LightmapSection::from_bytes(&lm_bytes)?
+    } else {
+        LightmapSection {
+            direction_texel_scale: lightmap_index.header.direction_texel_scale,
+            irradiance_format: lightmap_index.header.irradiance_format,
+            mode: lightmap_index.header.mode,
+            blocks: Vec::new(),
+        }
+    };
+    drop(lm_bytes);
+    let shadowmask = match sec(SectionId::ShadowmaskAtlas) {
+        Ok(bytes) => {
+            let bounds = ShadowmaskOwnerBounds::from_section_header(&bytes)?;
+            Some(ShadowmaskAtlasSection::from_bytes(
+                &bytes,
+                &lightmap_index,
+                bounds,
+            )?)
+        }
+        Err(_) => None,
+    };
+    Ok(Prl {
+        cells,
+        directory,
+        residency,
+        lightmap,
+        lightmap_index,
+        shadowmask,
+    })
+}
+
+/// Whether each chart's padded rect holds a nonzero texel in HEAD's plane A/B.
+fn chart_planes(rows: &[ChartRow], prl: &Prl) -> Vec<[bool; 2]> {
+    let Some(mask) = &prl.shadowmask else {
+        return vec![[false; 2]; rows.len()];
+    };
+    let mut by_block: BTreeMap<u32, Vec<usize>> = BTreeMap::new();
+    for (i, r) in rows.iter().enumerate() {
+        by_block.entry(r.block).or_default().push(i);
+    }
+    let per_block: Vec<Vec<(usize, [bool; 2])>> = by_block
+        .par_iter()
+        .map(|(&block, members)| {
+            let rec = &prl.lightmap_index.records[block as usize];
+            let (bw, bh) = (u32::from(rec.width), u32::from(rec.height));
+            let planes: Vec<Option<Vec<u8>>> = mask.blocks[block as usize]
+                .iter()
+                .map(|p| (!p.is_empty()).then(|| crate::bc5::decode_bc5_rg(p, bw, bh)))
+                .collect();
+            members
+                .iter()
+                .map(|&i| {
+                    let r = rows[i];
+                    let (pw, ph) = if r.rotated { (r.h, r.w) } else { (r.w, r.h) };
+                    let present = std::array::from_fn(|g| {
+                        planes[g].as_ref().is_some_and(|rg| {
+                            (r.ly..r.ly + ph).any(|y| {
+                                (r.lx..r.lx + pw).any(|x| {
+                                    let t = ((y * bw + x) * 2) as usize;
+                                    rg[t] != 0 || rg[t + 1] != 0
+                                })
+                            })
+                        })
+                    });
+                    (i, present)
+                })
+                .collect()
+        })
+        .collect();
+    let mut out = vec![[false; 2]; rows.len()];
+    for (i, p) in per_block.into_iter().flatten() {
+        out[i] = p;
+    }
+    out
+}
+
+struct Packed {
+    extents: Vec<(u32, u32)>,
+    /// Owned sub-rect of each block, from its origin.
+    mask_extents: Vec<(u32, u32)>,
+    /// The real owners' bounding rect of each block, from its origin.
+    actual_extents: Vec<(u32, u32)>,
+    planes: Vec<[bool; 2]>,
+    /// SPIKE (separate mask layout): per block, the extent of a mask block
+    /// holding only its really-owned charts, packed tightly in their lightmap
+    /// orientation, and the plane-B sub-rect (charts with a plane-B texel
+    /// packed first). `None` unless `SPIKE_SEP_MASK_SPEC` is set.
+    sep_mask: Option<Vec<((u32, u32), (u32, u32))>>,
+    runs: Vec<std::ops::Range<u32>>,
+    chart_area: u64,
+    footprint_area: u64,
+    multi_block_cells: usize,
+    elapsed: f64,
+}
+
+fn pack_all(
+    rows: &[ChartRow],
+    chart_planes: &[[bool; 2]],
+    owned: &[bool],
+    actual: &[bool],
+    cell_count: usize,
+    align: u32,
+    cfg: &PackConfig,
+) -> Packed {
+    let mut by_cell: BTreeMap<u32, Vec<usize>> = BTreeMap::new();
+    for (i, r) in rows.iter().enumerate() {
+        by_cell.entry(r.cell).or_default().push(i);
+    }
+    let cells: Vec<(u32, Vec<usize>)> = by_cell.into_iter().collect();
+    let started = Instant::now();
+    let up = |v: u32| v.div_ceil(align) * align;
+    let sep_cfg: Option<PackConfig> = std::env::var("SPIKE_SEP_MASK_SPEC")
+        .ok()
+        .map(|spec| PackConfig::parse(&spec).expect("SPIKE_SEP_MASK_SPEC"));
+    let sep_masks: std::sync::Mutex<BTreeMap<(u32, usize), ((u32, u32), (u32, u32))>> =
+        std::sync::Mutex::new(BTreeMap::new());
+    let per_cell: Vec<Vec<(Vec<usize>, (u32, u32), (u32, u32), (u32, u32))>> = cells
+        .par_iter()
+        .map(|(_, members)| {
+            let sizes: Vec<(u32, u32)> = members.iter().map(|&i| (rows[i].w, rows[i].h)).collect();
+            let own: Vec<bool> = members.iter().map(|&i| owned[i]).collect();
+            let mut cfg = cfg.clone();
+            cfg.rotate &= members.iter().all(|&i| !rows[i].windowed);
+            pack_cell_sub_blocks_cfg(&sizes, align, LIGHTMAP_POOL_LAYER_EDGE, &cfg, &own)
+                .into_iter()
+                .enumerate()
+                .map(|(sub_i, s)| {
+                    if let Some(mcfg) = &sep_cfg {
+                        // The block's really-owned charts, in their lightmap
+                        // orientation (the mask copy is a pure translation).
+                        let mut m_sizes = Vec::new();
+                        let mut m_b = Vec::new();
+                        for (&m, &r) in s.sub.members.iter().zip(&s.rotated) {
+                            if actual[members[m]] {
+                                m_sizes.push(if r { (sizes[m].1, sizes[m].0) } else { sizes[m] });
+                                m_b.push(chart_planes[members[m]][1]);
+                            }
+                        }
+                        let ext = if m_sizes.is_empty() {
+                            ((0, 0), (0, 0))
+                        } else {
+                            let mut mcfg = mcfg.clone();
+                            mcfg.rotate = false;
+                            let packed = pack_cell_sub_blocks_cfg(
+                                &m_sizes,
+                                4,
+                                LIGHTMAP_POOL_LAYER_EDGE,
+                                &mcfg,
+                                &m_b,
+                            );
+                            assert_eq!(packed.len(), 1, "owned charts of one block fit one mask block");
+                            let p = &packed[0];
+                            let b_ext = if mcfg.owned_first {
+                                p.mask_extent
+                            } else {
+                                (p.sub.block.width, p.sub.block.height)
+                            };
+                            ((p.sub.block.width, p.sub.block.height), b_ext)
+                        };
+                        sep_masks.lock().unwrap().insert((members[0] as u32, sub_i), ext);
+                    }
+                    // The real owners' bounding rect under this packing.
+                    let (mut w, mut h) = (0, 0);
+                    for ((&m, &(x, y)), &r) in s
+                        .sub
+                        .members
+                        .iter()
+                        .zip(&s.sub.block.placements)
+                        .zip(&s.rotated)
+                    {
+                        if actual[members[m]] {
+                            let (cw, ch) = if r {
+                                (sizes[m].1, sizes[m].0)
+                            } else {
+                                sizes[m]
+                            };
+                            w = w.max(x + cw);
+                            h = h.max(y + ch);
+                        }
+                    }
+                    (
+                        s.sub.members.iter().map(|&m| members[m]).collect(),
+                        (s.sub.block.width, s.sub.block.height),
+                        s.mask_extent,
+                        (up(w).min(s.sub.block.width), up(h).min(s.sub.block.height)),
+                    )
+                })
+                .collect()
+        })
+        .collect();
+    let elapsed = started.elapsed().as_secs_f64();
+    let mut extents = Vec::new();
+    let mut mask_extents = Vec::new();
+    let mut actual_extents = Vec::new();
+    let mut planes = Vec::new();
+    let mut runs = vec![0..0; cell_count];
+    let mut multi = 0;
+    let mut sep_order: Vec<(u32, usize)> = Vec::new();
+    let cell_first: BTreeMap<u32, u32> =
+        cells.iter().map(|(c, m)| (*c, m[0] as u32)).collect();
+    let cell_first = |c: &u32| cell_first[c];
+    // Buckets by member count: blocks, block texels, chart texels.
+    let edges = [1usize, 2, 4, 10, 30, 100, usize::MAX];
+    let mut buckets = vec![(0u64, 0u64, 0u64); edges.len() - 1];
+    for ((cell, _), blocks) in cells.iter().zip(per_cell) {
+        let start = extents.len() as u32;
+        multi += usize::from(blocks.len() > 1);
+        for (sub_i, (members, extent, mask_extent, actual_extent)) in blocks.into_iter().enumerate() {
+            sep_order.push((cell_first(cell), sub_i));
+            actual_extents.push(actual_extent);
+            let bi = edges
+                .windows(2)
+                .position(|e| members.len() >= e[0] && members.len() < e[1])
+                .unwrap();
+            buckets[bi].0 += 1;
+            buckets[bi].1 += u64::from(extent.0) * u64::from(extent.1);
+            buckets[bi].2 += members
+                .iter()
+                .map(|&m| u64::from(rows[m].w) * u64::from(rows[m].h))
+                .sum::<u64>();
+            extents.push(extent);
+            mask_extents.push(mask_extent);
+            let mut p = [false; 2];
+            for &m in &members {
+                p[0] |= chart_planes[m][0];
+                p[1] |= chart_planes[m][1];
+            }
+            planes.push(p);
+        }
+        runs[*cell as usize] = start..extents.len() as u32;
+    }
+    if std::env::var_os("SPIKE_BUCKETS").is_some() {
+        let names = ["1", "2-3", "4-9", "10-29", "30-99", "100+"];
+        for (n, b) in names.iter().zip(&buckets) {
+            println!(
+                "#   charts/block {n:>6}: {:>5} blocks, {:>7.2}M block texels, eff {:.3}, waste {:.2}M",
+                b.0,
+                b.1 as f64 / 1e6,
+                b.2 as f64 / b.1.max(1) as f64,
+                (b.1 - b.2) as f64 / 1e6
+            );
+        }
+    }
+    let k = if cfg.head { 1 } else { cfg.chart_align };
+    let sep_mask = sep_cfg.as_ref().map(|_| {
+        let map = sep_masks.into_inner().unwrap();
+        sep_order.iter().map(|key| map[key]).collect()
+    });
+    Packed {
+        sep_mask,
+        extents,
+        mask_extents,
+        actual_extents,
+        planes,
+        runs,
+        chart_area: rows.iter().map(|r| u64::from(r.w) * u64::from(r.h)).sum(),
+        footprint_area: rows
+            .iter()
+            .map(|r| u64::from(r.w.div_ceil(k) * k) * u64::from(r.h.div_ceil(k) * k))
+            .sum(),
+        multi_block_cells: multi,
+        elapsed,
+    }
+}
+
+const MIB: f64 = 1024.0 * 1024.0;
+
+fn pool_mib(bound: PerPool<u32>, all: PerPool<u32>, lm_layer: u64) -> f64 {
+    let lm = first_generation_layers(bound.lightmap, all.lightmap);
+    let mk = first_generation_layers(bound.mask, all.mask);
+    (streamed_pool_bytes(lm, lm_layer) + streamed_pool_bytes(mk, MASK_POOL_LAYER_BYTES)) as f64
+        / MIB
+}
+
+pub(crate) fn run_sim(args: &[String]) -> anyhow::Result<()> {
+    let mut rows = read_charts(&args[0])?;
+    // Measurement: charts with `n` fewer padding texels per side.
+    if let Some(n) = std::env::var("SPIKE_SHRINK")
+        .ok()
+        .and_then(|v| v.parse::<u32>().ok())
+    {
+        for r in &mut rows {
+            r.w -= 2 * n;
+            r.h -= 2 * n;
+        }
+        println!("# charts shrunk by {n} padding texel(s) per side");
+    }
+    let prl = read_prl(&args[1], false)?;
+    let specs = &args[2..];
+    let header = prl.lightmap.header();
+    let align = header.block_alignment();
+    let lm_layer = lightmap_pool_layer_bytes(&header).unwrap();
+    let prices = LayerPrices::of(&prl.lightmap)?;
+    let cell_count = prl.cells.cells.len();
+    let input = BoundCellInput::new(&prl.residency, &prl.directory)?;
+    let cameras = camera_cells(&prl.cells);
+    let elision: Option<Vec<(u32, usize)>> = std::env::var("SPIKE_ELIDE").ok().map(|path| {
+        // Lines "block plane" naming HEAD planes to treat as absent.
+        std::fs::read_to_string(path)
+            .unwrap()
+            .lines()
+            .filter_map(|l| {
+                let mut it = l.split_whitespace();
+                Some((it.next()?.parse().ok()?, it.next()?.parse().ok()?))
+            })
+            .collect()
+    });
+
+    // HEAD's own stored blocks, as the bound saw them.
+    let stored_planes: Vec<[bool; 2]> = prl.shadowmask.as_ref().map_or_else(
+        || vec![[false; 2]; prl.lightmap_index.records.len()],
+        |m| {
+            m.blocks
+                .iter()
+                .map(|[a, b]| [!a.is_empty(), !b.is_empty()])
+                .collect()
+        },
+    );
+    let t = Instant::now();
+    let cplanes = chart_planes(&rows, &prl);
+    let actual: Vec<bool> = rows
+        .iter()
+        .map(|r| {
+            prl.shadowmask
+                .as_ref()
+                .is_some_and(|m| m.owners[r.face].iter().any(|&o| o != u16::MAX))
+        })
+        .collect();
+    // SPIKE (ownership): `SPIKE_OWNED=estimate` packs owned-first from the
+    // dump's pre-pack estimate; the default packs from the real owners.
+    let owned: Vec<bool> = if std::env::var("SPIKE_OWNED").as_deref() == Ok("estimate") {
+        println!("# owned-first ordering from the pre-pack estimate");
+        rows.iter().map(|r| r.estimate).collect()
+    } else {
+        actual.clone()
+    };
+    let missed = actual
+        .iter()
+        .zip(&rows)
+        .filter(|(a, r)| **a && !r.estimate)
+        .count();
+    println!(
+        "estimate {} charts ({:.2}M padded texels); actual owned {} charts; owned charts the estimate misses: {missed}",
+        rows.iter().filter(|r| r.estimate).count(),
+        rows.iter()
+            .filter(|r| r.estimate)
+            .map(|r| u64::from(r.w) * u64::from(r.h))
+            .sum::<u64>() as f64
+            / 1e6,
+        actual.iter().filter(|&&a| a).count(),
+    );
+    let present_unowned = cplanes
+        .iter()
+        .zip(&owned)
+        .filter(|(p, o)| (p[0] || p[1]) && !**o)
+        .count();
+    println!(
+        "owned charts {} of {}; owned padded texels {:.2}M of {:.2}M; charts with a plane but no owner: {present_unowned}",
+        owned.iter().filter(|&&o| o).count(),
+        rows.len(),
+        rows.iter()
+            .zip(&owned)
+            .filter(|(_, o)| **o)
+            .map(|(r, _)| u64::from(r.w) * u64::from(r.h))
+            .sum::<u64>() as f64
+            / 1e6,
+        rows.iter()
+            .map(|r| u64::from(r.w) * u64::from(r.h))
+            .sum::<u64>() as f64
+            / 1e6,
+    );
+    // Validate per-chart presence against HEAD's stored planes.
+    let mut derived = vec![[false; 2]; stored_planes.len()];
+    for (r, p) in rows.iter().zip(&cplanes) {
+        derived[r.block as usize][0] |= p[0];
+        derived[r.block as usize][1] |= p[1];
+    }
+    let mismatches = derived
+        .iter()
+        .zip(&stored_planes)
+        .filter(|(a, b)| a != b)
+        .count();
+    println!(
+        "charts {} blocks(HEAD) {} cells {} camera cells {}; chart plane presence derived in {:.1}s, {} block mismatches vs stored id 42",
+        rows.len(),
+        stored_planes.len(),
+        cell_count,
+        cameras.len(),
+        t.elapsed().as_secs_f64(),
+        mismatches
+    );
+
+    let mut stored_demand_planes = stored_planes.clone();
+    if let Some(elide) = &elision {
+        for &(block, plane) in elide {
+            stored_demand_planes[block as usize][plane] = false;
+        }
+        let stored_extents: Vec<(u32, u32)> = prl
+            .lightmap_index
+            .records
+            .iter()
+            .map(|r| (u32::from(r.width), u32::from(r.height)))
+            .collect();
+        let demand = PoolDemand::new(align, stored_extents, Some(stored_demand_planes.clone()));
+        let blocks = CellBlocks::new_from_index(&prl.lightmap_index, cell_count)?;
+        let worst = worst_cell_demand(
+            &cameras,
+            |c, s| input.cells_of(c, s),
+            &blocks,
+            &demand,
+            prices,
+        )?;
+        let all = super::all_resident_layers(&demand)?;
+        println!(
+            "HEAD stored layout with {} elided planes: bound {}/{} layers, all-resident {}/{}, pool {:.1} MiB",
+            elide.len(),
+            worst.layers.lightmap,
+            worst.layers.mask,
+            all.lightmap,
+            all.mask,
+            pool_mib(worst.layers, all, lm_layer)
+        );
+    }
+
+    println!(
+        "spec\tblocks\tmulti_cells\tblock_Mtex\tchart_Mtex\tfootprint_Mtex\teff\tpack_s\tbound_lm\tbound_mask\tall_lm\tall_mask\tpool_MiB\tworst_set_fill"
+    );
+    for spec in specs {
+        let cfg = PackConfig::parse(spec).map_err(|e| anyhow::anyhow!(e))?;
+        let packed = pack_all(&rows, &cplanes, &owned, &actual, cell_count, align, &cfg);
+        if cfg.head {
+            // HEAD must reproduce the dump's blocks exactly.
+            let mut dumped: BTreeMap<u32, (u32, u32)> = BTreeMap::new();
+            for r in &rows {
+                dumped.insert(r.block, (r.bw, r.bh));
+            }
+            let mine: Vec<(u32, u32)> = packed.extents.clone();
+            let theirs: Vec<(u32, u32)> = dumped.values().copied().collect();
+            let mut a = mine.clone();
+            let mut b = theirs.clone();
+            a.sort_unstable();
+            b.sort_unstable();
+            println!("# head reproduces dumped block extents: {}", a == b);
+        }
+        let block_area: u64 = packed
+            .extents
+            .iter()
+            .map(|&(w, h)| u64::from(w) * u64::from(h))
+            .sum();
+        let demand = PoolDemand::new(align, packed.extents.clone(), Some(packed.planes.clone()));
+        let blocks = CellBlocks(packed.runs.clone());
+        let t = Instant::now();
+        let worst = worst_cell_demand(
+            &cameras,
+            |c, s| input.cells_of(c, s),
+            &blocks,
+            &demand,
+            prices,
+        )?;
+        let all = super::all_resident_layers(&demand)?;
+        // Fill of the worst lightmap set: its block area over its layers.
+        let fill = worst_set_fill(&cameras, &input, &blocks, &demand, worst.layers.lightmap)?;
+        println!(
+            "{spec}\t{}\t{}\t{:.2}\t{:.2}\t{:.2}\t{:.4}\t{:.1}\t{}\t{}\t{}\t{}\t{:.1}\t{:.4}\t(bound {:.1}s)",
+            packed.extents.len(),
+            packed.multi_block_cells,
+            block_area as f64 / 1e6,
+            packed.chart_area as f64 / 1e6,
+            packed.footprint_area as f64 / 1e6,
+            packed.chart_area as f64 / block_area as f64,
+            packed.elapsed,
+            worst.layers.lightmap,
+            worst.layers.mask,
+            all.lightmap,
+            all.mask,
+            pool_mib(worst.layers, all, lm_layer),
+            fill,
+            t.elapsed().as_secs_f64()
+        );
+        if !cfg.head {
+            subrect_bound(
+                &cameras,
+                &input,
+                &blocks,
+                &packed,
+                &packed.mask_extents,
+                "packed owned sub-rect",
+                align,
+            )?;
+            subrect_bound(
+                &cameras,
+                &input,
+                &blocks,
+                &packed,
+                &packed.actual_extents,
+                "real owners' rect",
+                align,
+            )?;
+        }
+        if let Some(sep) = &packed.sep_mask {
+            let lm_gen = first_generation_layers(worst.layers.lightmap, all.lightmap);
+            let lm_mib = streamed_pool_bytes(lm_gen, lm_layer) as f64 / MIB;
+            for b_sub in [false, true] {
+                sep_mask_bound(&cameras, &input, &blocks, &packed, sep, b_sub, lm_gen, lm_mib)?;
+            }
+        }
+        if std::env::var_os("SPIKE_POOL_ALT").is_some() {
+            pool_alternatives(&cameras, &input, &blocks, &demand, worst.layers)?;
+        }
+    }
+    Ok(())
+}

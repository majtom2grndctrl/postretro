diff --git a/crates/level-format/examples/transcode_lightmap.rs b/crates/level-format/examples/transcode_lightmap.rs
new file mode 100644
index 0000000..8baa1a9
--- /dev/null
+++ b/crates/level-format/examples/transcode_lightmap.rs
@@ -0,0 +1,293 @@
+// SPIKE: rewrite a PRL's ids 22/42 with per-block coding; every other section
+// is copied byte for byte.
+// See: context/lib/rendering_pipeline.md §4 (Lightmap cell-block residency)
+//
+//   cargo run -p postretro-level-format --release --example transcode_lightmap -- \
+//     <in.prl> <out.prl> none|lz4|zstd:<level>|keep [id50: none|zstd:<level>|keep]
+//
+// `keep` copies ids 22/42 (or id 50) unchanged. An id-50 codec rewrites the
+// section at epoch 3: an epoch-2 input has its section and chunk epoch words
+// bumped (the only epoch-3 change to a stored chunk), then every chunk is
+// stored as is (`none`) or as one zstd frame, rehashed over stored bytes.
+
+use std::fs::File;
+use std::io::{BufWriter, Read, Seek, SeekFrom, Write};
+use std::time::Instant;
+
+use postretro_level_format::block_codec::{BlockCodec, PairCoding, encode_plane};
+use postretro_level_format::cluster_sh_payloads::{
+    CLUSTER_SH_PAYLOADS_VERSION, ClusterShPayloadsSection,
+};
+use postretro_level_format::lightmap::{
+    CodedLightmapBlock, LightmapBlockIndex, coded_lightmap_section_bytes,
+};
+use postretro_level_format::shadowmask_atlas::{
+    ShadowmaskBlockIndex, ShadowmaskOwnerBounds, coded_shadowmask_section_bytes,
+};
+use postretro_level_format::{SectionDescriptor, SectionId, read_container};
+use rayon::prelude::*;
+
+const LIGHTMAP: u32 = SectionId::Lightmap as u32;
+const SHADOWMASK: u32 = SectionId::ShadowmaskAtlas as u32;
+const CLUSTER_SH: u32 = SectionId::ClusterShPayloads as u32;
+
+/// Rewrite id 50 at epoch 3 with every chunk stored (`level` None) or coded.
+fn transcode_id50(section: &[u8], level: Option<i32>) -> Vec<u8> {
+    let mut bytes = section.to_vec();
+    let epoch = u32::from_le_bytes(bytes[0..4].try_into().unwrap());
+    let from_epoch2 = epoch == 2;
+    if from_epoch2 {
+        bytes[0..4].copy_from_slice(&CLUSTER_SH_PAYLOADS_VERSION.to_le_bytes());
+    }
+    let metadata_len = ClusterShPayloadsSection::metadata_len_from_header(&bytes).unwrap();
+    let mut parsed =
+        ClusterShPayloadsSection::from_metadata_bytes(&bytes[..metadata_len], bytes.len() as u64)
+            .unwrap();
+    let mut payload = bytes[metadata_len..].to_vec();
+    for entry in &mut parsed.index {
+        assert_eq!(
+            entry.codec,
+            postretro_level_format::block_codec::BlockCodec::None,
+            "input id 50 is already coded"
+        );
+        let start = entry.payload_offset as usize;
+        if entry.payload_len == 0 {
+            continue;
+        }
+        if from_epoch2 {
+            payload[start..start + 4].copy_from_slice(&CLUSTER_SH_PAYLOADS_VERSION.to_le_bytes());
+        }
+        entry.hash = *blake3::hash(&payload[start..start + entry.payload_len as usize]).as_bytes();
+    }
+    let (parsed, payload) = match level {
+        Some(level) => parsed.compress_chunks(&payload, level).unwrap(),
+        None => (parsed, payload),
+    };
+    parsed.try_to_bytes(&payload).unwrap()
+}
+
+fn parse_codec(arg: &str) -> (BlockCodec, i32) {
+    match arg.split_once(':') {
+        Some(("zstd", level)) => (BlockCodec::Zstd, level.parse().expect("zstd level")),
+        None if arg == "lz4" => (BlockCodec::Lz4, 0),
+        None if arg == "none" => (BlockCodec::None, 0),
+        _ => panic!("codec is none, lz4 or zstd:<level>"),
+    }
+}
+
+fn read_at(file: &mut File, offset: u64, len: u64) -> Vec<u8> {
+    let mut out = vec![0; len as usize];
+    file.seek(SeekFrom::Start(offset)).unwrap();
+    file.read_exact(&mut out).unwrap();
+    out
+}
+
+/// Each plane coded; a block whose coded planes are no smaller stays stored.
+fn code_pair(codec: BlockCodec, level: i32, planes: [&[u8]; 2]) -> (PairCoding, [Vec<u8>; 2]) {
+    let raw_lens = [planes[0].len() as u32, planes[1].len() as u32];
+    let coded = planes.map(|p| {
+        if p.is_empty() {
+            Vec::new()
+        } else {
+            encode_plane(codec, level, p)
+        }
+    });
+    if codec != BlockCodec::None
+        && coded[0].len() + coded[1].len() < planes[0].len() + planes[1].len()
+    {
+        (PairCoding { codec, raw_lens }, coded)
+    } else {
+        (
+            PairCoding {
+                codec: BlockCodec::None,
+                raw_lens,
+            },
+            planes.map(<[u8]>::to_vec),
+        )
+    }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let (input, output, codec, id50) = match args.as_slice() {
+        [_, input, output, codec] => (input, output, codec, "keep"),
+        [_, input, output, codec, id50] => (input, output, codec, id50.as_str()),
+        _ => panic!(
+            "usage: transcode_lightmap <in.prl> <out.prl> none|lz4|zstd:<level>|keep [none|zstd:<level>|keep]"
+        ),
+    };
+    let mut file = File::open(input).unwrap();
+    let meta = read_container(&mut file).unwrap();
+    let entry = |id| meta.find_section(id).expect("section present").clone();
+    let new_id50 = match id50 {
+        "keep" => None,
+        other => {
+            let level = match parse_codec(other) {
+                (BlockCodec::None, _) => None,
+                (BlockCodec::Zstd, level) => Some(level),
+                _ => panic!("id 50 takes none or zstd:<level>"),
+            };
+            let section = entry(CLUSTER_SH);
+            let started = Instant::now();
+            let new = transcode_id50(&read_at(&mut file, section.offset, section.size), level);
+            println!(
+                "id 50: {} -> {} bytes ({:.1}%), {:.1} s (1 thread)",
+                section.size,
+                new.len(),
+                100.0 * new.len() as f64 / section.size as f64,
+                started.elapsed().as_secs_f64()
+            );
+            Some(new)
+        }
+    };
+    if codec == "keep" {
+        write_out(&mut file, &meta, output, None, None, new_id50.as_deref());
+        return;
+    }
+    let (codec, level) = parse_codec(codec);
+
+    let lightmap_entry = entry(LIGHTMAP);
+    let lightmap = read_at(&mut file, lightmap_entry.offset, lightmap_entry.size);
+    let index = LightmapBlockIndex::from_prefix(&lightmap, lightmap.len() as u64).unwrap();
+    assert!(!index.header.coded, "input id 22 is already coded");
+    let started = Instant::now();
+    let blocks: Vec<CodedLightmapBlock> = index
+        .records
+        .par_iter()
+        .map(|record| {
+            let slice = |r: postretro_level_format::lightmap::SectionByteRange| {
+                &lightmap[r.offset as usize..r.offset as usize + r.len as usize]
+            };
+            let (coding, [irradiance, direction]) = code_pair(
+                codec,
+                level,
+                [slice(record.irradiance), slice(record.direction)],
+            );
+            CodedLightmapBlock {
+                cell_id: record.cell_id,
+                width: record.width,
+                height: record.height,
+                coding,
+                irradiance,
+                direction,
+            }
+        })
+        .collect();
+    let new_lightmap = coded_lightmap_section_bytes(index.header, &blocks);
+    let lightmap_secs = started.elapsed().as_secs_f64();
+
+    let shadowmask_entry = entry(SHADOWMASK);
+    let shadowmask = read_at(&mut file, shadowmask_entry.offset, shadowmask_entry.size);
+    let bounds = ShadowmaskOwnerBounds::from_section_header(&shadowmask).unwrap();
+    let masks =
+        ShadowmaskBlockIndex::from_prefix(&shadowmask, shadowmask.len() as u64, &index, bounds)
+            .unwrap();
+    assert!(masks.coding.is_none(), "input id 42 is already coded");
+    let started = Instant::now();
+    let mask_blocks: Vec<(PairCoding, [Vec<u8>; 2])> = masks
+        .records
+        .par_iter()
+        .map(|record| {
+            let slice = |r: postretro_level_format::lightmap::SectionByteRange| {
+                &shadowmask[r.offset as usize..r.offset as usize + r.len as usize]
+            };
+            code_pair(codec, level, [slice(record.group_a), slice(record.group_b)])
+        })
+        .collect();
+    let new_shadowmask = coded_shadowmask_section_bytes(&masks.owners, &mask_blocks);
+    let shadowmask_secs = started.elapsed().as_secs_f64();
+
+    write_out(
+        &mut file,
+        &meta,
+        output,
+        Some(&new_lightmap),
+        Some(&new_shadowmask),
+        new_id50.as_deref(),
+    );
+    let coded = |coding: &[PairCoding]| {
+        coding
+            .iter()
+            .filter(|c| c.codec != BlockCodec::None)
+            .count()
+    };
+    println!(
+        "id 22: {} -> {} bytes ({:.1}%), {} of {} blocks coded, {lightmap_secs:.1} s",
+        lightmap.len(),
+        new_lightmap.len(),
+        100.0 * new_lightmap.len() as f64 / lightmap.len() as f64,
+        coded(&blocks.iter().map(|b| b.coding).collect::<Vec<_>>()),
+        blocks.len(),
+    );
+    println!(
+        "id 42: {} -> {} bytes ({:.1}%), {} of {} blocks coded, {shadowmask_secs:.1} s",
+        shadowmask.len(),
+        new_shadowmask.len(),
+        100.0 * new_shadowmask.len() as f64 / shadowmask.len() as f64,
+        coded(&mask_blocks.iter().map(|b| b.0).collect::<Vec<_>>()),
+        mask_blocks.len(),
+    );
+    println!(
+        "file: {} -> {} bytes; every other section byte-identical",
+        std::fs::metadata(input).unwrap().len(),
+        std::fs::metadata(output).unwrap().len()
+    );
+}
+
+/// Write the output PRL with replaced sections, then check every other
+/// section came out byte-identical.
+fn write_out(
+    file: &mut File,
+    meta: &postretro_level_format::ContainerMeta,
+    output: &str,
+    lightmap: Option<&[u8]>,
+    shadowmask: Option<&[u8]>,
+    id50: Option<&[u8]>,
+) {
+    let replaced = |id: u32| match id {
+        LIGHTMAP => lightmap,
+        SHADOWMASK => shadowmask,
+        CLUSTER_SH => id50,
+        _ => None,
+    };
+    let descriptors: Vec<SectionDescriptor> = meta
+        .sections
+        .iter()
+        .map(|section| SectionDescriptor {
+            section_id: section.section_id,
+            version: section.version,
+            byte_len: replaced(section.section_id).map_or(section.size, |b| b.len() as u64),
+        })
+        .collect();
+    let mut out = BufWriter::new(File::create(output).unwrap());
+    postretro_level_format::write_prl_header_and_table(&mut out, &descriptors).unwrap();
+    for section in &meta.sections {
+        match replaced(section.section_id) {
+            Some(bytes) => out.write_all(bytes).unwrap(),
+            None => {
+                file.seek(SeekFrom::Start(section.offset)).unwrap();
+                let copied = std::io::copy(&mut (&mut *file).take(section.size), &mut out).unwrap();
+                assert_eq!(copied, section.size);
+            }
+        }
+    }
+    out.flush().unwrap();
+    drop(out);
+
+    let mut written = File::open(output).unwrap();
+    let new_meta = read_container(&mut written).unwrap();
+    for section in &meta.sections {
+        if replaced(section.section_id).is_some() {
+            continue;
+        }
+        let new = new_meta.find_section(section.section_id).unwrap();
+        assert_eq!(new.size, section.size);
+        let a = blake3::hash(&read_at(file, section.offset, section.size));
+        let b = blake3::hash(&read_at(&mut written, new.offset, new.size));
+        assert_eq!(a, b, "section {} changed", section.section_id);
+    }
+    println!(
+        "file: {} bytes; every other section byte-identical",
+        std::fs::metadata(output).unwrap().len()
+    );
+}
diff --git a/crates/level-format/examples/zstd_sweep.rs b/crates/level-format/examples/zstd_sweep.rs
new file mode 100644
index 0000000..93d01da
--- /dev/null
+++ b/crates/level-format/examples/zstd_sweep.rs
@@ -0,0 +1,498 @@
+// SPIKE: zstd level sweep over a raw PRL's streamed and resident payloads.
+// See: context/lib/rendering_pipeline.md §4 (Lightmap cell-block residency,
+// Cluster SH residency)
+//
+//   cargo run -p postretro-level-format --release --example zstd_sweep -- \
+//     <raw.prl> <lightmap|id50|whole> [levels, default 1,3,5,7,9,12,19]
+//
+// - `lightmap`: ids 22/42 per plane, as `transcode_lightmap` codes them. Per
+//   level: the coded file size, 4-thread and 1-thread compression wall time,
+//   and single-thread decode of every coded plane through the production
+//   `decode_plane` (best and median of 3 passes), checked byte-identical.
+// - `id50`: id 50 per chunk, one frame per chunk. Same columns, plus per-chunk
+//   decode p50/p95/max and blake3 cost over the stored and decoded bytes.
+// - `whole`: one frame per section for ids 51, 27, 34, 35, 41, 45, 47, 49
+//   (and 50 as one frame for comparison).
+
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::time::{Duration, Instant};
+
+use postretro_level_format::block_codec::PairCoding;
+use postretro_level_format::block_codec::{BlockCodec, decode_plane, encode_plane};
+use postretro_level_format::cluster_sh_payloads::ClusterShPayloadsSection;
+use postretro_level_format::lightmap::{
+    CodedLightmapBlock, LightmapBlockIndex, coded_lightmap_section_bytes,
+};
+use postretro_level_format::shadowmask_atlas::{
+    ShadowmaskBlockIndex, ShadowmaskOwnerBounds, coded_shadowmask_section_bytes,
+};
+use postretro_level_format::{SectionId, read_container};
+use rayon::prelude::*;
+
+const MIB: f64 = 1024.0 * 1024.0;
+const PASSES: usize = 3;
+
+fn read_at(file: &mut File, offset: u64, len: u64) -> Vec<u8> {
+    let mut out = vec![0; len as usize];
+    file.seek(SeekFrom::Start(offset)).unwrap();
+    file.read_exact(&mut out).unwrap();
+    out
+}
+
+fn pool(threads: usize) -> rayon::ThreadPool {
+    rayon::ThreadPoolBuilder::new()
+        .num_threads(threads)
+        .build()
+        .unwrap()
+}
+
+/// Code every plane at `level` on `threads` threads; a pair stays stored when
+/// coding saves nothing (as `transcode_lightmap` does).
+fn code_planes(
+    planes: &[[&[u8]; 2]],
+    level: i32,
+    threads: usize,
+) -> (Vec<(BlockCodec, [Vec<u8>; 2])>, Duration) {
+    let started = Instant::now();
+    let coded = pool(threads).install(|| {
+        planes
+            .par_iter()
+            .map(|pair| {
+                let coded = pair.map(|p| {
+                    if p.is_empty() {
+                        Vec::new()
+                    } else {
+                        encode_plane(BlockCodec::Zstd, level, p)
+                    }
+                });
+                if coded[0].len() + coded[1].len() < pair[0].len() + pair[1].len() {
+                    (BlockCodec::Zstd, coded)
+                } else {
+                    (BlockCodec::None, pair.map(<[u8]>::to_vec))
+                }
+            })
+            .collect::<Vec<_>>()
+    });
+    (coded, started.elapsed())
+}
+
+fn median(mut v: Vec<f64>) -> f64 {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    v[v.len() / 2]
+}
+
+fn pct(sorted: &[f64], p: f64) -> f64 {
+    sorted[((sorted.len() as f64 - 1.0) * p).round() as usize]
+}
+
+fn parse_levels(arg: Option<&String>) -> Vec<i32> {
+    arg.map_or("1,3,5,7,9,12,19", String::as_str)
+        .split(',')
+        .map(|l| l.parse().unwrap())
+        .collect()
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let path = &args[1];
+    let mode = args[2].as_str();
+    let levels = parse_levels(args.get(3));
+    let mut file = File::open(path).unwrap();
+    let meta = read_container(&mut file).unwrap();
+    let file_len = std::fs::metadata(path).unwrap().len();
+    let section = |file: &mut File, id: SectionId| {
+        let entry = meta
+            .find_section(id as u32)
+            .expect("section present")
+            .clone();
+        read_at(file, entry.offset, entry.size)
+    };
+    println!(
+        "PRL {path}: {file_len} bytes; cores {}",
+        std::thread::available_parallelism().unwrap()
+    );
+    match mode {
+        "lightmap" => lightmap(&mut file, file_len, &levels, &section),
+        "id50" => id50(section(&mut file, SectionId::ClusterShPayloads), &levels),
+        "whole" => whole(&mut file, &levels, &section),
+        "extra" => extra(&mut file, &section),
+        _ => panic!("mode is lightmap, id50 or whole"),
+    }
+}
+
+fn lightmap(
+    file: &mut File,
+    file_len: u64,
+    levels: &[i32],
+    section: &dyn Fn(&mut File, SectionId) -> Vec<u8>,
+) {
+    let lightmap = section(file, SectionId::Lightmap);
+    let shadowmask = section(file, SectionId::ShadowmaskAtlas);
+    let index = LightmapBlockIndex::from_prefix(&lightmap, lightmap.len() as u64).unwrap();
+    assert!(!index.header.coded, "input must be raw");
+    let bounds = ShadowmaskOwnerBounds::from_section_header(&shadowmask).unwrap();
+    let masks =
+        ShadowmaskBlockIndex::from_prefix(&shadowmask, shadowmask.len() as u64, &index, bounds)
+            .unwrap();
+    let slice = |bytes: &'_ [u8], r: postretro_level_format::lightmap::SectionByteRange| {
+        bytes[r.offset as usize..r.offset as usize + r.len as usize].to_vec()
+    };
+    let lm_planes: Vec<[Vec<u8>; 2]> = index
+        .records
+        .iter()
+        .map(|r| {
+            [
+                slice(&lightmap, r.irradiance),
+                slice(&lightmap, r.direction),
+            ]
+        })
+        .collect();
+    let sm_planes: Vec<[Vec<u8>; 2]> = masks
+        .records
+        .iter()
+        .map(|r| [slice(&shadowmask, r.group_a), slice(&shadowmask, r.group_b)])
+        .collect();
+    let lm_refs: Vec<[&[u8]; 2]> = lm_planes.iter().map(|p| [&p[0][..], &p[1][..]]).collect();
+    let sm_refs: Vec<[&[u8]; 2]> = sm_planes.iter().map(|p| [&p[0][..], &p[1][..]]).collect();
+    let raw_out: u64 = lm_planes
+        .iter()
+        .chain(&sm_planes)
+        .map(|p| (p[0].len() + p[1].len()) as u64)
+        .sum();
+    println!(
+        "id 22 {} B ({} blocks), id 42 {} B; plane bytes {:.1} MiB",
+        lightmap.len(),
+        lm_planes.len(),
+        shadowmask.len(),
+        raw_out as f64 / MIB
+    );
+    println!(
+        "level | file B | file % | id22 % | id42 % | compress 4T s | compress 1T s | decode 1T best s | median s | GiB/s (best) | id22-only GiB/s | id42-only GiB/s"
+    );
+    for &level in levels {
+        let (lm_coded, lm_t4) = code_planes(&lm_refs, level, 4);
+        let (sm_coded, sm_t4) = code_planes(&sm_refs, level, 4);
+        let (_, lm_t1) = code_planes(&lm_refs, level, 1);
+        let (_, sm_t1) = code_planes(&sm_refs, level, 1);
+        let blocks: Vec<CodedLightmapBlock> = index
+            .records
+            .iter()
+            .zip(&lm_coded)
+            .zip(&lm_planes)
+            .map(|((record, (codec, coded)), raw)| CodedLightmapBlock {
+                cell_id: record.cell_id,
+                width: record.width,
+                height: record.height,
+                coding: PairCoding {
+                    codec: *codec,
+                    raw_lens: [raw[0].len() as u32, raw[1].len() as u32],
+                },
+                irradiance: coded[0].clone(),
+                direction: coded[1].clone(),
+            })
+            .collect();
+        let new_lm = coded_lightmap_section_bytes(index.header, &blocks).len() as u64;
+        let mask_blocks: Vec<(PairCoding, [Vec<u8>; 2])> = sm_coded
+            .iter()
+            .zip(&sm_planes)
+            .map(|((codec, coded), raw)| {
+                (
+                    PairCoding {
+                        codec: *codec,
+                        raw_lens: [raw[0].len() as u32, raw[1].len() as u32],
+                    },
+                    coded.clone(),
+                )
+            })
+            .collect();
+        let new_sm = coded_shadowmask_section_bytes(&masks.owners, &mask_blocks).len() as u64;
+        let new_file = file_len - lightmap.len() as u64 - shadowmask.len() as u64 + new_lm + new_sm;
+
+        // Single-thread decode through the production plane decoder.
+        let decode_set =
+            |coded: &[(BlockCodec, [Vec<u8>; 2])], raw: &[[Vec<u8>; 2]], check: bool| {
+                let started = Instant::now();
+                let mut out_bytes = 0u64;
+                for ((codec, planes), raw) in coded.iter().zip(raw) {
+                    for k in 0..2 {
+                        let out = decode_plane(*codec, &planes[k], raw[k].len() as u32, &"plane")
+                            .unwrap();
+                        out_bytes += out.len() as u64;
+                        if check {
+                            assert_eq!(out, raw[k], "decode is not byte-identical");
+                        }
+                        std::hint::black_box(&out);
+                    }
+                }
+                (started.elapsed().as_secs_f64(), out_bytes)
+            };
+        decode_set(&lm_coded, &lm_planes, true);
+        decode_set(&sm_coded, &sm_planes, true);
+        let mut both = Vec::new();
+        let mut lm_only = Vec::new();
+        let mut sm_only = Vec::new();
+        for _ in 0..PASSES {
+            let (a, _) = decode_set(&lm_coded, &lm_planes, false);
+            let (b, _) = decode_set(&sm_coded, &sm_planes, false);
+            lm_only.push(a);
+            sm_only.push(b);
+            both.push(a + b);
+        }
+        let best = both.iter().cloned().fold(f64::MAX, f64::min);
+        let lm_bytes: u64 = lm_planes
+            .iter()
+            .map(|p| (p[0].len() + p[1].len()) as u64)
+            .sum();
+        let sm_bytes = raw_out - lm_bytes;
+        let lm_best = lm_only.iter().cloned().fold(f64::MAX, f64::min);
+        let sm_best = sm_only.iter().cloned().fold(f64::MAX, f64::min);
+        println!(
+            "zstd-{level} | {new_file} | {:.1} | {:.1} | {:.2} | {:.2} | {:.2} | {:.3} | {:.3} | {:.2} | {:.2} | {:.2}",
+            100.0 * new_file as f64 / file_len as f64,
+            100.0 * new_lm as f64 / lightmap.len() as f64,
+            100.0 * new_sm as f64 / shadowmask.len() as f64,
+            (lm_t4 + sm_t4).as_secs_f64(),
+            (lm_t1 + sm_t1).as_secs_f64(),
+            best,
+            median(both.clone()),
+            raw_out as f64 / best / 1024.0 / MIB,
+            lm_bytes as f64 / lm_best / 1024.0 / MIB,
+            sm_bytes as f64 / sm_best / 1024.0 / MIB,
+        );
+    }
+}
+
+fn id50(mut bytes: Vec<u8>, levels: &[i32]) {
+    // An epoch-2 section parses as epoch 3: only the epoch words differ.
+    if bytes[0..4] == 2u32.to_le_bytes() {
+        bytes[0..4].copy_from_slice(&3u32.to_le_bytes());
+    }
+    let metadata_len = ClusterShPayloadsSection::metadata_len_from_header(&bytes).unwrap();
+    let section =
+        ClusterShPayloadsSection::from_metadata_bytes(&bytes[..metadata_len], bytes.len() as u64)
+            .unwrap();
+    let payload = &bytes[metadata_len..];
+    let chunks: Vec<&[u8]> = section
+        .index
+        .iter()
+        .map(|e| &payload[e.payload_offset as usize..(e.payload_offset + e.payload_len) as usize])
+        .filter(|c| !c.is_empty())
+        .collect();
+    let raw_total: u64 = chunks.iter().map(|c| c.len() as u64).sum();
+    let mut sizes: Vec<usize> = chunks.iter().map(|c| c.len()).collect();
+    sizes.sort();
+    println!(
+        "id 50: {} B section, {} clusters, {} non-empty chunks, payload {:.1} MiB; chunk KiB p50 {:.1} p95 {:.1} max {:.1}",
+        bytes.len(),
+        section.index.len(),
+        chunks.len(),
+        raw_total as f64 / MIB,
+        sizes[sizes.len() / 2] as f64 / 1024.0,
+        sizes[sizes.len() * 95 / 100] as f64 / 1024.0,
+        *sizes.last().unwrap() as f64 / 1024.0,
+    );
+    // Existing validation cost: blake3 over each raw chunk.
+    let started = Instant::now();
+    for c in &chunks {
+        std::hint::black_box(blake3::hash(c));
+    }
+    let hash_raw = started.elapsed().as_secs_f64();
+    println!(
+        "blake3 over raw chunks (1T): {:.3} s total, {:.2} GiB/s",
+        hash_raw,
+        raw_total as f64 / hash_raw / 1024.0 / MIB
+    );
+    println!(
+        "level | section % | stored MiB | coded chunks | compress 4T s | compress 1T s | decode 1T best s | GiB/s | per-chunk decode ms p50 / p95 / max | blake3(stored) s"
+    );
+    for &level in levels {
+        let refs: Vec<[&[u8]; 2]> = chunks.iter().map(|c| [*c, &[][..]]).collect();
+        let (coded, t4) = code_planes(&refs, level, 4);
+        let (_, t1) = code_planes(&refs, level, 1);
+        let stored: u64 = coded.iter().map(|(_, p)| p[0].len() as u64).sum();
+        let coded_count = coded.iter().filter(|(c, _)| *c == BlockCodec::Zstd).count();
+        let section_len = metadata_len as u64 + stored;
+        let mut passes = Vec::new();
+        let mut per_chunk = vec![0f64; coded.len()];
+        for pass in 0..=PASSES {
+            let started = Instant::now();
+            for (i, ((codec, planes), raw)) in coded.iter().zip(&chunks).enumerate() {
+                let t = Instant::now();
+                let out = decode_plane(*codec, &planes[0], raw.len() as u32, &"chunk").unwrap();
+                let e = t.elapsed().as_secs_f64();
+                if pass == 0 {
+                    assert_eq!(&out[..], *raw, "chunk decode is not byte-identical");
+                } else if pass == 1 || e < per_chunk[i] {
+                    per_chunk[i] = e;
+                }
+                std::hint::black_box(&out);
+            }
+            if pass > 0 {
+                passes.push(started.elapsed().as_secs_f64());
+            }
+        }
+        let started = Instant::now();
+        for (_, planes) in &coded {
+            std::hint::black_box(blake3::hash(&planes[0]));
+        }
+        let hash_stored = started.elapsed().as_secs_f64();
+        let best = passes.iter().cloned().fold(f64::MAX, f64::min);
+        let mut sorted: Vec<f64> = per_chunk.iter().map(|s| s * 1e3).collect();
+        sorted.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        println!(
+            "zstd-{level} | {:.1} | {:.1} | {coded_count}/{} | {:.2} | {:.2} | {:.3} | {:.2} | {:.3} / {:.3} / {:.3} | {:.3}",
+            100.0 * section_len as f64 / bytes.len() as f64,
+            stored as f64 / MIB,
+            coded.len(),
+            t4.as_secs_f64(),
+            t1.as_secs_f64(),
+            best,
+            raw_total as f64 / best / 1024.0 / MIB,
+            pct(&sorted, 0.5),
+            pct(&sorted, 0.95),
+            sorted.last().unwrap(),
+            hash_stored,
+        );
+    }
+}
+
+fn meta_has(file: &mut File, id: SectionId) -> Option<()> {
+    file.seek(SeekFrom::Start(0)).unwrap();
+    let meta = read_container(file).unwrap();
+    meta.find_section(id as u32).map(drop)
+}
+
+fn whole(file: &mut File, levels: &[i32], section: &dyn Fn(&mut File, SectionId) -> Vec<u8>) {
+    let ids = [
+        SectionId::CellResidencySet,
+        SectionId::DeltaShVolumes,
+        SectionId::OctahedralShVolume,
+        SectionId::DirectShVolume,
+        SectionId::DirectShDeltaVolumes,
+        SectionId::AnimatedDirectShDeltaVolumes,
+        SectionId::BillboardDirectScatterVolume,
+        SectionId::ClusterDirectory,
+        SectionId::ClusterShPayloads,
+    ];
+    println!("section | raw MiB | level | stored % | compress 1T s | decode 1T best ms | GiB/s");
+    for id in ids {
+        if meta_has(file, id).is_none() {
+            println!("{} ({id:?}) absent", id as u32);
+            continue;
+        }
+        let raw = section(file, id);
+        for &level in levels {
+            let t = Instant::now();
+            let stored = encode_plane(BlockCodec::Zstd, level, &raw);
+            let ct = t.elapsed().as_secs_f64();
+            let mut best = f64::MAX;
+            for pass in 0..=PASSES {
+                let t = Instant::now();
+                let out =
+                    decode_plane(BlockCodec::Zstd, &stored, raw.len() as u32, &"section").unwrap();
+                let e = t.elapsed().as_secs_f64();
+                if pass == 0 {
+                    assert_eq!(out, raw);
+                } else {
+                    best = best.min(e);
+                }
+            }
+            println!(
+                "{} ({}) | {:.2} | zstd-{level} | {:.2} | {:.3} | {:.1} | {:.2}",
+                id as u32,
+                format!("{id:?}"),
+                raw.len() as f64 / MIB,
+                100.0 * stored.len() as f64 / raw.len() as f64,
+                ct,
+                best * 1e3,
+                raw.len() as f64 / best / 1024.0 / MIB
+            );
+        }
+    }
+}
+
+/// Frame-checksum cost on id-50 chunks and id-22 planes at zstd-3 and 7, and
+/// id 51's parse cost beside its whole-section decode.
+fn extra(file: &mut File, section: &dyn Fn(&mut File, SectionId) -> Vec<u8>) {
+    let mut id50 = section(file, SectionId::ClusterShPayloads);
+    id50[0..4].copy_from_slice(&3u32.to_le_bytes());
+    let metadata_len = ClusterShPayloadsSection::metadata_len_from_header(&id50).unwrap();
+    let parsed =
+        ClusterShPayloadsSection::from_metadata_bytes(&id50[..metadata_len], id50.len() as u64)
+            .unwrap();
+    let payload = &id50[metadata_len..];
+    let chunks: Vec<&[u8]> = parsed
+        .index
+        .iter()
+        .map(|e| &payload[e.payload_offset as usize..(e.payload_offset + e.payload_len) as usize])
+        .filter(|c| !c.is_empty())
+        .collect();
+    let lightmap = section(file, SectionId::Lightmap);
+    let index = LightmapBlockIndex::from_prefix(&lightmap, lightmap.len() as u64).unwrap();
+    let planes: Vec<&[u8]> = index
+        .records
+        .iter()
+        .flat_map(|r| [r.irradiance, r.direction])
+        .map(|r| &lightmap[r.offset as usize..r.offset as usize + r.len as usize])
+        .collect();
+    println!("set | level | checksum | stored MiB | decode 1T best s | GiB/s");
+    for (name, set) in [("id50 chunks", &chunks), ("id22 planes", &planes)] {
+        let raw: u64 = set.iter().map(|c| c.len() as u64).sum();
+        for level in [3, 7] {
+            for checksum in [true, false] {
+                let frames: Vec<Vec<u8>> = pool(4).install(|| {
+                    set.par_iter()
+                        .map(|c| {
+                            let mut z = zstd::bulk::Compressor::new(level).unwrap();
+                            z.include_checksum(checksum).unwrap();
+                            z.include_contentsize(true).unwrap();
+                            z.compress(c).unwrap()
+                        })
+                        .collect()
+                });
+                let mut d = zstd::bulk::Decompressor::new().unwrap();
+                let mut best = f64::MAX;
+                for pass in 0..=PASSES {
+                    let t = Instant::now();
+                    for (f, c) in frames.iter().zip(set.iter()) {
+                        let out = d.decompress(f, c.len()).unwrap();
+                        if pass == 0 {
+                            assert_eq!(&out[..], *c);
+                        }
+                        std::hint::black_box(out);
+                    }
+                    if pass > 0 {
+                        best = best.min(t.elapsed().as_secs_f64());
+                    }
+                }
+                let stored: u64 = frames.iter().map(|f| f.len() as u64).sum();
+                println!(
+                    "{name} | zstd-{level} | {checksum} | {:.2} | {best:.3} | {:.2}",
+                    stored as f64 / MIB,
+                    raw as f64 / best / 1024.0 / MIB
+                );
+            }
+        }
+    }
+    // Id 51: parse beside decode.
+    let id51 = section(file, SectionId::CellResidencySet);
+    let cells = u32::from_le_bytes(id51[4..8].try_into().unwrap()) as usize;
+    let mut parse = f64::MAX;
+    for _ in 0..PASSES {
+        let t = Instant::now();
+        let parsed =
+            postretro_level_format::cell_residency_set::CellResidencySetSection::from_bytes(
+                &id51, cells,
+            )
+            .unwrap();
+        parse = parse.min(t.elapsed().as_secs_f64());
+        std::hint::black_box(parsed);
+    }
+    println!(
+        "id 51: {:.2} MiB, {cells} camera cells, {} entries; from_bytes best {:.1} ms (1T)",
+        id51.len() as f64 / MIB,
+        u32::from_le_bytes(id51[12..16].try_into().unwrap()),
+        parse * 1e3
+    );
+}
diff --git a/crates/level-format/src/block_codec.rs b/crates/level-format/src/block_codec.rs
new file mode 100644
index 0000000..627d4df
--- /dev/null
+++ b/crates/level-format/src/block_codec.rs
@@ -0,0 +1,196 @@
+// SPIKE: per-block lossless codec for streamed lightmap blobs (ids 22 and 42).
+// See: context/lib/rendering_pipeline.md §4 (Lightmap cell-block residency)
+
+use std::cell::RefCell;
+
+use crate::lightmap::invalid;
+
+/// Codec tag stored per block in id-22 v4 and id-42 `SMZ1` records. Every
+/// plane of one block shares it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum BlockCodec {
+    /// Stored as is: stored length equals uncompressed length.
+    #[default]
+    None,
+    /// lz4 block format (no frame, no checksum); the uncompressed length is
+    /// the record's.
+    Lz4,
+    /// One zstd frame per plane, with content size and checksum.
+    Zstd,
+}
+
+impl BlockCodec {
+    pub const fn as_u32(self) -> u32 {
+        match self {
+            Self::None => 0,
+            Self::Lz4 => 1,
+            Self::Zstd => 2,
+        }
+    }
+
+    pub fn from_u32(value: u32) -> Option<Self> {
+        match value {
+            0 => Some(Self::None),
+            1 => Some(Self::Lz4),
+            2 => Some(Self::Zstd),
+            _ => None,
+        }
+    }
+
+    pub const fn name(self) -> &'static str {
+        match self {
+            Self::None => "none",
+            Self::Lz4 => "lz4",
+            Self::Zstd => "zstd",
+        }
+    }
+}
+
+/// One block's coding: its codec, and each of its two planes' uncompressed
+/// lengths (irradiance and direction for id 22; group A and group B for id
+/// 42, 0 for an absent plane). The stored lengths live in the byte ranges.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub struct PairCoding {
+    pub codec: BlockCodec,
+    pub raw_lens: [u32; 2],
+}
+
+thread_local! {
+    static ZSTD: RefCell<Option<zstd::bulk::Decompressor<'static>>> = const { RefCell::new(None) };
+    /// One compression context per thread, rebuilt when the level changes.
+    static ZSTD_ENCODE: RefCell<Option<(i32, zstd::bulk::Compressor<'static>)>> =
+        const { RefCell::new(None) };
+}
+
+/// Decode one stored plane to exactly `raw_len` bytes. `what` names the
+/// plane in the error ("lightmap block 7 irradiance").
+pub fn decode_plane(
+    codec: BlockCodec,
+    stored: &[u8],
+    raw_len: u32,
+    what: &dyn std::fmt::Display,
+) -> crate::Result<Vec<u8>> {
+    let raw_len = raw_len as usize;
+    if raw_len == 0 && stored.is_empty() {
+        // An absent id-42 plane: nothing stored, nothing to decode.
+        return Ok(Vec::new());
+    }
+    let out = match codec {
+        BlockCodec::None => stored.to_vec(),
+        BlockCodec::Lz4 => lz4_flex::block::decompress(stored, raw_len)
+            .map_err(|err| invalid(format!("{what}: lz4 frame rejected: {err}")))?,
+        BlockCodec::Zstd => ZSTD.with(|cell| {
+            let mut cell = cell.borrow_mut();
+            if cell.is_none() {
+                *cell = Some(
+                    zstd::bulk::Decompressor::new()
+                        .map_err(|err| invalid(format!("zstd context: {err}")))?,
+                );
+            }
+            let decompressor = cell.as_mut().expect("set above");
+            let mut out = Vec::with_capacity(raw_len);
+            decompressor
+                .decompress_to_buffer(stored, &mut out)
+                .map_err(|err| invalid(format!("{what}: zstd frame rejected: {err}")))?;
+            Ok::<_, crate::FormatError>(out)
+        })?,
+    };
+    if out.len() != raw_len {
+        return Err(invalid(format!(
+            "{what}: {} frame decoded to {} bytes, record says {raw_len}",
+            codec.name(),
+            out.len()
+        )));
+    }
+    Ok(out)
+}
+
+/// Encode one plane. `level` is zstd's; lz4 ignores it.
+pub fn encode_plane(codec: BlockCodec, level: i32, raw: &[u8]) -> Vec<u8> {
+    match codec {
+        BlockCodec::None => raw.to_vec(),
+        BlockCodec::Lz4 => lz4_flex::block::compress(raw),
+        BlockCodec::Zstd => ZSTD_ENCODE.with(|cell| {
+            let mut cell = cell.borrow_mut();
+            if cell.as_ref().is_none_or(|(cached, _)| *cached != level) {
+                let mut compressor = zstd::bulk::Compressor::new(level).expect("zstd level");
+                compressor.include_checksum(true).expect("zstd checksum");
+                compressor.include_contentsize(true).expect("zstd size");
+                *cell = Some((level, compressor));
+            }
+            let (_, compressor) = cell.as_mut().expect("set above");
+            compressor.compress(raw).expect("zstd compress")
+        }),
+    }
+}

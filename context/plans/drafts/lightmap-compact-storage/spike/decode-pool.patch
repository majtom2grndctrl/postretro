+    let metadata_len = coded.header.metadata_len().unwrap();
+    let parsed = ClusterShPayloadsSection::from_metadata_bytes(
+        &encoded[..metadata_len],
+        encoded.len() as u64,
+    )
+    .unwrap();
+    assert_eq!(parsed, coded);
+    let validated = parsed
+        .into_validated(inputs(&directory, base, &sources))
+        .unwrap();
+    let decoded = validated.decode_chunk(0, payload).unwrap();
+    assert_eq!(decoded.bytes, chunk);
+    assert_eq!(decoded.blocks.len(), 3);

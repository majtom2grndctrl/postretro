+/// The largest lightmap block area of any camera cell's set over the worst
+/// lightmap layer count: how full the shelf packing of the worst set is.
+fn worst_set_fill(
+    cameras: &[u32],
+    input: &BoundCellInput<'_>,
+    blocks: &CellBlocks,
+    demand: &PoolDemand,
+    worst_layers: u32,
+) -> anyhow::Result<f64> {
+    let mut set = Vec::new();
+    let mut ids = Vec::new();
+    let mut best = 0u64;
+    let mut scratch = PackScratch::default();
+    let mut seen: HashMap<Box<[u32]>, ()> = HashMap::new();
+    for &cell in cameras {
+        set.clear();
+        input.cells_of(cell, &mut set);
+        blocks.collect(&set, &mut ids)?;
+        if seen.insert(ids.as_slice().into(), ()).is_some() {
+            continue;
+        }
+        let layers = layers_of(demand, &ids, &mut scratch)?;
+        if layers.lightmap == worst_layers {
+            let area: u64 = ids
+                .iter()
+                .map(|&b| {
+                    let (w, h) = demand.extents()[b as usize];
+                    u64::from(w) * u64::from(h)
+                })
+                .sum();
+            best = best.max(area);
+        }
+    }
+    let layer = u64::from(LIGHTMAP_POOL_LAYER_EDGE) * u64::from(LIGHTMAP_POOL_LAYER_EDGE);
+    Ok(best as f64 / (u64::from(worst_layers) * layer) as f64)
+}
+
+/// The worst distinct sets under the shelf, re-placed by MaxRects layers and
+/// by the area lower bound, to price the pool placement lever.
+fn pool_alternatives(
+    cameras: &[u32],
+    input: &BoundCellInput<'_>,
+    blocks: &CellBlocks,
+    demand: &PoolDemand,
+    shelf_worst: PerPool<u32>,
+) -> anyhow::Result<()> {
+    let mut set = Vec::new();
+    let mut ids = Vec::new();
+    let mut scratch = PackScratch::default();
+    let mut sets: HashMap<Box<[u32]>, PerPool<u32>> = HashMap::new();
+    for &cell in cameras {
+        set.clear();
+        input.cells_of(cell, &mut set);
+        blocks.collect(&set, &mut ids)?;
+        if sets.contains_key(ids.as_slice()) {
+            continue;
+        }
+        let layers = layers_of(demand, &ids, &mut scratch)?;
+        sets.insert(ids.as_slice().into(), layers);
+    }
+    let layer = u64::from(LIGHTMAP_POOL_LAYER_EDGE) * u64::from(LIGHTMAP_POOL_LAYER_EDGE);
+    let align = demand.alignment();
+    let up = |v: u32| v.div_ceil(align) * align;
+    // Lower bound on every set: area / layer, over all sets.
+    let mut lb = PerPool::<u32>::default();
+    for ids in sets.keys() {
+        let mut area = PerPool::<u64>::default();
+        for &b in ids.iter() {
+            let (w, h) = demand.extents()[b as usize];
+            let a = u64::from(up(w)) * u64::from(up(h));
+            area.lightmap += a;
+            area.mask += a * demand.planes(b).iter().filter(|&&p| p).count() as u64;
+        }
+        lb.lightmap = lb.lightmap.max(area.lightmap.div_ceil(layer) as u32);
+        lb.mask = lb.mask.max(area.mask.div_ceil(layer) as u32);
+    }
+    // MaxRects on the sets within 3 layers of the shelf worst, per pool.
+    let mut candidates: Vec<(&Box<[u32]>, &PerPool<u32>)> = sets
+        .iter()
+        .filter(|(_, l)| l.lightmap + 3 >= shelf_worst.lightmap || l.mask + 3 >= shelf_worst.mask)
+        .collect();
+    candidates.sort_by_key(|(ids, _)| ids.to_vec());
+    let results: Vec<(PerPool<u32>, PerPool<u32>)> = candidates
+        .par_iter()
+        .map(|(ids, shelf)| {
+            let lm: Vec<(u32, u32)> = ids
+                .iter()
+                .map(|&b| {
+                    let (w, h) = demand.extents()[b as usize];
+                    (up(w), up(h))
+                })
+                .collect();
+            let mk: Vec<(u32, u32)> = ids
+                .iter()
+                .flat_map(|&b| {
+                    let (w, h) = demand.extents()[b as usize];
+                    let n = demand.planes(b).iter().filter(|&&p| p).count();
+                    std::iter::repeat_n((up(w), up(h)), n)
+                })
+                .collect();
+            let mr = PerPool {
+                lightmap: maxrects_layers(&lm, LIGHTMAP_POOL_LAYER_EDGE, Heuristic::Bssf),
+                mask: maxrects_layers(&mk, LIGHTMAP_POOL_LAYER_EDGE, Heuristic::Bssf),
+            };
+            (**shelf, mr)
+        })
+        .collect();
+    let mut mr_worst = PerPool::<u32>::default();
+    for (_, mr) in &results {
+        mr_worst.lightmap = mr_worst.lightmap.max(mr.lightmap);
+        mr_worst.mask = mr_worst.mask.max(mr.mask);
+    }
+    println!(
+        "#   pool placement: shelf {}/{}; maxrects-bssf (over {} near-worst sets) {}/{}; area lower bound {}/{} ({} distinct sets)",
+        shelf_worst.lightmap,
+        shelf_worst.mask,
+        results.len(),
+        mr_worst.lightmap,
+        mr_worst.mask,
+        lb.lightmap,
+        lb.mask,
+        sets.len()
+    );
+    Ok(())
+}
+
+/// The bound with each present plane placed at its block's owned sub-rect
+/// instead of the whole block, through the runtime's own placement.
+fn subrect_bound(
+    cameras: &[u32],
+    input: &BoundCellInput<'_>,
+    blocks: &CellBlocks,
+    packed: &Packed,
+    sub_extents: &[(u32, u32)],
+    label: &str,
+    align: u32,
+) -> anyhow::Result<()> {
+    use postretro_level_format::lightmap_pool::place_all_resident;
+    let edge = LIGHTMAP_POOL_LAYER_EDGE;
+    let mut set = Vec::new();
+    let mut ids = Vec::new();
+    let mut seen: HashMap<Box<[u32]>, ()> = HashMap::new();
+    let mut worst = PerPool::<u32>::default();
+    let mut mask_items = Vec::new();
+    for &cell in cameras {
+        set.clear();
+        input.cells_of(cell, &mut set);
+        blocks.collect(&set, &mut ids)?;
+        if seen.insert(ids.as_slice().into(), ()).is_some() {
+            continue;
+        }
+        mask_items.clear();
+        for &b in &ids {
+            let n = packed.planes[b as usize].iter().filter(|&&p| p).count();
+            let e = sub_extents[b as usize];
+            if n > 0 {
+                anyhow::ensure!(
+                    e.0 > 0 && e.1 > 0,
+                    "block {b} has a plane but no owned chart"
+                );
+            }
+            mask_items.extend(std::iter::repeat_n(e, n));
+        }
+        let mk = place_all_resident(&mask_items, align, edge)
+            .ok_or_else(|| anyhow::anyhow!("mask item past a layer"))?
+            .layer_count;
+        worst.mask = worst.mask.max(mk);
+    }
+    let all_items: Vec<(u32, u32)> = (0..packed.extents.len())
+        .flat_map(|b| {
+            let n = packed.planes[b].iter().filter(|&&p| p).count();
+            std::iter::repeat_n(sub_extents[b], n)
+        })
+        .collect();
+    let all_mask = place_all_resident(&all_items, align, edge)
+        .unwrap()
+        .layer_count;
+    let mask_gen = first_generation_layers(worst.mask, all_mask);
+    let full_area: u64 = (0..packed.extents.len())
+        .map(|b| {
+            let n = packed.planes[b].iter().filter(|&&p| p).count() as u64;
+            n * u64::from(packed.extents[b].0) * u64::from(packed.extents[b].1)
+        })
+        .sum();
+    let sub_area: u64 = all_items
+        .iter()
+        .map(|&(w, h)| u64::from(w) * u64::from(h))
+        .sum();
+    println!(
+        "#   {label}: mask worst {} gen {} ({:.1} MiB), all-resident {}; plane texels {:.1}M -> {:.1}M",
+        worst.mask,
+        mask_gen,
+        streamed_pool_bytes(mask_gen, MASK_POOL_LAYER_BYTES) as f64 / MIB,
+        all_mask,
+        full_area as f64 / 1e6,
+        sub_area as f64 / 1e6,
+    );
+    Ok(())
+}
+
+/// SPIKE (separate mask layout): the mask bound with each block's planes
+/// placed at its own tightly packed owned-chart mask block; plane B at its
+/// owned-first sub-rect when `b_sub`.
+#[allow(clippy::too_many_arguments)]
+fn sep_mask_bound(
+    cameras: &[u32],
+    input: &BoundCellInput<'_>,
+    blocks: &CellBlocks,
+    packed: &Packed,
+    sep: &[((u32, u32), (u32, u32))],
+    b_sub: bool,
+    lm_gen: u32,
+    lm_mib: f64,
+) -> anyhow::Result<()> {
+    use postretro_level_format::lightmap_pool::place_all_resident;
+    let edge = LIGHTMAP_POOL_LAYER_EDGE;
+    let items_of = |b: usize, out: &mut Vec<(u32, u32)>| {
+        let (whole, bsub) = sep[b];
+        let p = packed.planes[b];
+        if p[0] {
+            out.push(whole);
+        }
+        if p[1] {
+            out.push(if b_sub { bsub } else { whole });
+        }
+    };
+    let mut set = Vec::new();
+    let mut ids = Vec::new();
+    let mut seen: HashMap<Box<[u32]>, ()> = HashMap::new();
+    let mut worst = 0u32;
+    let mut worst_area = 0u64;
+    let mut items = Vec::new();
+    for &cell in cameras {
+        set.clear();
+        input.cells_of(cell, &mut set);
+        blocks.collect(&set, &mut ids)?;
+        if seen.insert(ids.as_slice().into(), ()).is_some() {
+            continue;
+        }
+        items.clear();
+        for &b in &ids {
+            items_of(b as usize, &mut items);
+        }
+        for &(w, h) in &items {
+            anyhow::ensure!(w > 0 && h > 0, "a present plane with an empty mask block");
+        }
+        let mk = place_all_resident(&items, 4, edge)
+            .ok_or_else(|| anyhow::anyhow!("mask item past a layer"))?
+            .layer_count;
+        worst = worst.max(mk);
+        worst_area = worst_area.max(items.iter().map(|&(w, h)| u64::from(w) * u64::from(h)).sum());
+    }
+    let mut all_items = Vec::new();
+    for b in 0..packed.extents.len() {
+        items_of(b, &mut all_items);
+    }
+    let all_mask = place_all_resident(&all_items, 4, edge).unwrap().layer_count;
+    let mask_gen = first_generation_layers(worst, all_mask);
+    let mask_mib = streamed_pool_bytes(mask_gen, MASK_POOL_LAYER_BYTES) as f64 / MIB;
+    let area: u64 = all_items.iter().map(|&(w, h)| u64::from(w) * u64::from(h)).sum();
+    let blocks_with = sep.iter().filter(|(w, _)| w.0 > 0).count();
+    println!(
+        "#   separate mask layout ({}): mask worst {worst} gen {mask_gen} ({mask_mib:.1} MiB), all-resident {all_mask}; plane texels {:.1}M; worst-set plane area {:.2} layers; mask blocks {blocks_with}; lightmap gen {lm_gen} ({lm_mib:.1} MiB); pool total {:.1} MiB",
+        if b_sub { "plane B at its sub-rect" } else { "plane B at the whole mask block" },
+        area as f64 / 1e6,
+        worst_area as f64 / (f64::from(edge) * f64::from(edge)),
+        lm_mib + mask_mib,
+    );
+    Ok(())
+}
+
+/// One block's texels, decoded for comparison.
+struct DecodedBlock {
+    w: u32,
+    /// RGBA16F bits when the level stores raw irradiance.
+    irr_bits: Option<Vec<[u16; 4]>>,
+    irr: Vec<[f32; 3]>,
+    dir: Vec<u8>,
+    planes: [Option<Vec<u8>>; 2],
+}
+
+fn decode_block(prl: &Prl, block: u32) -> DecodedBlock {
+    use postretro_level_format::lightmap::IRRADIANCE_FORMAT_RGBA16F;
+    let b = &prl.lightmap.blocks[block as usize];
+    let (w, h) = (u32::from(b.width), u32::from(b.height));
+    let (irr_bits, irr) = if prl.lightmap.irradiance_format == IRRADIANCE_FORMAT_RGBA16F {
+        let bits: Vec<[u16; 4]> = b
+            .irradiance
+            .chunks_exact(8)
+            .map(|c| std::array::from_fn(|k| u16::from_le_bytes([c[2 * k], c[2 * k + 1]])))
+            .collect();
+        let f = bits
+            .iter()
+            .map(|t| std::array::from_fn(|k| crate::bc6h::f16_bits_to_f32(t[k])))
+            .collect();
+        (Some(bits), f)
+    } else {
+        let rgba = crate::bc6h::decode_bc6h_rgb_to_f32_rgba(&b.irradiance, w, h).expect("bc6h");
+        (
+            None,
+            rgba.chunks_exact(4).map(|c| [c[0], c[1], c[2]]).collect(),
+        )
+    };
+    let planes = std::array::from_fn(|g| {
+        prl.shadowmask.as_ref().and_then(|m| {
+            let p = &m.blocks[block as usize][g];
+            (!p.is_empty()).then(|| crate::bc5::decode_bc5_rg(p, w, h))
+        })
+    });
+    DecodedBlock {
+        w,
+        irr_bits,
+        irr,
+        dir: b.direction.clone(),
+        planes,
+    }
+}
+
+#[derive(Default, Clone)]
+struct Tally {
+    /// [ring 0 interior, ring 1, ring 2]: compared, differing.
+    compared: [u64; 3],
+    differing: [u64; 3],
+    max_delta: [f64; 3],
+    sum_delta: [f64; 3],
+}
+
+impl Tally {
+    fn add(&mut self, ring: usize, delta: f64) {
+        self.compared[ring] += 1;
+        if delta != 0.0 {
+            self.differing[ring] += 1;
+        }
+        self.max_delta[ring] = self.max_delta[ring].max(delta);
+        self.sum_delta[ring] += delta;
+    }
+    fn merge(&mut self, o: &Tally) {
+        for r in 0..3 {
+            self.compared[r] += o.compared[r];
+            self.differing[r] += o.differing[r];
+            self.max_delta[r] = self.max_delta[r].max(o.max_delta[r]);
+            self.sum_delta[r] += o.sum_delta[r];
+        }
+    }
+    fn line(&self, name: &str) -> String {
+        let mut out = format!("{name:<28}");
+        for r in 0..3 {
+            out += &format!(
+                " | ring{r}: {} of {} differ, max {:.4e}, mean {:.4e}",
+                self.differing[r],
+                self.compared[r],
+                self.max_delta[r],
+                self.sum_delta[r] / self.compared[r].max(1) as f64
+            );
+        }
+        out
+    }
+}
+
+const TALLIES: [&str; 11] = [
+    "irradiance bits (RGBA16F)",
+    "irradiance R",
+    "irradiance G",
+    "irradiance B",
+    "direction (parity kept)",
+    "direction (parity moved)",
+    "mask A.r",
+    "mask A.g",
+    "mask B.r",
+    "mask B.g",
+    "faces moved parity",
+];
+
+/// `prl-build --spike-compare <a.tsv> <a.prl> <b.tsv> <b.prl>`: map each
+/// face's chart texels across two layouts and compare what each stores.
+pub(crate) fn run_compare(args: &[String]) -> anyhow::Result<()> {
+    let rows_a = read_charts(&args[0])?;
+    let rows_b = read_charts(&args[2])?;
+    let prl_a = read_prl(&args[1], true)?;
+    let prl_b = read_prl(&args[3], true)?;
+    anyhow::ensure!(rows_a.len() == rows_b.len(), "chart counts differ");
+    for (a, b) in rows_a.iter().zip(&rows_b) {
+        let same = if a.rotated == b.rotated {
+            (a.w, a.h) == (b.w, b.h)
+        } else {
+            (a.w, a.h) == (b.h, b.w)
+        };
+        anyhow::ensure!(
+            a.face == b.face && a.cell == b.cell && same,
+            "chart {} differs between dumps",
+            a.face
+        );
+    }
+    let scale = prl_a.lightmap.direction_texel_scale;
+    anyhow::ensure!(scale == prl_b.lightmap.direction_texel_scale);
+    let mut by_cell: BTreeMap<u32, Vec<usize>> = BTreeMap::new();
+    for (i, r) in rows_a.iter().enumerate() {
+        by_cell.entry(r.cell).or_default().push(i);
+    }
+    let cells: Vec<Vec<usize>> = by_cell.into_values().collect();
+    let samples = std::sync::Mutex::new(Vec::<String>::new());
+    // Mask texel diffs on unturned charts: [phase mod 4 kept?][depth from the
+    // padded rect's edge, 0..=4+].
+    let mask_depth = std::sync::Mutex::new([[0u64; 6]; 2]);
+    let tallies: Vec<Tally> = cells
+        .par_iter()
+        .map(|members| {
+            let mut tt = vec![Tally::default(); 2 * TALLIES.len()];
+            let mut cache_a: BTreeMap<u32, DecodedBlock> = BTreeMap::new();
+            let mut cache_b: BTreeMap<u32, DecodedBlock> = BTreeMap::new();
+            for &i in members {
+                let (ra, rb) = (rows_a[i], rows_b[i]);
+                cache_a.entry(ra.block).or_insert_with(|| decode_block(&prl_a, ra.block));
+                cache_b.entry(rb.block).or_insert_with(|| decode_block(&prl_b, rb.block));
+                let (da, db) = (&cache_a[&ra.block], &cache_b[&rb.block]);
+                let turned = ra.rotated != rb.rotated;
+                let t = &mut tt[if turned { TALLIES.len() } else { 0 }..][..TALLIES.len()];
+                let parity_kept = !turned && ra.lx % scale == rb.lx % scale && ra.ly % scale == rb.ly % scale;
+                t[10].add(0, f64::from(u8::from(!parity_kept)));
+                let pad = crate::chart_raster::CHART_PADDING_TEXELS;
+                for y in 0..ra.h {
+                    for x in 0..ra.w {
+                        let ring = |v: u32, n: u32| {
+                            if v < pad {
+                                pad - v
+                            } else if v >= n - pad {
+                                v - (n - pad) + 1
+                            } else {
+                                0
+                            }
+                        };
+                        let r = ring(x, ra.w).max(ring(y, ra.h)) as usize;
+                        // B's texel for A's padded (x, y): a quarter turn maps
+                        // it to (y, w - 1 - x) of B's padded grid.
+                        let (bx, by) = if turned { (y, ra.w - 1 - x) } else { (x, y) };
+                        let ia = ((ra.ly + y) * da.w + ra.lx + x) as usize;
+                        let ib = ((rb.ly + by) * db.w + rb.lx + bx) as usize;
+                        if let (Some(a), Some(b)) = (&da.irr_bits, &db.irr_bits) {
+                            t[0].add(r, f64::from(u8::from(a[ia] != b[ib])));
+                            if a[ia] != b[ib] {
+                                let mut s = samples.lock().unwrap();
+                                if s.len() < 40 {
+                                    s.push(format!("irr face {} texel ({x},{y}) ring {r}: {:?} vs {:?}", ra.face, a[ia], b[ib]));
+                                }
+                            }
+                        }
+                        for c in 0..3 {
+                            t[1 + c].add(r, f64::from((da.irr[ia][c] - db.irr[ib][c]).abs()));
+                        }
+                        let dw_a = da.w / scale;
+                        let dw_b = db.w / scale;
+                        let ja = (((ra.ly + y) / scale) * dw_a + (ra.lx + x) / scale) as usize * 2;
+                        let jb = (((rb.ly + by) / scale) * dw_b + (rb.lx + bx) / scale) as usize * 2;
+                        let dd = f64::from(
+                            (i16::from(da.dir[ja]) - i16::from(db.dir[jb])).abs()
+                                .max((i16::from(da.dir[ja + 1]) - i16::from(db.dir[jb + 1])).abs()),
+                        );
+                        t[if parity_kept { 4 } else { 5 }].add(r, dd);
+                        if parity_kept && dd != 0.0 {
+                            let mut s = samples.lock().unwrap();
+                            if s.len() < 80 {
+                                s.push(format!("dir face {} texel ({x},{y}) ring {r}: {:?} vs {:?}", ra.face, &da.dir[ja..ja + 2], &db.dir[jb..jb + 2]));
+                            }
+                        }
+                        for g in 0..2 {
+                            for c in 0..2 {
+                                let va = da.planes[g].as_ref().map_or(0, |p| p[ia * 2 + c]);
+                                let vb = db.planes[g].as_ref().map_or(0, |p| p[ib * 2 + c]);
+                                let d = f64::from((i16::from(va) - i16::from(vb)).abs());
+                                t[6 + g * 2 + c].add(r, d);
+                                if d != 0.0 && !turned {
+                                    let kept = usize::from(ra.lx % 4 == rb.lx % 4 && ra.ly % 4 == rb.ly % 4);
+                                    let depth = x.min(y).min(ra.w - 1 - x).min(ra.h - 1 - y).min(5) as usize;
+                                    mask_depth.lock().unwrap()[kept][depth] += 1;
+                                }
+                                if d != 0.0 && r <= 1 {
+                                    let mut s = samples.lock().unwrap();
+                                    if s.len() < 120 {
+                                        s.push(format!("mask{g}.{c} face {} texel ({x},{y}) ring {r}: {va} vs {vb} (A at {},{} B at {},{})", ra.face, ra.lx, ra.ly, rb.lx, rb.ly));
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+            tt
+        })
+        .reduce(
+            || vec![Tally::default(); 2 * TALLIES.len()],
+            |mut a, b| {
+                for (x, y) in a.iter_mut().zip(&b) {
+                    x.merge(y);
+                }
+                a
+            },
+        );
+    println!(
+        "faces {}; ring 0 = chart interior rect, rings 1-2 = padding",
+        rows_a.len()
+    );
+    for (half, label) in [
+        "charts in the same orientation",
+        "charts turned a quarter turn",
+    ]
+    .iter()
+    .enumerate()
+    {
+        println!("== {label}");
+        for (name, t) in TALLIES.iter().zip(&tallies[half * TALLIES.len()..]) {
+            println!("{}", t.line(name));
+        }
+    }
+    let md = mask_depth.into_inner().unwrap();
+    println!(
+        "mask texel diffs (unturned charts) by depth from padded edge 0,1,2,3,4,5+: phase mod 4 moved {:?}; phase kept {:?}",
+        md[0], md[1]
+    );
+    for s in samples.into_inner().unwrap() {
+        println!("  {s}");
+    }
+    Ok(())
+}

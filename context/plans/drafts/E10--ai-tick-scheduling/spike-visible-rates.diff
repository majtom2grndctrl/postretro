+    /// Sorted, deduplicated candidates from the cells within `k` of the cell
+    /// holding the point. `None` when the point is non-finite.
+    fn gather(&self, grid: &NavGrid, p: Vec3, k: i64, out: &mut Vec<u32>) -> bool {
+        out.clear();
+        if !p.x.is_finite() || !p.z.is_finite() {
+            return false;
+        }
+        let fx = ((p.x - grid.origin[0]) / grid.cell_size).floor();
+        let fz = ((p.z - grid.origin[2]) / grid.cell_size).floor();
+        if fx.abs() > 1.0e9 || fz.abs() > 1.0e9 {
+            return false;
+        }
+        let (cx, cz) = (fx as i64 - self.x0, fz as i64 - self.z0);
+        let (ax, bx) = ((cx - k).max(0), (cx + k).min(self.w - 1));
+        let (az, bz) = ((cz - k).max(0), (cz + k).min(self.h - 1));
+        if ax > bx || az > bz {
+            return true;
+        }
+        for z in az..=bz {
+            for x in ax..=bx {
+                let c = (z * self.w + x) as usize;
+                out.extend_from_slice(&self.items[self.starts[c] as usize..self.starts[c + 1] as usize]);
+            }
+        }
+        out.sort_unstable();
+        out.dedup();
+        true
+    }
+}

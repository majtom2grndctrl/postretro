diff --git a/crates/level-compiler/src/lightmap_bake/spike_pack.rs b/crates/level-compiler/src/lightmap_bake/spike_pack.rs
new file mode 100644
index 0000000..bdde83c
--- /dev/null
+++ b/crates/level-compiler/src/lightmap_bake/spike_pack.rs
@@ -0,0 +1,879 @@
+// SPIKE (packing): configurable deterministic per-cell chart packer for measuring tighter lightmap blocks.
+// See: context/lib/build_pipeline.md §Compiler pipeline (atlas preparation)
+//
+// Every variant is a pure function of the cell's chart extents and its
+// configuration: fixed candidate lists, fixed tie-breaks, no hashing.
+
+use super::cell_blocks::{CellSubBlock, PackedBlock, pack_cell_sub_blocks};
+use crate::chart_raster::ChartPlacement;
+
+/// Per texel of bake layer `layer`, whether it lies in a transposed
+/// placement's padded footprint; `None` when the layer holds none.
+pub(crate) fn turned_mask(
+    charts: &[super::Chart],
+    placements: &[ChartPlacement],
+    layer: u32,
+    width: u32,
+    height: u32,
+) -> Option<Vec<bool>> {
+    let mut mask: Option<Vec<bool>> = None;
+    for (chart, placement) in charts.iter().zip(placements) {
+        if placement.layer != layer || !placement.transposed {
+            continue;
+        }
+        let mask = mask.get_or_insert_with(|| vec![false; width as usize * height as usize]);
+        let (w, h) = placement.extent(chart);
+        for y in placement.y..placement.y + h {
+            let row = y as usize * width as usize;
+            mask[row + placement.x as usize..row + (placement.x + w) as usize].fill(true);
+        }
+    }
+    mask
+}
+
+/// Free-rectangle choice rule for MaxRects.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Heuristic {
+    /// Best short side fit (HEAD).
+    Bssf,
+    /// Best long side fit.
+    Blsf,
+    /// Best area fit.
+    Baf,
+    /// Bottom-left: lowest top edge, then leftmost.
+    BottomLeft,
+    /// Most perimeter touching the bin edge or placed rects.
+    ContactPoint,
+}
+
+/// Chart insertion order, descending, ties by input index.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum SortKey {
+    Area,
+    MaxSide,
+    Height,
+    Width,
+    Perimeter,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct PackConfig {
+    /// Exactly HEAD's packer; every other field is ignored.
+    pub head: bool,
+    pub heuristics: Vec<Heuristic>,
+    pub sorts: Vec<SortKey>,
+    /// 0: HEAD's eight width factors. n > 0: those plus n widths evenly
+    /// spaced on the alignment grid from the widest chart to `2·sqrt(area)`.
+    pub dense_widths: u32,
+    /// Chart origins and footprints are multiples of this (1, 2 or 4).
+    pub chart_align: u32,
+    /// Allow a chart to be stored transposed (its footprint's sides swap).
+    /// The bake keys every texel on the chart's canonical frame, so a
+    /// transposed chart stores the same values, transposed.
+    pub rotate: bool,
+    /// Pack charts the pre-pack owner estimate marks first, into a top-left
+    /// sub-rect of each block, so a mask plane needs only that sub-rect.
+    pub owned_first: bool,
+}
+
+impl PackConfig {
+    pub(crate) fn head() -> Self {
+        Self {
+            head: true,
+            heuristics: vec![Heuristic::Bssf],
+            sorts: vec![SortKey::Area],
+            dense_widths: 0,
+            chart_align: 1,
+            rotate: false,
+            owned_first: false,
+        }
+    }
+
+    /// Parse `head` or `h=bssf+cp,s=area+maxside,w=24,a=1,r=0`.
+    pub(crate) fn parse(spec: &str) -> Result<Self, String> {
+        if spec.trim() == "head" {
+            return Ok(Self::head());
+        }
+        let mut cfg = Self {
+            head: false,
+            heuristics: vec![Heuristic::Bssf],
+            sorts: vec![SortKey::Area],
+            dense_widths: 0,
+            chart_align: 1,
+            rotate: false,
+            owned_first: false,
+        };
+        for part in spec.split(',').filter(|p| !p.is_empty()) {
+            let (key, value) = part
+                .split_once('=')
+                .ok_or_else(|| format!("bad spec part {part:?}"))?;
+            match key {
+                "h" => {
+                    cfg.heuristics = value
+                        .split('+')
+                        .map(|h| match h {
+                            "bssf" => Ok(Heuristic::Bssf),
+                            "blsf" => Ok(Heuristic::Blsf),
+                            "baf" => Ok(Heuristic::Baf),
+                            "bl" => Ok(Heuristic::BottomLeft),
+                            "cp" => Ok(Heuristic::ContactPoint),
+                            other => Err(format!("unknown heuristic {other}")),
+                        })
+                        .collect::<Result<_, _>>()?
+                }
+                "s" => {
+                    cfg.sorts = value
+                        .split('+')
+                        .map(|s| match s {
+                            "area" => Ok(SortKey::Area),
+                            "maxside" => Ok(SortKey::MaxSide),
+                            "h" => Ok(SortKey::Height),
+                            "w" => Ok(SortKey::Width),
+                            "perim" => Ok(SortKey::Perimeter),
+                            other => Err(format!("unknown sort {other}")),
+                        })
+                        .collect::<Result<_, _>>()?
+                }
+                "w" => cfg.dense_widths = value.parse().map_err(|e| format!("{e}"))?,
+                "a" => cfg.chart_align = value.parse().map_err(|e| format!("{e}"))?,
+                "r" => cfg.rotate = value == "1",
+                "o" => cfg.owned_first = value == "1",
+                other => return Err(format!("unknown key {other}")),
+            }
+        }
+        if ![1, 2, 4].contains(&cfg.chart_align) {
+            return Err("chart_align must be 1, 2 or 4".into());
+        }
+        Ok(cfg)
+    }
+
+    /// The production packer: `POSTRETRO_SPIKE_PACKER` when set, else the
+    /// spike's chosen default.
+    pub(crate) fn from_env() -> Self {
+        match std::env::var("POSTRETRO_SPIKE_PACKER") {
+            Ok(spec) => {
+                Self::parse(&spec).unwrap_or_else(|e| panic!("POSTRETRO_SPIKE_PACKER: {e}"))
+            }
+            Err(_) => Self::parse(DEFAULT_SPEC).expect("default spec parses"),
+        }
+    }
+}
+
+/// The spike's chosen production packer.
+pub(crate) const DEFAULT_SPEC: &str = "h=bssf+bl+cp+baf,s=area+maxside+h+w,w=24,a=2,r=1,o=1";
+
+/// The last pack's per-block estimated-owner sub-rect, from the block origin,
+/// in block order; for the spike's chart dump only.
+pub(crate) static LAST_OWNED_RECTS: std::sync::Mutex<Vec<(u32, u32)>> =
+    std::sync::Mutex::new(Vec::new());
+
+/// A packed block plus which members were rotated (all false unless `rotate`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct SpikeSubBlock {
+    pub sub: CellSubBlock,
+    pub rotated: Vec<bool>,
+    /// Aligned bounding box, from the block origin, of its owned members;
+    /// (0, 0) when none is owned.
+    pub mask_extent: (u32, u32),
+}
+
+/// Fill each sub-block's owned bounding box.
+fn with_mask_extents(
+    mut blocks: Vec<SpikeSubBlock>,
+    charts: &[(u32, u32)],
+    owned: &[bool],
+    align: u32,
+) -> Vec<SpikeSubBlock> {
+    let up = |v: u32| v.div_ceil(align) * align;
+    for b in &mut blocks {
+        let (mut w, mut h) = (0, 0);
+        for ((&m, &(x, y)), &r) in b
+            .sub
+            .members
+            .iter()
+            .zip(&b.sub.block.placements)
+            .zip(&b.rotated)
+        {
+            if owned.get(m).copied().unwrap_or(false) {
+                let (cw, ch) = if r {
+                    (charts[m].1, charts[m].0)
+                } else {
+                    charts[m]
+                };
+                w = w.max(x + cw);
+                h = h.max(y + ch);
+            }
+        }
+        b.mask_extent = (up(w).min(b.sub.block.width), up(h).min(b.sub.block.height));
+    }
+    blocks
+}
+
+/// Pack one cell's padded chart extents under `cfg`, mirroring
+/// [`pack_cell_sub_blocks`]'s multi-block contract.
+pub(crate) fn pack_cell_sub_blocks_cfg(
+    charts: &[(u32, u32)],
+    align: u32,
+    pool_edge: u32,
+    cfg: &PackConfig,
+    owned: &[bool],
+) -> Vec<SpikeSubBlock> {
+    let blocks = pack_cell_sub_blocks_inner(charts, align, pool_edge, cfg, owned);
+    with_mask_extents(blocks, charts, owned, align)
+}
+
+fn pack_cell_sub_blocks_inner(
+    charts: &[(u32, u32)],
+    align: u32,
+    pool_edge: u32,
+    cfg: &PackConfig,
+    owned: &[bool],
+) -> Vec<SpikeSubBlock> {
+    if cfg.head {
+        return pack_cell_sub_blocks(charts, align, pool_edge)
+            .into_iter()
+            .map(|sub| {
+                let n = sub.members.len();
+                SpikeSubBlock {
+                    sub,
+                    rotated: vec![false; n],
+                    mask_extent: (0, 0),
+                }
+            })
+            .collect();
+    }
+    let owned_units: Vec<bool> = (0..charts.len())
+        .map(|i| cfg.owned_first && owned.get(i).copied().unwrap_or(false))
+        .collect();
+    let k = cfg.chart_align;
+    assert!(align.is_multiple_of(k) && pool_edge.is_multiple_of(k));
+    let units: Vec<(u32, u32)> = charts
+        .iter()
+        .map(|&(w, h)| (w.div_ceil(k), h.div_ceil(k)))
+        .collect();
+    let (align_u, pool_u) = (align / k, pool_edge / k);
+    let area_of = |&(w, h): &(u32, u32)| u64::from(w) * u64::from(h);
+    let pool_area = u64::from(pool_u) * u64::from(pool_u);
+    let mut remaining: Vec<usize> = (0..charts.len()).collect();
+    let mut out = Vec::new();
+    while !remaining.is_empty() {
+        let area: u64 = remaining.iter().map(|&i| area_of(&units[i])).sum();
+        if area <= pool_area {
+            let sizes: Vec<(u32, u32)> = remaining.iter().map(|&i| units[i]).collect();
+            let own: Vec<bool> = remaining.iter().map(|&i| owned_units[i]).collect();
+            let found = if own.iter().any(|&o| o) && own.iter().any(|&o| !o) {
+                best_block_owned_first(&sizes, &own, align_u, pool_u, cfg)
+            } else {
+                best_block(&sizes, align_u, pool_u, cfg)
+            };
+            if let Some((block, rotated)) = found
+                && block.fits(pool_u)
+            {
+                out.push(scale(
+                    CellSubBlock {
+                        members: remaining,
+                        block,
+                    },
+                    rotated,
+                    k,
+                ));
+                break;
+            }
+        }
+        let (filled, rotated, rest) =
+            fill_block(&units, &owned_units, &remaining, align_u, pool_u, cfg);
+        out.push(scale(filled, rotated, k));
+        remaining = rest;
+    }
+    out
+}
+
+fn scale(mut sub: CellSubBlock, rotated: Vec<bool>, k: u32) -> SpikeSubBlock {
+    let mask_extent = (0, 0);
+    sub.block.width *= k;
+    sub.block.height *= k;
+    for p in &mut sub.block.placements {
+        p.0 *= k;
+        p.1 *= k;
+    }
+    SpikeSubBlock {
+        sub,
+        rotated,
+        mask_extent,
+    }
+}
+
+fn order_by(sizes: &[(u32, u32)], indices: &[usize], key: SortKey) -> Vec<usize> {
+    order_by_owned(sizes, indices, key, &[])
+}
+
+/// [`order_by`], owned charts (`owned[i]`) ahead of the rest.
+fn order_by_owned(
+    sizes: &[(u32, u32)],
+    indices: &[usize],
+    key: SortKey,
+    owned: &[bool],
+) -> Vec<usize> {
+    let first = |i: usize| !owned.get(i).copied().unwrap_or(false);
+    let k = |i: usize| -> (u64, u64) {
+        let (w, h) = sizes[i];
+        let (w, h) = (u64::from(w), u64::from(h));
+        match key {
+            SortKey::Area => (w * h, 0),
+            SortKey::MaxSide => (w.max(h), w.min(h)),
+            SortKey::Height => (h, w),
+            SortKey::Width => (w, h),
+            SortKey::Perimeter => (w + h, w * h),
+        }
+    };
+    let mut order = indices.to_vec();
+    order.sort_by(|&a, &b| {
+        first(a)
+            .cmp(&first(b))
+            .then(k(b).cmp(&k(a)))
+            .then(a.cmp(&b))
+    });
+    order
+}
+
+/// HEAD's fill of one `pool²` block, under each heuristic and sort; the
+/// candidate placing the most chart area wins, ties to the first.
+fn fill_block(
+    units: &[(u32, u32)],
+    owned: &[bool],
+    remaining: &[usize],
+    align: u32,
+    pool: u32,
+    cfg: &PackConfig,
+) -> (CellSubBlock, Vec<bool>, Vec<usize>) {
+    let align_up = |v: u32| v.div_ceil(align) * align;
+    let area_of = |i: usize| u64::from(units[i].0) * u64::from(units[i].1);
+    let mut best: Option<(u64, Vec<(usize, (u32, u32, bool))>, Vec<usize>)> = None;
+    for &sort in &cfg.sorts {
+        let order = order_by_owned(units, remaining, sort, owned);
+        for &heuristic in &cfg.heuristics {
+            let mut bin = Bin::new(pool, pool);
+            let mut placed = Vec::new();
+            let mut rest = Vec::new();
+            for &index in &order {
+                let (w, h) = units[index];
+                match bin.insert(w, h, heuristic, cfg.rotate) {
+                    Some(p) => placed.push((index, p)),
+                    None => rest.push(index),
+                }
+            }
+            let area: u64 = placed.iter().map(|&(i, _)| area_of(i)).sum();
+            if best.as_ref().is_none_or(|b| area > b.0) {
+                best = Some((area, placed, rest));
+            }
+        }
+    }
+    let (_, mut placed, mut rest) = best.expect("at least one candidate");
+    assert!(!placed.is_empty(), "the largest chart fits an empty block");
+    placed.sort_unstable_by_key(|&(index, _)| index);
+    rest.sort_unstable();
+    let dims = |i: usize, rot: bool| {
+        if rot {
+            (units[i].1, units[i].0)
+        } else {
+            units[i]
+        }
+    };
+    let width = align_up(
+        placed
+            .iter()
+            .map(|&(i, (x, _, r))| x + dims(i, r).0)
+            .max()
+            .unwrap(),
+    );
+    let height = align_up(
+        placed
+            .iter()
+            .map(|&(i, (_, y, r))| y + dims(i, r).1)
+            .max()
+            .unwrap(),
+    );
+    (
+        CellSubBlock {
+            members: placed.iter().map(|&(i, _)| i).collect(),
+            block: PackedBlock {
+                width,
+                height,
+                placements: placed.iter().map(|&(_, (x, y, _))| (x, y)).collect(),
+            },
+        },
+        placed.iter().map(|&(_, (_, _, r))| r).collect(),
+        rest,
+    )
+}
+
+/// Smallest-area block over every (sort, heuristic, width) candidate; ties
+/// keep the first (squarer shape breaks equal areas, as in HEAD).
+fn best_block(
+    sizes: &[(u32, u32)],
+    align: u32,
+    pool: u32,
+    cfg: &PackConfig,
+) -> Option<(PackedBlock, Vec<bool>)> {
+    if sizes.is_empty() {
+        return None;
+    }
+    let align_up = |v: u32| v.div_ceil(align) * align;
+    let area: u64 = sizes
+        .iter()
+        .map(|&(w, h)| u64::from(w) * u64::from(h))
+        .sum();
+    // With rotation a chart's narrow side may lie along the width.
+    let max_width = sizes
+        .iter()
+        .map(|&(w, h)| if cfg.rotate { w.min(h) } else { w })
+        .max()
+        .unwrap_or(0);
+    let max_height = sizes
+        .iter()
+        .map(|&(w, h)| if cfg.rotate { w.min(h) } else { h })
+        .max()
+        .unwrap_or(0);
+    let widths = candidate_widths(area, max_width, align, pool, cfg);
+    let indices: Vec<usize> = (0..sizes.len()).collect();
+    let key = |b: &PackedBlock| (!b.fits(pool), b.area(), b.width.max(b.height));
+    let mut best: Option<(PackedBlock, Vec<bool>)> = None;
+    for &sort in &cfg.sorts {
+        let order = order_by(sizes, &indices, sort);
+        for &heuristic in &cfg.heuristics {
+            for &width in &widths {
+                let floor = align_up(max_height.max(area.div_ceil(u64::from(width)) as u32));
+                let candidate = shortest(
+                    sizes, &order, width, floor, align, heuristic, cfg.rotate, None,
+                );
+                if best.as_ref().is_none_or(|b| key(&candidate.0) < key(&b.0)) {
+                    best = Some(candidate);
+                }
+            }
+        }
+    }
+    best
+}
+
+fn candidate_widths(
+    area: u64,
+    max_width: u32,
+    align: u32,
+    pool: u32,
+    cfg: &PackConfig,
+) -> Vec<u32> {
+    let align_up = |v: u32| v.div_ceil(align) * align;
+    let side = (area as f64).sqrt();
+    const FACTORS: [f64; 8] = [0.5, 0.7, 0.85, 1.0, 1.15, 1.3, 1.6, 2.0];
+    let mut widths: Vec<u32> = FACTORS
+        .iter()
+        .map(|&f| align_up(((side * f).ceil() as u32).max(max_width)))
+        .collect();
+    widths.push(align_up(max_width));
+    if align_up(max_width) <= pool {
+        widths.push(pool);
+    }
+    if cfg.dense_widths > 0 {
+        let lo = align_up(max_width);
+        let hi = align_up(((side * 2.0).ceil() as u32).max(lo)).min(pool.max(lo));
+        let n = cfg.dense_widths;
+        for i in 0..=n {
+            let w = lo + ((u64::from(hi - lo) * u64::from(i)) / u64::from(n)) as u32;
+            widths.push(align_up(w));
+        }
+    }
+    widths.sort_unstable();
+    widths.dedup();
+    widths
+}
+
+/// Owned charts packed alone into the smallest top-left block, then the rest
+/// around that reserved rect; the smallest whole block wins.
+fn best_block_owned_first(
+    sizes: &[(u32, u32)],
+    owned: &[bool],
+    align: u32,
+    pool: u32,
+    cfg: &PackConfig,
+) -> Option<(PackedBlock, Vec<bool>)> {
+    let align_up = |v: u32| v.div_ceil(align) * align;
+    let own_idx: Vec<usize> = (0..sizes.len()).filter(|&i| owned[i]).collect();
+    let rest_idx: Vec<usize> = (0..sizes.len()).filter(|&i| !owned[i]).collect();
+    let own_sizes: Vec<(u32, u32)> = own_idx.iter().map(|&i| sizes[i]).collect();
+    let (own_block, own_rot) = best_block(&own_sizes, align, pool, cfg)?;
+    let reserved = (own_block.width, own_block.height);
+    let area: u64 = sizes
+        .iter()
+        .map(|&(w, h)| u64::from(w) * u64::from(h))
+        .sum::<u64>()
+        + own_block.area()
+        - own_sizes
+            .iter()
+            .map(|&(w, h)| u64::from(w) * u64::from(h))
+            .sum::<u64>();
+    let max_width = rest_idx
+        .iter()
+        .map(|&i| {
+            if cfg.rotate {
+                sizes[i].0.min(sizes[i].1)
+            } else {
+                sizes[i].0
+            }
+        })
+        .max()
+        .unwrap_or(0)
+        .max(reserved.0);
+    let max_height = rest_idx
+        .iter()
+        .map(|&i| {
+            if cfg.rotate {
+                sizes[i].0.min(sizes[i].1)
+            } else {
+                sizes[i].1
+            }
+        })
+        .max()
+        .unwrap_or(0)
+        .max(reserved.1);
+    let widths = candidate_widths(area, max_width, align, pool, cfg);
+    let key = |b: &PackedBlock| (!b.fits(pool), b.area(), b.width.max(b.height));
+    let mut best: Option<(PackedBlock, Vec<bool>)> = None;
+    for &sort in &cfg.sorts {
+        let order = order_by(sizes, &rest_idx, sort);
+        for &heuristic in &cfg.heuristics {
+            for &width in &widths {
+                let floor = align_up(max_height.max(area.div_ceil(u64::from(width)) as u32));
+                let (mut block, mut rot) = shortest(
+                    sizes,
+                    &order,
+                    width,
+                    floor,
+                    align,
+                    heuristic,
+                    cfg.rotate,
+                    Some(reserved),
+                );
+                for (k, &i) in own_idx.iter().enumerate() {
+                    block.placements[i] = own_block.placements[k];
+                    rot[i] = own_rot[k];
+                }
+                block.width = block.width.max(reserved.0);
+                block.height = block.height.max(reserved.1);
+                if best.as_ref().is_none_or(|b| key(&block) < key(&b.0)) {
+                    best = Some((block, rot));
+                }
+            }
+        }
+    }
+    best
+}
+
+fn shortest(
+    sizes: &[(u32, u32)],
+    order: &[usize],
+    width: u32,
+    floor: u32,
+    align: u32,
+    heuristic: Heuristic,
+    rotate: bool,
+    reserved: Option<(u32, u32)>,
+) -> (PackedBlock, Vec<bool>) {
+    let align_up = |v: u32| v.div_ceil(align) * align;
+    let mut fail = None;
+    let mut height = floor;
+    let mut placed = loop {
+        match try_pack(sizes, order, width, height, heuristic, rotate, reserved) {
+            Some(p) => break p,
+            None => {
+                fail = Some(height);
+                height = align_up(height + (height / 8).max(align));
+            }
+        }
+    };
+    if let Some(mut low) = fail {
+        while height - low > align {
+            let mid = align_up(low + (height - low) / 2);
+            match try_pack(sizes, order, width, mid, heuristic, rotate, reserved) {
+                Some(p) => {
+                    height = mid;
+                    placed = p;
+                }
+                None => low = mid,
+            }
+        }
+    }
+    // Trim: a heuristic need not fill the full width.
+    let dims = |i: usize, r: bool| {
+        if r {
+            (sizes[i].1, sizes[i].0)
+        } else {
+            sizes[i]
+        }
+    };
+    let used_w = align_up(
+        order
+            .iter()
+            .map(|&i| placed[i].0 + dims(i, placed[i].2).0)
+            .max()
+            .unwrap_or(0),
+    );
+    let used_h = align_up(
+        order
+            .iter()
+            .map(|&i| placed[i].1 + dims(i, placed[i].2).1)
+            .max()
+            .unwrap_or(0),
+    );
+    (
+        PackedBlock {
+            width: used_w.min(width),
+            height: used_h.min(height),
+            placements: placed.iter().map(|&(x, y, _)| (x, y)).collect(),
+        },
+        placed.iter().map(|&(_, _, r)| r).collect(),
+    )
+}
+
+fn try_pack(
+    sizes: &[(u32, u32)],
+    order: &[usize],
+    width: u32,
+    height: u32,
+    heuristic: Heuristic,
+    rotate: bool,
+    reserved: Option<(u32, u32)>,
+) -> Option<Vec<(u32, u32, bool)>> {
+    let mut bin = Bin::new(width, height);
+    if let Some((rw, rh)) = reserved {
+        if rw > width || rh > height {
+            return None;
+        }
+        bin.insert(rw, rh, Heuristic::BottomLeft, false)?;
+    }
+    let mut placements = vec![(0, 0, false); sizes.len()];
+    for &index in order {
+        placements[index] = bin.insert(sizes[index].0, sizes[index].1, heuristic, rotate)?;
+    }
+    Some(placements)
+}
+
+#[derive(Clone, Copy)]
+struct Rect {
+    x: u32,
+    y: u32,
+    w: u32,
+    h: u32,
+}
+
+/// MaxRects (Jylänki 2010) with a selectable heuristic and optional rotation.
+/// With `Heuristic::Bssf` and no rotation it places exactly as HEAD's
+/// [`super::MaxRects`].
+pub(crate) struct Bin {
+    width: u32,
+    height: u32,
+    free: Vec<Rect>,
+    used: Vec<Rect>,
+}
+
+impl Bin {
+    pub(crate) fn new(width: u32, height: u32) -> Self {
+        Self {
+            width,
+            height,
+            free: vec![Rect {
+                x: 0,
+                y: 0,
+                w: width,
+                h: height,
+            }],
+            used: Vec::new(),
+        }
+    }
+
+    fn contact(&self, x: u32, y: u32, w: u32, h: u32) -> u64 {
+        let overlap = |a0: u32, a1: u32, b0: u32, b1: u32| -> u64 {
+            if a1 <= b0 || b1 <= a0 {
+                0
+            } else {
+                u64::from(a1.min(b1) - a0.max(b0))
+            }
+        };
+        let mut score = 0u64;
+        if x == 0 || x + w == self.width {
+            score += u64::from(h);
+        }
+        if y == 0 || y + h == self.height {
+            score += u64::from(w);
+        }
+        for u in &self.used {
+            if u.x == x + w || u.x + u.w == x {
+                score += overlap(u.y, u.y + u.h, y, y + h);
+            }
+            if u.y == y + h || u.y + u.h == y {
+                score += overlap(u.x, u.x + u.w, x, x + w);
+            }
+        }
+        score
+    }
+
+    fn score(&self, r: &Rect, w: u32, h: u32, heuristic: Heuristic) -> (i64, i64) {
+        let lx = i64::from(r.w - w);
+        let ly = i64::from(r.h - h);
+        match heuristic {
+            Heuristic::Bssf => (lx.min(ly), lx.max(ly)),
+            Heuristic::Blsf => (lx.max(ly), lx.min(ly)),
+            Heuristic::Baf => (
+                i64::from(r.w) * i64::from(r.h) - i64::from(w) * i64::from(h),
+                lx.min(ly),
+            ),
+            Heuristic::BottomLeft => (i64::from(r.y + h), i64::from(r.x)),
+            Heuristic::ContactPoint => (-(self.contact(r.x, r.y, w, h) as i64), i64::from(r.y)),
+        }
+    }
+
+    pub(crate) fn insert(
+        &mut self,
+        w: u32,
+        h: u32,
+        heuristic: Heuristic,
+        rotate: bool,
+    ) -> Option<(u32, u32, bool)> {
+        let mut best: Option<(usize, (i64, i64), bool)> = None;
+        for (idx, r) in self.free.iter().enumerate() {
+            for rot in [false, true] {
+                if rot && (!rotate || w == h) {
+                    continue;
+                }
+                let (cw, ch) = if rot { (h, w) } else { (w, h) };
+                if r.w >= cw && r.h >= ch {
+                    let s = self.score(r, cw, ch, heuristic);
+                    if best.is_none_or(|(_, b, _)| s < b) {
+                        best = Some((idx, s, rot));
+                    }
+                }
+            }
+        }
+        let (idx, _, rot) = best?;
+        let (cw, ch) = if rot { (h, w) } else { (w, h) };
+        let placed = Rect {
+            x: self.free[idx].x,
+            y: self.free[idx].y,
+            w: cw,
+            h: ch,
+        };
+        let mut i = 0;
+        while i < self.free.len() {
+            if let Some(splits) = split_free(&self.free[i], &placed) {
+                self.free.swap_remove(i);
+                self.free.extend(splits);
+            } else {
+                i += 1;
+            }
+        }
+        self.prune();
+        if heuristic == Heuristic::ContactPoint {
+            self.used.push(placed);
+        }
+        Some((placed.x, placed.y, rot))
+    }
+
+    fn prune(&mut self) {
+        let mut i = 0;
+        while i < self.free.len() {
+            let mut removed = false;
+            let mut j = 0;
+            while j < self.free.len() {
+                if i != j && contains(&self.free[j], &self.free[i]) {
+                    self.free.swap_remove(i);
+                    removed = true;
+                    break;
+                }
+                j += 1;
+            }
+            if !removed {
+                i += 1;
+            }
+        }
+    }
+}
+
+fn contains(outer: &Rect, inner: &Rect) -> bool {
+    inner.x >= outer.x
+        && inner.y >= outer.y
+        && inner.x + inner.w <= outer.x + outer.w
+        && inner.y + inner.h <= outer.y + outer.h
+}
+
+fn split_free(free: &Rect, placed: &Rect) -> Option<Vec<Rect>> {
+    let no_overlap = placed.x >= free.x + free.w
+        || placed.x + placed.w <= free.x
+        || placed.y >= free.y + free.h
+        || placed.y + placed.h <= free.y;
+    if no_overlap {
+        return None;
+    }
+    let mut out = Vec::with_capacity(4);
+    if placed.x > free.x {
+        out.push(Rect {
+            x: free.x,
+            y: free.y,
+            w: placed.x - free.x,
+            h: free.h,
+        });
+    }
+    if placed.x + placed.w < free.x + free.w {
+        out.push(Rect {
+            x: placed.x + placed.w,
+            y: free.y,
+            w: (free.x + free.w) - (placed.x + placed.w),
+            h: free.h,
+        });
+    }
+    if placed.y > free.y {
+        out.push(Rect {
+            x: free.x,
+            y: free.y,
+            w: free.w,
+            h: placed.y - free.y,
+        });
+    }
+    if placed.y + placed.h < free.y + free.h {
+        out.push(Rect {
+            x: free.x,
+            y: placed.y + placed.h,
+            w: free.w,
+            h: (free.y + free.h) - (placed.y + placed.h),
+        });
+    }
+    Some(out)
+}
+
+/// MaxRects placement of `sizes`, tallest first, first fit over every open
+/// `edge²` layer: an alternative pool placement for the bound (measurement
+/// only; the runtime shelf allocator is HEAD's).
+pub(crate) fn maxrects_layers(sizes: &[(u32, u32)], edge: u32, heuristic: Heuristic) -> u32 {
+    let mut order: Vec<usize> = (0..sizes.len()).collect();
+    order.sort_by(|&a, &b| {
+        (sizes[b].1, sizes[b].0)
+            .cmp(&(sizes[a].1, sizes[a].0))
+            .then(a.cmp(&b))
+    });
+    let mut layers: Vec<Bin> = Vec::new();
+    for i in order {
+        let (w, h) = sizes[i];
+        let mut placed = false;
+        for bin in layers.iter_mut() {
+            if bin.insert(w, h, heuristic, false).is_some() {
+                placed = true;
+                break;
+            }
+        }
+        if !placed {
+            let mut bin = Bin::new(edge, edge);
+            bin.insert(w, h, heuristic, false)
+                .expect("a block fits an empty layer");
+            layers.push(bin);
+        }
+    }
+    layers.len() as u32
+}

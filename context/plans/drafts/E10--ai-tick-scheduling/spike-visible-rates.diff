+/// SPIKE: steering schedule for one tick. `stride_of(slot)` gives each agent's
+/// stride; an agent steers when `(slot + tick) % stride == 0`, with dt scaled.
+fn spike_steer_schedule(ids: &[(EntityId, usize)], tick: usize) {
+    let all_one = ids.iter().all(|&(_, stride)| stride <= 1);
+    agent_steering::SPIKE_STEER_SCHED.with(|cell| {
+        *cell.borrow_mut() = if all_one {
+            None
+        } else {
+            Some(
+                ids.iter()
+                    .enumerate()
+                    .filter(|&(slot, &(_, stride))| (slot + tick) % stride.max(1) == 0)
+                    .map(|(_, &(id, stride))| (id, stride.max(1) as f32))
+                    .collect(),
+            )
+        };
+    });
+}
+
+fn spike_clear_schedules() {
+    agent_steering::SPIKE_STEER_SCHED.with(|cell| *cell.borrow_mut() = None);
+    crate::SPIKE_AI_ONLY.with(|cell| *cell.borrow_mut() = None);
+}

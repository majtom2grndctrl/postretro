+// SPIKE: coded id-22 v4 and id-42 SMZ1 sections round-trip and reject lies by name.
+
+use crate::block_codec::{BlockCodec, PairCoding, encode_plane};
+use crate::lightmap::{
+    CodedLightmapBlock, IRRADIANCE_FORMAT_BC6H, LightmapBlock, LightmapBlockIndex, LightmapMode,
+    LightmapSection, coded_lightmap_section_bytes,
+};
+use crate::shadowmask_atlas::{
+    NO_FACE_OWNERS, ShadowmaskAtlasSection, ShadowmaskOwnerBounds, coded_shadowmask_section_bytes,
+    group_plane_len,
+};
+
+fn raw_section() -> LightmapSection {
+    let extents = [(16u16, 8u16), (8, 8), (32, 16)];
+    LightmapSection {
+        direction_texel_scale: 2,
+        irradiance_format: IRRADIANCE_FORMAT_BC6H,
+        mode: LightmapMode::Shadowed,
+        blocks: extents
+            .iter()
+            .enumerate()
+            .map(|(i, &(w, h))| {
+                let (w32, h32) = (u32::from(w), u32::from(h));
+                LightmapBlock {
+                    cell_id: i as u32,
+                    width: w,
+                    height: h,
+                    irradiance: (0..w32 / 4 * h32 / 4 * 16)
+                        .map(|t| ((t / 5 + i as u32) % 7) as u8)
+                        .collect(),
+                    direction: (0..w32 / 2 * h32 / 2 * 2).map(|t| (t % 3) as u8).collect(),
+                }
+            })
+            .collect(),
+    }
+}
+
+fn coded_blocks(raw: &LightmapSection, codec: BlockCodec) -> Vec<CodedLightmapBlock> {
+    raw.blocks
+        .iter()
+        .map(|b| CodedLightmapBlock {
+            cell_id: b.cell_id,
+            width: b.width,
+            height: b.height,
+            coding: PairCoding {
+                codec,
+                raw_lens: [b.irradiance.len() as u32, b.direction.len() as u32],
+            },
+            irradiance: encode_plane(codec, 3, &b.irradiance),
+            direction: encode_plane(codec, 3, &b.direction),
+        })
+        .collect()
+}
+
+fn err(result: crate::Result<impl std::fmt::Debug>) -> String {
+    format!("{}", result.expect_err("expected a rejection"))
+}
+
+#[test]
+fn coded_lightmap_sections_decode_to_the_raw_blocks() {
+    let raw = raw_section();
+    for codec in [BlockCodec::None, BlockCodec::Lz4, BlockCodec::Zstd] {
+        let bytes = coded_lightmap_section_bytes(raw.header(), &coded_blocks(&raw, codec));
+        let back = LightmapSection::from_bytes(&bytes).unwrap();
+        assert_eq!(back, raw, "{codec:?}");
+    }
+}
+
+#[test]
+fn a_lying_uncompressed_length_fails_the_index_by_name() {
+    let raw = raw_section();
+    let mut blocks = coded_blocks(&raw, BlockCodec::Zstd);
+    blocks[1].coding.raw_lens[0] += 16;
+    let bytes = coded_lightmap_section_bytes(raw.header(), &blocks);
+    let message = err(LightmapBlockIndex::from_prefix(&bytes, bytes.len() as u64));
+    assert!(
+        message.contains("lightmap block 1 irradiance declares"),
+        "{message}"
+    );
+}
+
+#[test]
+fn an_uncoded_block_whose_stored_length_lies_fails_by_name() {
+    let raw = raw_section();
+    let mut blocks = coded_blocks(&raw, BlockCodec::None);
+    blocks[2].direction.pop();
+    let bytes = coded_lightmap_section_bytes(raw.header(), &blocks);
+    let message = err(LightmapBlockIndex::from_prefix(&bytes, bytes.len() as u64));
+    assert!(
+        message.contains("lightmap block 2 direction stores"),
+        "{message}"
+    );
+}
+
+#[test]
+fn a_corrupt_frame_fails_the_whole_load_by_name() {
+    let raw = raw_section();
+    let mut blocks = coded_blocks(&raw, BlockCodec::Zstd);
+    let middle = blocks[2].irradiance.len() / 2;
+    blocks[2].irradiance[middle] ^= 0xA5;
+    let bytes = coded_lightmap_section_bytes(raw.header(), &blocks);
+    let message = err(LightmapSection::from_bytes(&bytes));
+    assert!(
+        message.contains("lightmap block 2 irradiance: zstd frame rejected"),
+        "{message}"
+    );
+}
+
+#[test]
+fn coded_shadowmask_sections_decode_and_reject_lies_by_name() {
+    let raw = raw_section();
+    let index = raw.index();
+    let owners = vec![NO_FACE_OWNERS; 2];
+    let bounds = ShadowmaskOwnerBounds {
+        face_count: 2,
+        static_spec_light_count: 4,
+    };
+    let planes: Vec<[Vec<u8>; 2]> = raw
+        .blocks
+        .iter()
+        .enumerate()
+        .map(|(i, b)| {
+            let len = group_plane_len(u32::from(b.width), u32::from(b.height)).unwrap() as usize;
+            let a: Vec<u8> = (0..len).map(|t| ((t / 9) % 5) as u8).collect();
+            // Block 1 stores no group B plane.
+            let b = if i == 1 {
+                Vec::new()
+            } else {
+                a.iter().map(|v| v ^ 1).collect()
+            };
+            [a, b]
+        })
+        .collect();
+    let encode = |codec, planes: &[[Vec<u8>; 2]]| -> Vec<(PairCoding, [Vec<u8>; 2])> {
+        planes
+            .iter()
+            .map(|[a, b]| {
+                let stored = |p: &Vec<u8>| {
+                    if p.is_empty() {
+                        Vec::new()
+                    } else {
+                        encode_plane(codec, 3, p)
+                    }
+                };
+                (
+                    PairCoding {
+                        codec,
+                        raw_lens: [a.len() as u32, b.len() as u32],
+                    },
+                    [stored(a), stored(b)],
+                )
+            })
+            .collect()
+    };
+    for codec in [BlockCodec::None, BlockCodec::Lz4, BlockCodec::Zstd] {
+        let bytes = coded_shadowmask_section_bytes(&owners, &encode(codec, &planes));
+        let back = ShadowmaskAtlasSection::from_bytes(&bytes, &index, bounds).unwrap();
+        assert_eq!(back.blocks, planes, "{codec:?}");
+    }
+    let mut lying = encode(BlockCodec::Zstd, &planes);
+    lying[0].0.raw_lens[1] -= 16;
+    let bytes = coded_shadowmask_section_bytes(&owners, &lying);
+    let message = err(ShadowmaskAtlasSection::from_bytes(&bytes, &index, bounds));
+    assert!(
+        message.contains("shadowmask block 0 group B declares"),
+        "{message}"
+    );
+    let mut corrupt = encode(BlockCodec::Zstd, &planes);
+    let middle = corrupt[2].1[0].len() / 2;
+    corrupt[2].1[0][middle] ^= 0x3C;
+    let bytes = coded_shadowmask_section_bytes(&owners, &corrupt);
+    let message = err(ShadowmaskAtlasSection::from_bytes(&bytes, &index, bounds));
+    assert!(
+        message.contains("shadowmask block 2 group A: zstd frame rejected"),
+        "{message}"
+    );
+}

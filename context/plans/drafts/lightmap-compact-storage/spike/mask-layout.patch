+impl CellBlocks {
+    pub(super) fn new_from_index(
+        index: &LightmapBlockIndex,
+        cell_count: usize,
+    ) -> anyhow::Result<Self> {
+        let mut runs = vec![0..0; cell_count];
+        for (block, record) in index.records.iter().enumerate() {
+            let block = block as u32;
+            let run = &mut runs[record.cell_id as usize];
+            if run.start == run.end {
+                *run = block..block + 1;
+            } else {
+                run.end += 1;
+            }
+        }
+        Ok(Self(runs))
+    }
+}

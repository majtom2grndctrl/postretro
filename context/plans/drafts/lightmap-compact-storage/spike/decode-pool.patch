+/// SPIKE: decode `count` blocks in block order, on
+/// `POSTRETRO_SPIKE_DECODE_THREADS` scoped threads (default 1), each taking a
+/// contiguous run of blocks. The first error in block order wins.
+fn decode_blocks<T: Send>(
+    count: usize,
+    decode: impl Fn(usize) -> Result<T, PrlLoadError> + Sync,
+) -> Result<Vec<T>, PrlLoadError> {
+    let threads = std::env::var("POSTRETRO_SPIKE_DECODE_THREADS")
+        .ok()
+        .and_then(|v| v.parse::<usize>().ok())
+        .unwrap_or(1)
+        .clamp(1, 64);
+    if threads == 1 || count < 2 {
+        return (0..count).map(&decode).collect();
+    }
+    let chunk = count.div_ceil(threads);
+    let decode = &decode;
+    let parts: Vec<Result<Vec<T>, PrlLoadError>> = std::thread::scope(|scope| {
+        let handles: Vec<_> = (0..count)
+            .step_by(chunk)
+            .map(|start| {
+                scope.spawn(move || (start..(start + chunk).min(count)).map(decode).collect())
+            })
+            .collect();
+        handles
+            .into_iter()
+            .map(|handle| handle.join().expect("decode thread"))
+            .collect()
+    });
+    let mut out = Vec::with_capacity(count);
+    for part in parts {
+        out.extend(part?);
+    }
+    Ok(out)
 }
 

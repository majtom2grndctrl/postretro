+#[test]
+fn spike_lying_lengths_are_rejected_by_name() {
+    let (coded, payload, chunk, directory, base, sources) = coded_fixture();
+    // An index stored length that a zstd frame cannot have (not smaller than
+    // the layout-derived chunk) fails at load.
+    let lying = with_stored(&coded, &chunk);
+    let err = lying
+        .validate_against(inputs(&directory, base, &sources))
+        .unwrap_err()
+        .to_string();
+    assert!(
+        err.contains("cluster 0 stored length") && err.contains("zstd codec"),
+        "{err}"
+    );
+    // An index decoded length that disagrees with the layout fails at load.
+    let mut lying = coded.clone();
+    lying.index[0].decoded_bytes += 16;
+    let err = lying
+        .validate_against(inputs(&directory, base, &sources))
+        .unwrap_err()
+        .to_string();
+    assert!(err.contains("cluster 0 index counts disagree"), "{err}");
+    // A frame whose content is longer or shorter than the layout says fails
+    // at decode, even with a matching stored hash.
+    for content in [
+        [chunk.clone(), vec![0; 16]].concat(),
+        chunk[..chunk.len() - 16].to_vec(),
+    ] {
+        let frame =
+            crate::block_codec::encode_plane(crate::block_codec::BlockCodec::Zstd, 3, &content);
+        let validated = with_stored(&coded, &frame)
+            .into_validated(inputs(&directory, base, &sources))
+            .unwrap();
+        let err = validated.decode_chunk(0, frame).unwrap_err().to_string();
+        assert!(err.contains("cluster 0 chunk"), "{err}");
+    }
+    let _ = payload;
+}

+// --- Group 5 (EXPERIMENT): scene depth, sampled under a read-only attachment ---
+@group(5) @binding(0) var scene_depth: texture_depth_2d;
+
+// EXPERIMENT: murky depth fog under the surface, seen from outside the volume.
+// Extinction is per meter of view ray below the surface: 3/m leaves ~5% of the
+// scene visible through 1 m of water. The albedo is linear, lit like the face.
+const FLUID_FOG_EXTINCTION: f32 = 3.0;
+const FLUID_FOG_ALBEDO: vec3<f32> = vec3<f32>(0.04, 0.055, 0.048);
+
+// Distance the view ray travels past the surface fragment to the opaque scene.
+// The ray cam + s * (frag - cam) is linear in clip space, so solving its NDC
+// depth for the scene depth gives s with no inverse matrix; s = 1 is the face.
+fn fluid_underwater_path(frag: vec3<f32>, depth: f32) -> f32 {
+    let c0 = uniforms.view_proj * vec4<f32>(uniforms.camera_position, 1.0);
+    let c1 = uniforms.view_proj * vec4<f32>(frag, 1.0);
+    let denom = (c1.z - c0.z) - depth * (c1.w - c0.w);
+    let s = select(1.0e4, (depth * c0.w - c0.z) / denom, abs(denom) > 1.0e-8);
+    return clamp(s - 1.0, 0.0, 1.0e4) * length(frag - uniforms.camera_position);
+}

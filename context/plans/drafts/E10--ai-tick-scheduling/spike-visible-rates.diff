+impl SpikeCellIndex {
+    fn build(dim_x: u32, dim_z: u32, regions: &[NavRegionRecord]) -> Self {
+        let mut x0 = 0i64;
+        let mut z0 = 0i64;
+        let mut x1 = dim_x as i64;
+        let mut z1 = dim_z as i64;
+        for r in regions {
+            x0 = x0.min(r.cell.x0 as i64);
+            z0 = z0.min(r.cell.z0 as i64);
+            x1 = x1.max(r.cell.x1 as i64);
+            z1 = z1.max(r.cell.z1 as i64);
+        }
+        let (w, h) = ((x1 - x0).max(1), (z1 - z0).max(1));
+        let cells = (w * h) as usize;
+        let mut counts = vec![0u32; cells + 1];
+        for r in regions {
+            for z in r.cell.z0 as i64..r.cell.z1 as i64 {
+                for x in r.cell.x0 as i64..r.cell.x1 as i64 {
+                    counts[((z - z0) * w + (x - x0)) as usize] += 1;
+                }
+            }
+        }
+        let mut starts = vec![0u32; cells + 1];
+        for c in 0..cells {
+            starts[c + 1] = starts[c] + counts[c];
+        }
+        let mut fill = starts.clone();
+        let mut items = vec![0u32; starts[cells] as usize];
+        for (i, r) in regions.iter().enumerate() {
+            for z in r.cell.z0 as i64..r.cell.z1 as i64 {
+                for x in r.cell.x0 as i64..r.cell.x1 as i64 {
+                    let c = ((z - z0) * w + (x - x0)) as usize;
+                    items[fill[c] as usize] = i as u32;
+                    fill[c] += 1;
+                }
+            }
+        }
+        Self { x0, z0, w, h, starts, items }
+    }

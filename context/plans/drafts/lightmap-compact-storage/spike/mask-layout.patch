+/// SPIKE (rotation): with `POSTRETRO_SPIKE_WEIGHTS_OUT=<path>`, one line per
+/// stored weight-map entry, keyed by its canonical chart texel read back
+/// through the stored rect: `face tx ty light weight_bits dir_u dir_v`.
+static SPIKE_WEIGHTS_OUT: std::sync::Mutex<Option<std::io::BufWriter<std::fs::File>>> =
+    std::sync::Mutex::new(None);
+
+fn spike_dump_weights(
+    face: usize,
+    placement: crate::chart_raster::ChartPlacement,
+    results: &[ChunkBakeResult],
+) {
+    use std::io::Write;
+    let Some(path) = std::env::var_os("POSTRETRO_SPIKE_WEIGHTS_OUT") else {
+        return;
+    };
+    let mut lines = String::new();
+    for result in results {
+        let rect = &result.rect;
+        for ry in 0..rect.height {
+            for rx in 0..rect.width {
+                let entry = &result.offset_counts[(ry * rect.width + rx) as usize];
+                let (tx, ty) = placement.chart_texel(rect.compact_x + rx, rect.compact_y + ry);
+                for light in &result.texel_lights
+                    [entry.offset as usize..(entry.offset + entry.count) as usize]
+                {
+                    lines += &format!(
+                        "{face} {tx} {ty} {} {} {} {}\n",
+                        light.light_index,
+                        light.weight.to_bits(),
+                        light.direction_oct[0],
+                        light.direction_oct[1]
+                    );
+                }
+            }
+        }
     }
+    let mut out = SPIKE_WEIGHTS_OUT.lock().unwrap();
+    let out = out.get_or_insert_with(|| {
+        std::io::BufWriter::new(std::fs::File::create(path).expect("spike weights dump"))
+    });
+    out.write_all(lines.as_bytes()).unwrap();
+    out.flush().unwrap();
 }

+            );
+            // Edge open-fraction histogram.
+            let mut hist = [0usize; 6];
+            for p in &prisms_all {
+                for &f in &p.edge_open {
+                    let b = if f == 0.0 {
+                        0
+                    } else if f < 0.34 {
+                        1
+                    } else if f <= 0.5 {
+                        2
+                    } else if f < 0.67 {
+                        3
+                    } else if f < 1.0 {
+                        4
+                    } else {
+                        5
+                    };
+                    hist[b] += 1;
+                }
+            }
+            println!(
+                "  edge open fraction: 0 {} | (0,1/3) {} | [1/3,1/2] {} | (1/2,2/3) {} | [2/3,1) {} | 1 {}",
+                hist[0], hist[1], hist[2], hist[3], hist[4], hist[5]
+            );
+
+            // Overlapping prism pairs.
+            let mut overlap_pairs = 0;
+            let mut overlap_per: Vec<usize> = vec![0; prisms_all.len()];
+            for i in 0..prisms_all.len() {
+                for j in i + 1..prisms_all.len() {
+                    let (amin, amax) = prisms_all[i].scratch_bounds();
+                    let (bmin, bmax) = prisms_all[j].scratch_bounds();
+                    if (0..3).any(|a| amax[a] <= bmin[a] || bmax[a] <= amin[a]) {
+                        continue;
+                    }
+                    if prisms_all[i].scratch_overlaps_prism(&prisms_all[j]) {
+                        overlap_pairs += 1;
+                        overlap_per[i] += 1;
+                        overlap_per[j] += 1;
+                    }
+                }
+            }
+            let mut sorted = overlap_per.clone();
+            sorted.sort_unstable();
+            println!(
+                "  overlapping prism pairs {overlap_pairs}; overlaps per prism p50 {} max {}",
+                sorted.get(sorted.len() / 2).copied().unwrap_or(0),
+                sorted.last().copied().unwrap_or(0)
+            );
+
+            // Splits per prism (credited to every prism offering the plane).
+            let mut per_prism: HashMap<usize, (usize, u8)> = HashMap::new();
+            for (ids, bits) in &splits {
+                let unique: HashSet<usize> = ids.iter().copied().collect();
+                for id in unique {
+                    let e = per_prism.entry(id).or_default();
+                    e.0 += 1;
+                    e.1 |= bits;
+                }
+            }
+            let mut ranked: Vec<(usize, usize)> =
+                per_prism.iter().map(|(&id, &(n, _))| (id, n)).collect();
+            ranked.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
+            // Splits by source kind (brush/section), shared credit.
+            let mut src_splits = (0, 0, 0);
+            for (ids, _) in &splits {
+                let b = ids.iter().any(|&id| prisms_all[id].source.starts_with("brush"));
+                let s = ids.iter().any(|&id| prisms_all[id].source.starts_with("section"));
+                match (b, s) {
+                    (true, false) => src_splits.0 += 1,
+                    (false, true) => src_splits.1 += 1,
+                    _ => src_splits.2 += 1,
+                }
+            }
+            println!(
+                "  splits by source: brush-only {} section-only {} both/none {}",
+                src_splits.0, src_splits.1, src_splits.2
+            );
+            println!("  top prisms by splits:");
+            for &(id, n) in ranked.iter().take(10) {
+                let p = &prisms_all[id];
+                let (normal, dist) = p.scratch_face();
+                let (bmin, bmax) = p.scratch_bounds();
+                println!(
+                    "    #{id} {} splits {n}: face n {:.2?} d {:.2}, depth {:.2}{}, bounds {:.1?}..{:.1?}, edges open {:.2?}, kinds [{}], overlaps {}",
+                    p.source,
+                    normal,
+                    dist,
+                    p.depth,
+                    if p.truncated { " (truncated)" } else { "" },
+                    bmin,
+                    bmax,
+                    p.edge_open,
+                    p.kinds.iter().map(|&k| kind_name(k)).collect::<Vec<_>>().join(","),
+                    overlap_per[id],
+                );
+            }
+
+            // Cross-check: runtime portals lying on a prism plane, by kind,
+            // and whether a brush plane lies there too.
+            let mut prism_planes: HashMap<(i64, i64, i64, i64), u8> = HashMap::new();
+            for p in &prisms_all {
+                for (&(n, d), &k) in p.splitters.iter().zip(&p.kinds) {
+                    *prism_planes.entry(plane_key(n, d)).or_default() |= k;
+                }
+            }
+            let brush_planes: HashSet<(i64, i64, i64, i64)> = map_data
+                .brush_volumes
+                .iter()
+                .flat_map(|b| b.planes.iter().map(|pl| plane_key(pl.normal, pl.distance)))
+                .collect();
+            let mut on: BTreeMap<String, usize> = BTreeMap::new();
+            for portal in &runtime.portals {
+                let (n, d) = polygon_plane(&portal.polygon);
+                let key = plane_key(n, d);
+                let label = match prism_planes.get(&key) {
+                    None => "not on a prism plane".to_string(),
+                    Some(&bits) => format!(
+                        "{}{}",
+                        kind_name(bits),
+                        if brush_planes.contains(&key) {
+                            " (also a brush plane)"
+                        } else {
+                            ""
+                        }
+                    ),
+                };
+                *on.entry(label).or_default() += 1;
+            }
+            println!("  portals by plane: {on:?}");
+        }
+    }
+    reset();
+}

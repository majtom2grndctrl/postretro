diff --git a/crates/level-loader/examples/sh_chunk_bench.rs b/crates/level-loader/examples/sh_chunk_bench.rs
new file mode 100644
index 0000000..9adc6a6
--- /dev/null
+++ b/crates/level-loader/examples/sh_chunk_bench.rs
@@ -0,0 +1,198 @@
+// SPIKE: id-50 chunk decode cost through the production decode-pool entry
+// point (`ShStreamManifest::decode_encoded_cluster`, which runs
+// `ValidatedClusterShPayloadsSection::decode_chunk`).
+// See: context/lib/rendering_pipeline.md §4 (Cluster SH residency)
+//
+//   cargo run -p postretro-level-loader --release --example sh_chunk_bench -- \
+//     <reference.prl> [other.prl ...]
+//
+// The first PRL is the reference (epoch 3, every chunk stored). Every other
+// PRL must decode every chunk to the reference's bytes. Per PRL: best-of-3
+// single-thread totals and per-chunk p50/p95/max of the whole decode_chunk,
+// and of its parts measured alone (blake3 over the stored bytes, zstd), the
+// layout check being the rest; then a 2-thread pass (the decode pool's size
+// on 4 cores) and the corrupt-frame and short-read rejections.
+
+use std::fs::File;
+use std::os::unix::fs::FileExt;
+use std::time::Instant;
+
+use postretro_level_format::block_codec::{BlockCodec, decode_plane};
+use postretro_level_loader::{PrlLoadError, ShStreamingMode, load_prl_with_sh_streaming};
+
+const PASSES: usize = 3;
+const MIB: f64 = 1024.0 * 1024.0;
+
+fn read(file: &File, offset: u64, len: u64) -> Result<Vec<u8>, PrlLoadError> {
+    let mut out = vec![0; len as usize];
+    file.read_exact_at(&mut out, offset).unwrap();
+    Ok(out)
+}
+
+fn stats(mut v: Vec<f64>) -> String {
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let p = |q: f64| v[((v.len() as f64 - 1.0) * q).round() as usize] * 1e3;
+    format!(
+        "{:.3} / {:.3} / {:.3}",
+        p(0.5),
+        p(0.95),
+        v.last().unwrap() * 1e3
+    )
+}
+
+fn main() {
+    let paths: Vec<String> = std::env::args().skip(1).collect();
+    let mut reference: Option<Vec<blake3::Hash>> = None;
+    for path in &paths {
+        let started = Instant::now();
+        let world = load_prl_with_sh_streaming(path, ShStreamingMode::Async).expect("load PRL");
+        let load_s = started.elapsed().as_secs_f64();
+        let manifest = world.sh_stream_manifest().expect("streamed SH").clone();
+        let count = manifest.cluster_count();
+        let index = &manifest.payloads().index;
+        let encoded: Vec<Vec<u8>> = (0..count)
+            .map(|cluster| manifest.read_encoded_cluster_with(cluster, read).unwrap())
+            .collect();
+        let live: Vec<u32> = (0..count)
+            .filter(|&c| !encoded[c as usize].is_empty())
+            .collect();
+        let stored: u64 = encoded.iter().map(|c| c.len() as u64).sum();
+        let coded = live
+            .iter()
+            .filter(|&&c| index[c as usize].codec == BlockCodec::Zstd)
+            .count();
+
+        // Pass 0: identity against the reference.
+        let mut decoded_len = vec![0u32; count as usize];
+        let mut hashes = Vec::with_capacity(count as usize);
+        for cluster in 0..count {
+            let chunk = manifest
+                .decode_encoded_cluster(cluster, encoded[cluster as usize].clone())
+                .expect("decode");
+            decoded_len[cluster as usize] = chunk.bytes.len() as u32;
+            hashes.push(blake3::hash(&chunk.bytes));
+        }
+        let decoded: u64 = decoded_len.iter().map(|&l| u64::from(l)).sum();
+        let identical = match &reference {
+            None => {
+                reference = Some(hashes);
+                "reference".to_string()
+            }
+            Some(reference) => {
+                let same = reference
+                    .iter()
+                    .zip(&hashes)
+                    .filter(|(a, b)| a == b)
+                    .count();
+                assert_eq!(
+                    same, count as usize,
+                    "{path}: decoded chunks differ from the reference"
+                );
+                format!("{same}/{count} chunks byte-identical to reference")
+            }
+        };
+
+        // Whole decode_chunk, single thread.
+        let mut per_chunk = vec![f64::MAX; live.len()];
+        let mut totals = Vec::new();
+        for _ in 0..PASSES {
+            let mut total = 0.0;
+            for (i, &cluster) in live.iter().enumerate() {
+                let bytes = encoded[cluster as usize].clone();
+                let t = Instant::now();
+                let chunk = manifest.decode_encoded_cluster(cluster, bytes).unwrap();
+                let e = t.elapsed().as_secs_f64();
+                std::hint::black_box(&chunk);
+                drop(chunk);
+                per_chunk[i] = per_chunk[i].min(e);
+                total += e;
+            }
+            totals.push(total);
+        }
+        // Its parts alone.
+        let mut hash_chunk = vec![f64::MAX; live.len()];
+        let mut zstd_chunk = vec![f64::MAX; live.len()];
+        for _ in 0..PASSES {
+            for (i, &cluster) in live.iter().enumerate() {
+                let bytes = &encoded[cluster as usize];
+                let t = Instant::now();
+                std::hint::black_box(blake3::hash(bytes));
+                hash_chunk[i] = hash_chunk[i].min(t.elapsed().as_secs_f64());
+                let codec = index[cluster as usize].codec;
+                if codec == BlockCodec::Zstd {
+                    let t = Instant::now();
+                    let out = decode_plane(codec, bytes, decoded_len[cluster as usize], &"chunk")
+                        .unwrap();
+                    zstd_chunk[i] = zstd_chunk[i].min(t.elapsed().as_secs_f64());
+                    std::hint::black_box(out);
+                } else {
+                    zstd_chunk[i] = 0.0;
+                }
+            }
+        }
+        let best = totals.iter().cloned().fold(f64::MAX, f64::min);
+        let hash_s: f64 = hash_chunk.iter().sum();
+        let zstd_s: f64 = zstd_chunk.iter().sum();
+        let sum_best: f64 = per_chunk.iter().sum();
+
+        // Two decode threads, as the pool runs on 4 cores.
+        let started = Instant::now();
+        std::thread::scope(|scope| {
+            for t in 0..2 {
+                let manifest = &manifest;
+                let encoded = &encoded;
+                let live = &live;
+                scope.spawn(move || {
+                    for &cluster in live.iter().skip(t).step_by(2) {
+                        let chunk = manifest
+                            .decode_encoded_cluster(cluster, encoded[cluster as usize].clone())
+                            .unwrap();
+                        std::hint::black_box(chunk);
+                    }
+                });
+            }
+        });
+        let two = started.elapsed().as_secs_f64();
+
+        // Rejections through the manifest.
+        let largest = *live
+            .iter()
+            .max_by_key(|&&c| encoded[c as usize].len())
+            .unwrap();
+        let mut corrupt = encoded[largest as usize].clone();
+        let middle = corrupt.len() / 2;
+        corrupt[middle] ^= 0x5A;
+        let corrupt_err = manifest
+            .decode_encoded_cluster(largest, corrupt)
+            .unwrap_err();
+        let mut short = encoded[largest as usize].clone();
+        short.pop();
+        let short_err = manifest.decode_encoded_cluster(largest, short).unwrap_err();
+
+        println!("== {path}");
+        println!(
+            "load {load_s:.2} s; {count} clusters, {} non-empty, {coded} zstd; stored {:.1} MiB -> decoded {:.1} MiB ({:.1}%); {identical}",
+            live.len(),
+            stored as f64 / MIB,
+            decoded as f64 / MIB,
+            100.0 * stored as f64 / decoded as f64
+        );
+        println!(
+            "decode_chunk 1T: best pass {best:.3} s ({:.2} GiB/s decoded); per chunk ms p50/p95/max {}",
+            decoded as f64 / best / 1024.0 / MIB,
+            stats(per_chunk.clone())
+        );
+        println!(
+            "  parts (sum of per-chunk bests {sum_best:.3} s): blake3(stored) {hash_s:.3} s [{}], zstd {zstd_s:.3} s [{}], layout+rest {:.3} s",
+            stats(hash_chunk.clone()),
+            stats(zstd_chunk.clone()),
+            sum_best - hash_s - zstd_s
+        );
+        println!(
+            "decode_chunk 2T wall {two:.3} s ({:.2} GiB/s)",
+            decoded as f64 / two / 1024.0 / MIB
+        );
+        println!("corrupt largest chunk {largest}: {corrupt_err}");
+        println!("short read chunk {largest}: {short_err}");
+    }
+}

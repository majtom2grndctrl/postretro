+// SPIKE (throwaway): multi-arena map. Four 64x64 m arenas in a row along +X,
+// joined by 40 m corridors 4 m wide, low (0.8 m) walls so bodies collide but
+// sight passes over them. Nav regions are 2x2 m tiles (~4.2k regions, close to
+// env-volumes' 4,326).
+
+use super::*;
+
+const ARENA: f32 = 64.0;
+const GAP: f32 = 40.0;
+const ARENAS: usize = 4;
+const TILE: u32 = 2;
+const WALL_H: f32 = 0.8;
+
+fn arena_x0(i: usize) -> f32 {
+    i as f32 * (ARENA + GAP)
+}
+
+struct ArenaMap {
+    nav: NavMeshSection,
+    world: CollisionWorld,
+}
+
+fn build_arena_map() -> ArenaMap {
+    let total_x = (ARENAS as f32 * ARENA + (ARENAS - 1) as f32 * GAP) as u32;
+    let total_z = ARENA as u32;
+    let (tx_n, tz_n) = (total_x / TILE, total_z / TILE);
+    let walkable = |tx: u32, tz: u32| -> bool {
+        let (x, z) = ((tx * TILE) as f32, (tz * TILE) as f32);
+        for i in 0..ARENAS {
+            let x0 = arena_x0(i);
+            if x >= x0 && x < x0 + ARENA {
+                return true;
+            }
+            if i + 1 < ARENAS
+                && x >= x0 + ARENA
+                && x < x0 + ARENA + GAP
+                && (30.0..34.0).contains(&z)
+            {
+                return true;
+            }
+        }
+        false
+    };
+    let mut index = vec![u32::MAX; (tx_n * tz_n) as usize];
+    let mut regions = Vec::new();
+    for tz in 0..tz_n {
+        for tx in 0..tx_n {
+            if walkable(tx, tz) {
+                index[(tz * tx_n + tx) as usize] = regions.len() as u32;
+                regions.push(NavRegion {
+                    x0: tx * TILE,
+                    z0: tz * TILE,
+                    x1: (tx + 1) * TILE,
+                    z1: (tz + 1) * TILE,
+                    floor_y_min: 0.0,
+                    floor_y_max: 0.25,
+                });
+            }
+        }
+    }
+    let mut portals = Vec::new();
+    for tz in 0..tz_n {
+        for tx in 0..tx_n {
+            let a = index[(tz * tx_n + tx) as usize];
+            if a == u32::MAX {
+                continue;
+            }
+            if tx + 1 < tx_n {
+                let b = index[(tz * tx_n + tx + 1) as usize];
+                if b != u32::MAX {
+                    let x = ((tx + 1) * TILE) as f32;
+                    portals.push(NavPortal {
+                        region_a: a,
+                        region_b: b,
+                        left: [x, 0.0, ((tz + 1) * TILE) as f32],
+                        right: [x, 0.0, (tz * TILE) as f32],
+                    });
+                }
+            }
+            if tz + 1 < tz_n {
+                let b = index[((tz + 1) * tx_n + tx) as usize];
+                if b != u32::MAX {
+                    let z = ((tz + 1) * TILE) as f32;
+                    portals.push(NavPortal {
+                        region_a: a,
+                        region_b: b,
+                        left: [(tx * TILE) as f32, 0.0, z],
+                        right: [((tx + 1) * TILE) as f32, 0.0, z],
+                    });
+                }
+            }
+        }
+    }
+    portals.sort_by_key(|p| (p.region_a, p.region_b));
+    let nav = NavMeshSection {
+        version: NAVMESH_VERSION,
+        origin: [0.0, 0.0, 0.0],
+        cell_size: 1.0,
+        dim_x: total_x,
+        dim_z: total_z,
+        agent_radius: 0.35,
+        agent_height: 1.8,
+        step_height: 0.4,
+        max_slope_deg: 45.0,
+        regions,
+        portals,
+        gates: Vec::new(),
+        links: Vec::new(),
+    };
+
+    // Collision: one floor quad plus low wall quads.
+    let mut points = vec![
+        Vec3::new(-1.0, 0.0, -1.0),
+        Vec3::new(total_x as f32 + 1.0, 0.0, -1.0),
+        Vec3::new(total_x as f32 + 1.0, 0.0, total_z as f32 + 1.0),
+        Vec3::new(-1.0, 0.0, total_z as f32 + 1.0),
+    ];
+    let mut tris: Vec<[u32; 3]> = vec![[0, 1, 2], [0, 2, 3]];
+    let mut wall = |ax: f32, az: f32, bx: f32, bz: f32| {
+        let base = points.len() as u32;
+        points.push(Vec3::new(ax, 0.0, az));
+        points.push(Vec3::new(bx, 0.0, bz));
+        points.push(Vec3::new(bx, WALL_H, bz));
+        points.push(Vec3::new(ax, WALL_H, az));
+        tris.push([base, base + 1, base + 2]);
+        tris.push([base, base + 2, base + 3]);
+    };
+    for i in 0..ARENAS {
+        let x0 = arena_x0(i);
+        let x1 = x0 + ARENA;
+        wall(x0, 0.0, x1, 0.0);
+        wall(x0, ARENA, x1, ARENA);
+        if i == 0 {
+            wall(x0, 0.0, x0, ARENA);
+        } else {
+            wall(x0, 0.0, x0, 30.0);
+            wall(x0, 34.0, x0, ARENA);
+        }
+        if i + 1 == ARENAS {
+            wall(x1, 0.0, x1, ARENA);
+        } else {
+            wall(x1, 0.0, x1, 30.0);
+            wall(x1, 34.0, x1, ARENA);
+            wall(x1, 30.0, x1 + GAP, 30.0);
+            wall(x1, 34.0, x1 + GAP, 34.0);
+        }
+    }
+    let world = CollisionWorld::from_triangles_for_test(points, tris);
+    ArenaMap { nav, world }
+}
+
+/// Deterministic LCG in [0, 1).
+struct Lcg(u64);
+impl Lcg {
+    fn next(&mut self) -> f32 {
+        self.0 = self
+            .0
+            .wrapping_mul(6364136223846793005)
+            .wrapping_add(1442695040888963407);
+        ((self.0 >> 40) as f32) / ((1u64 << 24) as f32)
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum Role {
+    Wave,
+    Idle,
+    Patrol,
+    Far,
+}
+
+const ROLES: [Role; 4] = [Role::Wave, Role::Idle, Role::Patrol, Role::Far];
+
+/// Rates under test: (AI stride, steering stride) per role.
+fn role_strides(role: Role, mode: &str) -> (usize, usize) {
+    match (mode, role) {
+        ("today", _) => (1, 1),
+        // Rival: dormant tier (whole tick at 2 Hz) for targetless off-arena;
+        // everyone with a target acts at 60 Hz.
+        ("rival", Role::Idle | Role::Patrol) => (30, 30),
+        ("rival", _) => (1, 1),
+        // Brief: dormant as rival, plus engaged steering at 15 Hz / 30 Hz.
+        ("brief15", Role::Idle | Role::Patrol) => (30, 30),
+        ("brief15", _) => (1, 4),
+        ("brief30", Role::Idle | Role::Patrol) => (30, 30),
+        ("brief30", _) => (1, 2),
+        _ => panic!("unknown RS_MODE {mode}"),
+    }
+}
+
+type Sched = (EntityId, Role, usize, usize, usize);
+
+fn run_arena(wave_size: usize, off_total: usize, mode: &str, split: bool, ticks: usize) {
+    let warm_ticks = env_usize("RS_WARM", 60);
+    let map = build_arena_map();
+    let world = map.world;
+    let nav = NavGraph::from_section(&map.nav);
+    // Equality spot check of the throwaway index on random points.
+    let mut rng = Lcg(0x5eed);
+    let mut mismatches = 0;
+    for _ in 0..20_000 {
+        let p = Vec3::new(
+            rng.next() * 400.0 - 12.0,
+            rng.next() * 2.0 - 0.5,
+            rng.next() * 80.0 - 8.0,
+        );
+        if nav.region_at_linear(p) != nav.region_at_indexed(p) {
+            mismatches += 1;
+        }
+        let (a, b) = nav.spike_resolve_pair(p);
+        if a != b {
+            mismatches += 1;
+        }
+    }
+
+    let factions = crossfire_factions();
+    let faction_sentiment = RefCell::new(FactionSentimentState::default());
+    let mut reg = EntityRegistry::new();
+    let mut runtime = AiRuntime::new();
+    let y = chaser_rest_y();
+    let center = Vec3::new(32.0, y, 32.0);
+    let player = spawn_player(&mut reg, center);
+
+    let engaged = engaged_graph(
+        "engage",
+        vec![("engage", activity("walk", MotionVerb::ChaseTarget, None))],
+    );
+    let idle_graph = test_graph_with(18.0, 18.0);
+    let mut patrol_graph = test_graph_with(18.0, 18.0);
+    patrol_graph.patrol = Some(PatrolDescriptor {
+        points: vec![[0.0, 0.0], [10.0, 0.0], [10.0, 10.0], [0.0, 10.0]],
+        mode: PatrolMode::Loop,
+    });
+    patrol_graph.envelope.activities.insert(
+        TEST_IDLE_STATE.to_string(),
+        authored_state("locomotion", MotionVerb::Patrol, None),
+    );
+
+    let mut rng = Lcg(42);
+    let mut members: Vec<(EntityId, Role)> = Vec::new();
+    // Wave: spread over arena 0 on a jittered grid, avoiding the player.
+    let side = (wave_size as f32).sqrt().ceil().max(1.0) as usize;
+    let step = 56.0 / side as f32;
+    for k in 0..wave_size {
+        let (gx, gz) = (k % side, k / side);
+        let mut p = Vec3::new(
+            4.0 + (gx as f32 + 0.2 + 0.6 * rng.next()) * step,
+            y,
+            4.0 + (gz as f32 + 0.2 + 0.6 * rng.next()) * step,
+        );
+        if distance_xz(p, center) < 6.0 {
+            p.x += 8.0;
+        }
+        members.push((spawn_engaged(&mut reg, p, &engaged, "engage"), Role::Wave));
+    }
+    // Off-arena: arenas 1..3. Half idle, a quarter patrolling, a quarter far
+    // targeted (placed in arenas 2 and 3, >100 m from the player).
+    let n_far = off_total / 4;
+    let n_patrol = off_total / 4;
+    let n_idle = off_total - n_far - n_patrol;
+    let place = |rng: &mut Lcg, arena_lo: usize| -> Vec3 {
+        let arena = arena_lo + (rng.next() * (ARENAS - arena_lo) as f32) as usize;
+        let arena = arena.min(ARENAS - 1);
+        Vec3::new(
+            arena_x0(arena) + 3.0 + rng.next() * 46.0,
+            y,
+            3.0 + rng.next() * 46.0,
+        )
+    };
+    for _ in 0..n_idle {
+        let p = place(&mut rng, 1);
+        let id = spawn_enemy(
+            &mut reg,
+            p,
+            brain_with(idle_graph.clone(), TEST_IDLE_STATE),
+            50.0,
+        );
+        members.push((id, Role::Idle));
+    }
+    for _ in 0..n_patrol {
+        let p = place(&mut rng, 1);
+        let id = spawn_enemy(
+            &mut reg,
+            p,
+            brain_with(patrol_graph.clone(), TEST_IDLE_STATE),
+            50.0,
+        );
+        members.push((id, Role::Patrol));
+    }
+    for _ in 0..n_far {
+        let p = place(&mut rng, 2);
+        members.push((spawn_engaged(&mut reg, p, &engaged, "engage"), Role::Far));
+    }
+
+    // Per-role slot (phase) and strides.
+    let mut role_slot = [0usize; 4];
+    let sched: Vec<Sched> = members
+        .iter()
+        .map(|&(id, role)| {
+            let r = ROLES.iter().position(|x| *x == role).unwrap();
+            let slot = role_slot[r];
+            role_slot[r] += 1;
+            let (ai, steer) = role_strides(role, mode);
+            (id, role, slot, ai, steer)
+        })
+        .collect();
+
+    let early_end = warm_ticks + ticks / 5;
+    let late_start = warm_ticks + ticks - ticks / 5;
+    let mut ai_t: Vec<Duration> = Vec::new();
+    let mut st_t: Vec<Duration> = Vec::new();
+    let mut ai_early = Vec::new();
+    let mut st_early = Vec::new();
+    let mut ai_late = Vec::new();
+    let mut st_late = Vec::new();
+    let mut role_ai = [Duration::ZERO; 4];
+    let mut role_st = [Duration::ZERO; 4];
+    let mut sampled = 0usize;
+    let mut replans = 0u64;
+
+    let ai_call = |reg: &mut EntityRegistry,
+                   runtime: &mut AiRuntime,
+                   only: Option<HashSet<EntityId>>,
+                   dt: f32| {
+        crate::SPIKE_AI_ONLY.with(|c| *c.borrow_mut() = only);
+        run_ai_tick_with_navigation_and_impact(
+            reg,
+            runtime,
+            dt,
+            AiTickInputs {
+                nav_graph: Some(&nav),
+                mover_nav: crate::nav::MoverNav::none(),
+                collision_world: Some(&world),
+                descriptors: &[],
+                descriptor_generation: 0,
+                factions: &factions,
+                faction_sentiment: &faction_sentiment,
+                clips: None,
+            },
+            |_| {},
+        );
+        crate::SPIKE_AI_ONLY.with(|c| *c.borrow_mut() = None);
+    };
+
+    for tick in 0..warm_ticks + ticks {
+        let t = tick as f32 * STEER_DT;
+        let angle = t / PLAYER_ORBIT_PERIOD_S * std::f32::consts::TAU;
+        move_player_to(
+            &mut reg,
+            player,
+            center.x + angle.sin() * PLAYER_ORBIT_RADIUS,
+            center.z + angle.cos() * PLAYER_ORBIT_RADIUS,
+        );
+        let mut ai_elapsed = Duration::ZERO;
+        let mut st_elapsed = Duration::ZERO;
+        if split {
+            // Per-role calls, each role on its own schedule.
+            for (r, role) in ROLES.iter().enumerate() {
+                let (ai_stride, steer_stride) = role_strides(*role, mode);
+                let due = |stride: usize| -> HashSet<EntityId> {
+                    sched
+                        .iter()
+                        .filter(|e| e.1 == *role && (e.2 + tick) % stride == 0)
+                        .map(|e| e.0)
+                        .collect()
+                };
+                let only = due(ai_stride);
+                let start = Instant::now();
+                ai_call(&mut reg, &mut runtime, Some(only), STEER_DT * ai_stride as f32);
+                let a = start.elapsed();
+                let steer_map: std::collections::HashMap<EntityId, f32> = due(steer_stride)
+                    .into_iter()
+                    .map(|id| (id, steer_stride as f32))
+                    .collect();

+/// SPIKE: one chunk's stored form at `level`: a zstd frame when it is smaller
+/// than the chunk, else the chunk as is. An empty chunk stays empty.
+pub fn encode_stored_chunk(raw: &[u8], level: i32) -> (crate::block_codec::BlockCodec, Vec<u8>) {
+    use crate::block_codec::{BlockCodec, encode_plane};
+    if raw.is_empty() {
+        return (BlockCodec::None, Vec::new());
+    }
+    let coded = encode_plane(BlockCodec::Zstd, level, raw);
+    if coded.len() < raw.len() {
+        (BlockCodec::Zstd, coded)
+    } else {
+        (BlockCodec::None, raw.to_vec())
+    }
+}
+
+/// SPIKE: decode one hash-verified stored chunk to exactly `decoded_len`
+/// bytes. A stored chunk passes through without a copy.
+fn decode_stored_chunk(
+    cluster_id: u32,
+    codec: crate::block_codec::BlockCodec,
+    stored: Vec<u8>,
+    decoded_len: u64,
+) -> Result<Vec<u8>, ClusterShPayloadsError> {
+    use crate::block_codec::BlockCodec;
+    match codec {
+        BlockCodec::None => Ok(stored),
+        BlockCodec::Zstd => {
+            let decoded_len = u32::try_from(decoded_len)
+                .map_err(|_| ClusterShPayloadsError::SizeOverflow("decoded chunk length"))?;
+            crate::block_codec::decode_plane(
+                codec,
+                &stored,
+                decoded_len,
+                &format_args!("cluster {cluster_id} chunk"),
+            )
+            .map_err(|error| ClusterShPayloadsError::InvalidData(error.to_string()))
+        }
+        BlockCodec::Lz4 => invalid(format!("cluster {cluster_id} chunk codec lz4 is refused")),
+    }
+}

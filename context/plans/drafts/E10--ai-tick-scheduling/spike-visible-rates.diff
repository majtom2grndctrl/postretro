+            )
+        } else {
+            String::new()
+        };
+        eprintln!(
+            "[ARENA]   role {:?}: n {} targeted {} mean dist {:.1} m{split_part}",
+            role,
+            count[r],
+            targeted[r],
+            dist[r] / count[r].max(1) as f32,
+        );
+    }
+    eprintln!("[ARENA]   off-mesh or fallen at end: {off_mesh}");
+}

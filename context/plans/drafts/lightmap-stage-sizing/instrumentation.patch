+// ---- Experiment: exact chart-level coverage cull (`POSTRETRO_LM_CHART_CULL`).
+
+static CHART_CULL: LazyLock<bool> =
+    LazyLock::new(|| std::env::var_os("POSTRETRO_LM_CHART_CULL").is_some());
+static CULL_COUNTS: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+
+pub(crate) fn chart_cull_enabled() -> bool {
+    *CHART_CULL
+}
+
+/// Whether `light` may give any texel of `chart` a direct term, by tests that
+/// hold for every texel at once with margins far above `f32` rounding:
+/// the light behind the chart's plane, the chart outside a spot's outer cone,
+/// or the chart rectangle beyond `falloff_range`. `false` only when no texel
+/// is covered.
+pub(crate) fn chart_may_cover(light: &MapLight, chart: &Chart) -> bool {
+    let verdict = chart_cover_verdict(light, chart);
+    CULL_COUNTS[verdict].fetch_add(1, Relaxed);
+    if verdict != 0 {
+        let (w, h) = crate::chart_raster::chart_interior_dims(chart);
+        CULL_COUNTS[4].fetch_add((w * h) as u64, Relaxed);
+    }
+    verdict == 0
+}
+
+fn chart_cover_verdict(light: &MapLight, chart: &Chart) -> usize {
+    if chart.uv_extent[0] <= 0.0 || chart.uv_extent[1] <= 0.0 {
+        return 0;
+    }
+    let n = chart.normal;
+    match light.light_type {
+        LightType::Directional => {
+            let aim = Vec3::from(light.cone_direction.unwrap_or([0.0, -1.0, 0.0]));
+            let l = (-aim).normalize_or_zero();
+            // N·L is the same at every texel: exact.
+            if n.dot(l) <= 0.0 { 1 } else { 0 }
+        }
+        LightType::Point | LightType::Spot => {
+            let o = light.origin.as_vec3();
+            let (w, h) = crate::chart_raster::chart_interior_dims(chart);
+            let corners = [(0, 0), (w - 1, 0), (0, h - 1), (w - 1, h - 1)]
+                .map(|(tx, ty)| chart_texel_world_position(chart, tx, ty));
+            let centre = corners.iter().copied().sum::<Vec3>() * 0.25;
+            // Behind the plane, by a centimetre.
+            if n.dot(o - centre) < -0.01 {
+                return 1;
+            }
+            // Beyond reach of the texel-centre rectangle.
+            let lu = |p: Vec3| (p - corners[0]).dot(chart.u_axis);
+            let lv = |p: Vec3| (p - corners[0]).dot(chart.v_axis);
+            let (u0, u1) = corners.iter().fold((f32::INFINITY, f32::NEG_INFINITY), |(a, b), &p| {
+                (a.min(lu(p)), b.max(lu(p)))
+            });
+            let (v0, v1) = corners.iter().fold((f32::INFINITY, f32::NEG_INFINITY), |(a, b), &p| {
+                (a.min(lv(p)), b.max(lv(p)))
+            });
+            let ou = lu(o);
+            let ov = lv(o);
+            let du = (u0 - ou).max(ou - u1).max(0.0);
+            let dv = (v0 - ov).max(ov - v1).max(0.0);
+            let dn = n.dot(o - centre);
+            let nearest = (du * du + dv * dv + dn * dn).sqrt();
+            if nearest > light.falloff_range.max(1.0e-4) * 1.0001 + 0.01 {
+                return 2;
+            }
+            if matches!(light.light_type, LightType::Spot) {
+                let aim = Vec3::from(light.cone_direction.unwrap_or([0.0, -1.0, 0.0]))
+                    .normalize_or_zero();
+                let inner = light.cone_angle_inner.unwrap_or(0.0);
+                let outer = light.cone_angle_outer.unwrap_or(inner + 0.01);
+                let radius = corners
+                    .iter()
+                    .map(|&p| p.distance(centre))
+                    .fold(0.0f32, f32::max)
+                    + 0.01;
+                let to_c = centre - o;
+                let dist = to_c.length();
+                if dist > radius && outer < 3.0 {
+                    let alpha = (radius / dist).asin();
+                    let theta_c = aim.dot(to_c / dist).clamp(-1.0, 1.0).acos();
+                    if theta_c - alpha > outer + 1.0e-3 {
+                        return 3;
+                    }
+                }
+            }
+            0
+        }
+    }
+}
+
+pub(crate) fn chart_cull_report() {
+    if !chart_cull_enabled() {
+        return;
+    }
+    let c: Vec<u64> = CULL_COUNTS.iter().map(|a| a.load(Relaxed)).collect();
+    eprintln!(
+        "[lm-sizing] chart cull: kept {} behind {} range {} cone {} culled_texels {}",
+        c[0], c[1], c[2], c[3], c[4]
+    );
+}
+
+// ---- Experiment: tile shaft cull (`POSTRETRO_LM_SHAFT=<tile size>`).
+
+static SHAFT_TILE: LazyLock<Option<i32>> = LazyLock::new(|| {
+    std::env::var("POSTRETRO_LM_SHAFT").ok().and_then(|v| v.parse().ok()).filter(|&t| t > 0)
+});
+
+pub(crate) fn shaft_tile() -> Option<i32> {
+    *SHAFT_TILE
+}
+
+pub(crate) fn world_diag() -> f32 {
+    *WORLD_DIAG.get().unwrap_or(&20_000.0)
+}

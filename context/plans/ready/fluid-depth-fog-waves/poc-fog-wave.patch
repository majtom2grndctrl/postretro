@@ -271,13 +291,27 @@ fn fluid_drift_scroll(rate: vec2<f32>, time: f32) -> vec2<f32> {
 
 // The warped sample UV. Cells are floored from the UNWARPED texel UV, so
 // shimmer and rings stay on the fixed grid while the drift scrolls beneath.
+// EXPERIMENT: main's Quake turbulent warp (amplitude and frequency in tile
+// units) at 10% of its speed, evaluated once per texel cell and rounded to
+// whole texels, so cells shift as blocks and texel edges stay straight.
+const FLUID_WAVE_AMPLITUDE: f32 = 0.125;
+const FLUID_WAVE_FREQUENCY: f32 = 8.0;
+const FLUID_WAVE_SPEED: f32 = 0.1;
+
+fn fluid_wave_offset(cell: vec2<i32>, dims: vec2<f32>, time: f32) -> vec2<f32> {
+    let cell_uv = (vec2<f32>(cell) + vec2<f32>(0.5)) / dims;
+    let phase = cell_uv.yx * FLUID_WAVE_FREQUENCY + vec2<f32>(time * FLUID_WAVE_SPEED);
+    return round(FLUID_WAVE_AMPLITUDE * dims * sin(phase));
+}
+
 fn fluid_warp_uv(uv: vec2<f32>, drift_scroll: vec2<f32>, dims: vec2<f32>, time: f32,
                  texels_per_pixel: f32) -> vec2<f32> {
     let texel_uv = uv * dims;
     let cell = vec2<i32>(floor(texel_uv));
     let drift_texels = floor(drift_scroll * dims);
     let cell_texels = vec2<f32>(fluid_displayed_offset(cell, time, texels_per_pixel));
-    return (texel_uv + drift_texels + cell_texels) / dims;
+    let wave_texels = fluid_wave_offset(cell, dims, time);
+    return (texel_uv + drift_texels + cell_texels + wave_texels) / dims;
 }
 

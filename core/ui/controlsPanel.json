{
  "anchor": "center",
  "offset": [
    0.0,
    0.0
  ],
  "captureMode": "capture",
  "initialFocus": "ctl_back",
  "accessibleName": "Controls",
  "role": "group",
  "root": {
    "kind": "vstack",
    "gap": 12.0,
    "padding": 20.0,
    "align": "start",
    "fill": "panel.default",
    "focus": {
      "policy": "linear"
    },
    "children": [
      {
        "kind": "text",
        "content": "CONTROLS",
        "fontSize": 24,
        "color": "ok",
        "font": "mono"
      },
      {
        "kind": "grid",
        "id": "controlsRows",
        "gap": 8.0,
        "padding": 0.0,
        "align": "center",
        "cols": 1,
        "focus": {
          "policy": "spatial"
        },
        "scroll": {
          "maxHeight": 420.0
        },
        "children": []
      },
      {
        "kind": "text",
        "id": "controlsDisplacedNote",
        "content": "! A DEFAULT FOR THIS COMMAND IS TAKEN BY ONE OF YOUR BINDINGS",
        "fontSize": 14,
        "color": "ok",
        "font": "mono"
      },
      {
        "kind": "hstack",
        "gap": 12.0,
        "padding": 0.0,
        "align": "start",
        "children": [
          {
            "kind": "button",
            "id": "ctl_resetAll",
            "label": "RESET ALL",
            "onPress": "ui.controls.resetAll"
          },
          {
            "kind": "button",
            "id": "ctl_back",
            "label": "BACK",
            "onPress": "ui.closeDialog"
          }
        ]
      }
    ]
  }
}

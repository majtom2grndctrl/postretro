+        replans as f64 / sampled.max(1) as f64,
+    );
+    eprintln!(
+        "[ARENA]   all   ai p50 {:.3} p95 {:.3} mean {ai_mean:.3} max {ai_max:.3} | steer p50 {:.3} p95 {:.3} mean {st_mean:.3} max {st_max:.3} ms",
+        ms(&ai_t, 0.5),
+        ms(&ai_t, 0.95),
+        ms(&st_t, 0.5),
+        ms(&st_t, 0.95),
+    );
+    eprintln!(
+        "[ARENA]   early ai p50 {:.3} mean {:.3} steer p50 {:.3} mean {:.3} | late ai p50 {:.3} mean {:.3} steer p50 {:.3} mean {:.3} ms",
+        ms(&ai_early, 0.5),
+        mean_us(&ai_early) / 1e3,
+        ms(&st_early, 0.5),
+        mean_us(&st_early) / 1e3,
+        ms(&ai_late, 0.5),
+        mean_us(&ai_late) / 1e3,
+        ms(&st_late, 0.5),
+        mean_us(&st_late) / 1e3,
+    );

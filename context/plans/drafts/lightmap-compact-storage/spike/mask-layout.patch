+
+/// SPIKE (rotation): with `POSTRETRO_SPIKE_MASK_RAW_OUT=<path>`, every block's
+/// raw RGBA8 mask before BC5, as `u32 id, u32 width, u32 height` then the
+/// block-local texels.
+static SPIKE_MASK_OUT: std::sync::Mutex<Option<std::io::BufWriter<std::fs::File>>> =
+    std::sync::Mutex::new(None);
+
+fn spike_mask_dump_enabled() -> bool {
+    std::env::var_os("POSTRETRO_SPIKE_MASK_RAW_OUT").is_some()
+}
+
+fn spike_dump_mask_block(block_id: usize, width: u32, height: u32, raw: &[u8]) {
+    use std::io::Write;
+    let Some(path) = std::env::var_os("POSTRETRO_SPIKE_MASK_RAW_OUT") else {
+        return;
+    };
+    let mut out = SPIKE_MASK_OUT.lock().unwrap();
+    let out = out.get_or_insert_with(|| {
+        std::io::BufWriter::new(std::fs::File::create(path).expect("spike mask dump"))
+    });
+    out.write_all(&(block_id as u32).to_le_bytes()).unwrap();
+    out.write_all(&width.to_le_bytes()).unwrap();
+    out.write_all(&height.to_le_bytes()).unwrap();
+    out.write_all(raw).unwrap();
+    out.flush().unwrap();
+}

+#[test]
+fn spike_corrupt_frame_is_rejected_by_name() {
+    let (coded, payload, _, directory, base, sources) = coded_fixture();
+    let mut corrupt = payload.clone();
+    let middle = corrupt.len() / 2;
+    corrupt[middle] ^= 0x5A;
+    // Against the packed hash: the stored-byte hash rejects before decode.
+    let validated = coded
+        .clone()
+        .into_validated(inputs(&directory, base, &sources))
+        .unwrap();
+    assert_eq!(
+        validated.decode_chunk(0, corrupt.clone()),
+        Err(ClusterShPayloadsError::HashMismatch { cluster_id: 0 })
+    );
+    // Hashed as stored (corruption before the hash): the frame rejects it.
+    let validated = with_stored(&coded, &corrupt)
+        .into_validated(inputs(&directory, base, &sources))
+        .unwrap();
+    let err = validated.decode_chunk(0, corrupt).unwrap_err().to_string();
+    assert!(
+        err.contains("cluster 0 chunk: zstd frame rejected"),
+        "{err}"
+    );
+}
